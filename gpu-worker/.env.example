GPU_WORKER_API_URL=http://localhost:5000
GPU_WORKER_API_KEY=your-worker-api-key-here
GPU_WORKER_WORKER_ID=gpu-worker

GPU_WORKER_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
GPU_WORKER_R2_ACCESS_KEY=
GPU_WORKER_R2_SECRET_KEY=
GPU_WORKER_R2_BUCKET=smakosz-models

GPU_WORKER_DEVICE=auto
GPU_WORKER_HEALTH_PORT=8000

# Batch mode: process all jobs then shutdown (True) or continuous polling (False)
GPU_WORKER_BATCH_MODE=True
# Auto-shutdown: call safe-shutdown API after all jobs processed
GPU_WORKER_AUTO_SHUTDOWN=True
GPU_WORKER_SHUTDOWN_API_URL=http://100.102.102.102:5001
GPU_WORKER_SHUTDOWN_API_TOKEN=
# How many idle poll cycles before triggering shutdown
GPU_WORKER_IDLE_SHUTDOWN_CYCLES=3
