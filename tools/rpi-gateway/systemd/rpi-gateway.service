[Unit]
Description=RPi Wake-on-LAN Gateway
After=network-online.target

[Service]
Type=simple
User=rpi-gateway
Group=rpi-gateway
WorkingDirectory=/home/rpi-gateway
EnvironmentFile=/home/rpi-gateway/.env
ExecStart=/home/rpi-gateway/venv/bin/python /home/rpi-gateway/app.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
