[Unit]
Description=HomeLab REST API
After=network-online.target docker.service

[Service]
Type=simple
User=smakosz-homelab-api
Group=smakosz-homelab-api
WorkingDirectory=/home/smakosz-homelab-api
EnvironmentFile=/home/smakosz-homelab-api/.env
ExecStart=/home/smakosz-homelab-api/venv/bin/python /home/smakosz-homelab-api/app.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=false
PrivateTmp=false

[Install]
WantedBy=multi-user.target
