# Required
HOMELAB_API_TOKEN=your-secret-token-here

# Optional
HOMELAB_PORT=5001
HOMELAB_LOCKFILE=/tmp/shutdown.lock

# Shutdown blockers - comma-separated lists
# Docker: container names, checked via Docker API
HOMELAB_DOCKER_BLOCKERS=gpu-worker
# Processes: regex patterns for pgrep -f, checked on host
HOMELAB_PROCESS_BLOCKERS=

# GPU Worker - docker compose directory for fallback "up -d"
HOMELAB_GPU_WORKER_DIR=/home/smakosz-gpu-worker
