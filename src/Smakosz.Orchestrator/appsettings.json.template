{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=<DB_NAME>;Username=<DB_USER>;Password=<DB_PASSWORD>"
  },
  "Brevo": {
    "ApiKey": "<BREVO_API_KEY>",
    "SenderEmail": "noreply@smakosz.xyz",
    "SenderName": "Smakosz"
  },
  "R2": {
    "AccountId": "<CLOUDFLARE_ACCOUNT_ID>",
    "AccessKey": "<R2_ACCESS_KEY_ID>",
    "SecretKey": "<R2_SECRET_ACCESS_KEY>",
    "BucketName": "smakosz-photos",
    "PublicUrl": "<R2_PUBLIC_DOMAIN>"
  },
  "GpuWorker": {
    "Url": "http://<TAILSCALE_GPU_IP>:8000"
  },
  "RpiGateway": {
    "Url": "http://<TAILSCALE_RPI_IP>:5000",
    "ApiToken": "<RPI_GATEWAY_API_TOKEN>"
  },
  "WorkerAuth": {
    "ApiKey": "<WORKER_API_KEY>"
  },
  "NcfTraining": {
    "Enabled": false
  },
  "R2Models": {
    "AccountId": "<CLOUDFLARE_ACCOUNT_ID>",
    "AccessKey": "<R2_ACCESS_KEY_ID>",
    "SecretKey": "<R2_SECRET_ACCESS_KEY>",
    "BucketName": "smakosz-models"
  },
  "Vapid": {
    "PublicKey": "<VAPID_PUBLIC_KEY>",
    "PrivateKey": "<VAPID_PRIVATE_KEY>",
    "Subject": "mailto:push@smakosz.xyz"
  },
  "Onnx": {
    "ModelBasePath": "/models/ncf"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Information"
    }
  }
}
