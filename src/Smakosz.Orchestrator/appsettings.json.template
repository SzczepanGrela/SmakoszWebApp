{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=<DB_NAME>;Username=<DB_USER>;Password=<DB_PASSWORD>"
  },
  "Brevo": {
    "ApiKey": "<BREVO_API_KEY>",
    "SenderEmail": "<SENDER_EMAIL>",
    "SenderName": "<SENDER_NAME>"
  },
  "R2": {
    "AccountId": "<CLOUDFLARE_ACCOUNT_ID>",
    "AccessKey": "<R2_ACCESS_KEY_ID>",
    "SecretKey": "<R2_SECRET_ACCESS_KEY>",
    "BucketName": "<R2_BUCKET_NAME>",
    "PublicUrl": "<R2_PUBLIC_DOMAIN>"
  },
  "GpuWorker": {
    "Url": "http://<TAILSCALE_GPU_IP>:8000"
  },
  "RbpiGateway": {
    "Url": "http://<TAILSCALE_RBPI_IP>:5000",
    "ApiToken": "<RBPI_GATEWAY_API_TOKEN>"
  },
  "WorkerAuth": {
    "ApiKey": "<WORKER_API_KEY>"
  },
  "NcfTraining": {
    "Enabled": false
  },
  "Nodes": {
    "Api": {
      "NodeId": "vps-hetzner-prod",
      "Hostname": "hetznerVPS",
      "IpAddress": "<TAILSCALE_VPS_IP>"
    },
    "RbpiGateway": {
      "NodeId": "rbpi-gateway",
      "Hostname": "raspberry-pi",
      "IpAddress": "<TAILSCALE_RBPI_IP>"
    },
    "GpuWorker": {
      "NodeId": "gpu-homelab",
      "Hostname": "homelab",
      "IpAddress": "<TAILSCALE_GPU_IP>",
      "WolGatewayId": "rbpi-gateway"
    }
  },
  "R2Models": {
    "AccountId": "<CLOUDFLARE_ACCOUNT_ID>",
    "AccessKey": "<R2_ACCESS_KEY_ID>",
    "SecretKey": "<R2_SECRET_ACCESS_KEY>",
    "BucketName": "<R2_MODELS_BUCKET_NAME>"
  },
  "Vapid": {
    "PublicKey": "<VAPID_PUBLIC_KEY>",
    "PrivateKey": "<VAPID_PRIVATE_KEY>",
    "Subject": "mailto:<YOUR_EMAIL>"
  },
  "Onnx": {
    "ModelBasePath": "/models/ncf"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Information"
    }
  }
}
