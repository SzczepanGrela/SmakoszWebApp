<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Configuration" Version="10.0.*" />
    <PackageReference Include="Blazored.LocalStorage" Version="4.5.*" />
    <PackageReference Include="Blazor-ApexCharts" Version="3.*" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Smakosz.Client.Shared\Smakosz.Client.Shared.csproj" />
    <ProjectReference Include="..\Smakosz.Client.Ops\Smakosz.Client.Ops.csproj" />
  </ItemGroup>

  <ItemGroup>
    <BlazorWebAssemblyLazyLoad Include="Smakosz.Client.Ops.wasm" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <CssPartials Include="wwwroot/css/partials/_base.css" />
    <CssPartials Include="wwwroot/css/partials/_layout.css" />
    <CssPartials Include="wwwroot/css/partials/_pages.css" />
    <CssPartials Include="wwwroot/css/partials/_components.css" />
    <CssPartials Include="wwwroot/css/partials/_forms.css" />
    <CssPartials Include="wwwroot/css/partials/_admin.css" />
    <CssPartials Include="wwwroot/css/partials/_pwa.css" />
    <Watch Include="@(CssPartials)" />
  </ItemGroup>

  <Target Name="ConcatCss" BeforeTargets="BeforeBuild" Inputs="@(CssPartials)" Outputs="wwwroot/css/app.css">
    <ReadLinesFromFile File="%(CssPartials.Identity)">
      <Output TaskParameter="Lines" ItemName="AllCssLines" />
    </ReadLinesFromFile>

    <WriteLinesToFile File="wwwroot/css/app.css"
                      Lines="@(AllCssLines)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <Message Text="ConcatCss: regenerated wwwroot/css/app.css from $(MSBuildProjectName) partials" Importance="high" />
  </Target>

</Project>
