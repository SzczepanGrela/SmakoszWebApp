<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly"
            AdditionalAssemblies="new[] { typeof(Smakosz.Client.Ops._Imports).Assembly }">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <div class="container mt-5">
                            <div class="alert alert-danger">
                                <i class="fa-solid fa-lock me-2"></i>
                                Nie masz uprawnien do wyswietlenia tej strony.
                            </div>
                        </div>
                    }
                </NotAuthorized>
                <Authorizing>
                    <div class="d-flex justify-content-center align-items-center" style="min-height:50vh;">
                        <div class="spinner-border" style="color:var(--primary-color);" role="status">
                            <span class="visually-hidden">Autoryzacja...</span>
                        </div>
                    </div>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>404 - Nie znaleziono</PageTitle>
            <LayoutView Layout="@typeof(Layout.MainLayout)">
                <div class="container mt-5 text-center">
                    <i class="fa-solid fa-utensils" style="font-size:4rem;color:var(--primary-color);"></i>
                    <h1 class="mt-3">404</h1>
                    <p class="lead">Tej strony nie znaleziono. Moze szukasz czegos smacznego?</p>
                    <a href="/" class="btn btn-primary">
                        <i class="fa-solid fa-home me-1"></i> Strona glowna
                    </a>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
