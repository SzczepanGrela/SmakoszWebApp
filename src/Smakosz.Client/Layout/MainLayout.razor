@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject IAuthService AuthService
@inject ToastService ToastService
@inject IDishService DishService
@inject IJSRuntime JS

<nav class="navbar navbar-expand-lg fixed-top">
    <div class="container">
        <a class="navbar-brand" href="/">
            <i class="fa-solid fa-utensils me-2"></i>Smakosz
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" href="/">
                        <i class="fa-solid fa-house me-1"></i>Strona główna
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/search">
                        <i class="fa-solid fa-magnifying-glass me-1"></i>Szukaj
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/search?type=restaurants">
                        <i class="fa-solid fa-store me-1"></i>Restauracje
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/kategorie">
                        <i class="fa-solid fa-layer-group me-1"></i>Kategorie
                    </a>
                </li>
                <li class="nav-item">
                    <button class="nav-link" @onclick="GetRandomDish">
                        <i class="fa-solid fa-dice me-1"></i>Losowe danie
                    </button>
                </li>
                <AuthorizeView>
                    <Authorized>
                        <li class="nav-item">
                            <a class="nav-link" href="/recommendations">
                                <i class="fa-solid fa-wand-magic-sparkles me-1"></i>Rekomendacje
                            </a>
                        </li>
                    </Authorized>
                </AuthorizeView>
            </ul>
            <AuthorizeView>
                <Authorized>
                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item d-flex align-items-center">
                            <NotificationBell />
                        </li>
                        <li class="nav-item">
                            <UserDropdown />
                        </li>
                    </ul>
                </Authorized>
                <NotAuthorized>
                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item">
                            <a class="nav-link" href="/login">
                                <i class="fa-solid fa-right-to-bracket me-1"></i>Zaloguj
                            </a>
                        </li>
                        <li class="nav-item ms-2">
                            <a class="btn btn-primary btn-sm" href="/register">Rejestracja</a>
                        </li>
                    </ul>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</nav>

<main>
    @Body
</main>

<footer class="footer py-3 mt-5">
    <div class="container">
        <div class="row align-items-start">
            <div class="col-12 col-sm-6 col-md-4 mb-2 mb-md-0">
                <h5 class="mb-1"><i class="fa-solid fa-utensils me-2"></i>Smakosz</h5>
                <p class="text-muted small mb-0">Znajdź najlepszy smak w mieście. System recenzji restauracji i dań.</p>
            </div>
            <div class="col-12 col-sm-6 col-md-4 mb-2 mb-md-0">
                <h6 class="mb-1">Linki</h6>
                <ul class="list-unstyled small mb-0 footer-links-grid">
                    <li><a href="/about" class="text-decoration-none" style="color:var(--text-color);">O nas</a></li>
                    <li><a href="/terms" class="text-decoration-none" style="color:var(--text-color);">Regulamin</a></li>
                    <li><a href="/privacy" class="text-decoration-none" style="color:var(--text-color);">Polityka prywatności</a></li>
                    <li><a href="/contact" class="text-decoration-none" style="color:var(--text-color);">Kontakt</a></li>
                </ul>
            </div>
            <div class="col-12 col-md-4 text-md-end">
                <p class="small text-muted mb-0">&copy; @DateTime.Now.Year Smakosz. Wszelkie prawa zastrzeżone.</p>
            </div>
        </div>
    </div>
</footer>

<ToastContainer />
<ConfirmModalHost />
<ConcurrencyConflictModalHost />

@code {
    protected override void OnInitialized()
    {
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private async void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        try
        {
            await JS.InvokeVoidAsync("smakoszNav.closeMobileMenu", "#mainNav");
        }
        catch
        {
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }

    private async Task GetRandomDish()
    {
        var dish = await DishService.GetRandomAsync();
        if (dish != null)
            Navigation.NavigateTo($"/dishes/{dish.Slug}?fromRandom=true");
    }
}
