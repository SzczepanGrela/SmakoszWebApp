@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IAuthService AuthService
@inject ToastService ToastService

<!-- Fixed Navbar -->
<nav class="navbar navbar-expand-lg fixed-top">
    <div class="container">
        <a class="navbar-brand" href="/">
            <i class="fa-solid fa-utensils me-2"></i>Smakosz
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" href="/">Strona główna</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/search">Szukaj</a>
                </li>
                <AuthorizeView>
                    <Authorized>
                        <li class="nav-item">
                            <a class="nav-link" href="/recommendations">
                                <i class="fa-solid fa-wand-magic-sparkles me-1"></i>Rekomendacje
                            </a>
                        </li>
                    </Authorized>
                </AuthorizeView>
            </ul>
            <AuthorizeView>
                <Authorized>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <NotificationBell />
                        </li>
                        <li class="nav-item">
                            <UserDropdown />
                        </li>
                    </ul>
                </Authorized>
                <NotAuthorized>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" href="/login">
                                <i class="fa-solid fa-right-to-bracket me-1"></i>Zaloguj
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link btn btn-primary btn-sm ms-2 d-flex align-items-center" href="/register">Rejestracja</a>
                        </li>
                    </ul>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</nav>

<!-- Main Content -->
<main>
    @Body
</main>

<!-- Footer -->
<footer class="footer py-4 mt-5">
    <div class="container">
        <div class="row">
            <div class="col-md-4 mb-3">
                <h5><i class="fa-solid fa-utensils me-2"></i>Smakosz</h5>
                <p class="text-muted small">Znajdź najlepszy smak w mieście. System recenzji restauracji i dań.</p>
            </div>
            <div class="col-md-4 mb-3">
                <h6>Linki</h6>
                <ul class="list-unstyled small">
                    <li><a href="/about" class="text-decoration-none" style="color:var(--text-color);">O nas</a></li>
                    <li><a href="/terms" class="text-decoration-none" style="color:var(--text-color);">Regulamin</a></li>
                    <li><a href="/contact" class="text-decoration-none" style="color:var(--text-color);">Kontakt</a></li>
                </ul>
            </div>
            <div class="col-md-4 mb-3 text-md-end">
                <p class="small text-muted mb-0">&copy; @DateTime.Now.Year Smakosz. Wszelkie prawa zastrzeżone.</p>
            </div>
        </div>
    </div>
</footer>

<!-- Toast Container -->
<ToastContainer />
