@page "/following"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IUserProfileService UserProfileService
@inject IAuthService AuthService

<PageTitle>Obserwowani - Smakosz</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0"><i class="fa-solid fa-user-group me-2"></i>Obserwowani</h1>
        <a href="/profile" class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-arrow-left me-1"></i>Powrót do profilu
        </a>
    </div>

    @if (_loading)
    {
        <LoadingSpinner Text="Ładowanie obserwowanych..." />
    }
    else if (_result == null || !_result.Data.Any())
    {
        <EmptyState Icon="fa-solid fa-user-group" Title="Nie obserwujesz nikogo"
                    Description="Zacznij obserwować innych użytkowników, aby widzieć ich aktywność."
                    ActionText="Szukaj użytkowników" ActionUrl="/search" />
    }
    else
    {
        <div class="row">
            @foreach (var user in _result.Data)
            {
                <div class="col-md-6 col-lg-4 mb-3">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <UserCard User="@user" ShowFollowButton="true" IsFollowing="@user.IsFollowing" />
                        </div>
                    </div>
                </div>
            }
        </div>

        <Pagination Info="@_result.Pagination" OnPageChange="LoadPage" />
    }
</div>

@code {
    private PagedResult<UserSummaryDto>? _result;
    private bool _loading = true;
    private string? _mySlug;

    protected override async Task OnInitializedAsync()
    {
        var profile = await UserProfileService.GetMyProfileAsync();
        _mySlug = profile?.Slug;

        if (_mySlug != null)
        {
            await LoadPage(1);
        }
        else
        {
            _loading = false;
        }
    }

    private async Task LoadPage(int page)
    {
        _loading = true;
        _result = await UserProfileService.GetFollowingAsync(_mySlug!, page);
        _loading = false;
    }
}
