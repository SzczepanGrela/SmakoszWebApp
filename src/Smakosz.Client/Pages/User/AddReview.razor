@page "/review/add"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "user")]
@inject IReviewService ReviewService
@inject IDishService DishService
@inject ISearchService SearchService
@inject NavigationManager Navigation
@inject ToastService Toast

<PageTitle>Dodaj recenzje - Smakosz</PageTitle>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="mb-4"><i class="fa-solid fa-pen-to-square me-2"></i>Dodaj recenzje</h1>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-danger">
                    <i class="fa-solid fa-circle-exclamation me-2"></i>@_error
                </div>
            }

            @if (_loadingDish)
            {
                <LoadingSpinner Text="Ladowanie dania..." />
            }
            else
            {
                <!-- Dish selection / info -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="fa-solid fa-utensils me-2"></i>Danie</h5>
                    </div>
                    <div class="card-body">
                        @if (_selectedDish != null)
                        {
                            <div class="d-flex align-items-center gap-3">
                                <img src="@ImageHelper.GetDishImage(_selectedDish.ImageUrl)"
                                     class="rounded" style="width:80px;height:80px;object-fit:cover;"
                                     alt="@_selectedDish.DishName" />
                                <div class="flex-grow-1">
                                    <h5 class="mb-1">@_selectedDish.DishName</h5>
                                    @if (!string.IsNullOrEmpty(_selectedDish.RestaurantName))
                                    {
                                        <small class="text-muted">
                                            <i class="fa-solid fa-store me-1"></i>@_selectedDish.RestaurantName
                                        </small>
                                    }
                                    @if (!string.IsNullOrEmpty(_selectedDish.CityName))
                                    {
                                        <small class="text-muted ms-2">
                                            <i class="fa-solid fa-location-dot me-1"></i>@_selectedDish.CityName
                                        </small>
                                    }
                                </div>
                                @if (string.IsNullOrEmpty(DishSlug))
                                {
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="ClearDishSelection">
                                        <i class="fa-solid fa-xmark"></i>
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <!-- Dish search -->
                            <div class="mb-3">
                                <label class="form-label fw-medium">Wyszukaj danie</label>
                                <div class="input-group">
                                    <input type="text" class="form-control" @bind="_dishSearchQuery"
                                           @onkeydown="HandleDishSearchKey"
                                           placeholder="Wpisz nazwe dania..." />
                                    <button class="btn btn-outline-primary" @onclick="SearchDishes" disabled="@_searchingDishes">
                                        @if (_searchingDishes)
                                        {
                                            <span class="spinner-border spinner-border-sm"></span>
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-magnifying-glass"></i>
                                        }
                                    </button>
                                </div>
                            </div>

                            @if (_dishSearchResults != null && _dishSearchResults.Any())
                            {
                                <div class="list-group">
                                    @foreach (var dish in _dishSearchResults)
                                    {
                                        <button class="list-group-item list-group-item-action d-flex align-items-center gap-2"
                                                @onclick="() => SelectDish(dish)">
                                            <img src="@ImageHelper.GetDishImage(dish.ImageUrl)"
                                                 class="rounded" style="width:48px;height:48px;object-fit:cover;"
                                                 alt="@dish.DishName" />
                                            <div>
                                                <strong>@dish.DishName</strong>
                                                @if (!string.IsNullOrEmpty(dish.RestaurantName))
                                                {
                                                    <small class="text-muted d-block">@dish.RestaurantName</small>
                                                }
                                            </div>
                                        </button>
                                    }
                                </div>
                            }
                            else if (_dishSearchResults != null && !_dishSearchResults.Any())
                            {
                                <p class="text-muted small mt-2">Nie znaleziono dan. Sprobuj innej frazy.</p>
                            }
                        }
                    </div>
                </div>

                <!-- Review form -->
                @if (_selectedDish != null)
                {
                    <div class="card shadow-sm mb-4">
                        <div class="card-header">
                            <h5 class="mb-0"><i class="fa-solid fa-star me-2"></i>Oceny</h5>
                        </div>
                        <div class="card-body">
                            <RatingInput Label="Ocena dania" Value="@_model.DishRating"
                                         ValueChanged="v => _model.DishRating = v" />
                            <RatingInput Label="Obsluga" Value="@_model.ServiceRating"
                                         ValueChanged="v => _model.ServiceRating = v" />
                            <RatingInput Label="Czystosc" Value="@_model.CleanlinessRating"
                                         ValueChanged="v => _model.CleanlinessRating = v" />
                            <RatingInput Label="Atmosfera" Value="@_model.AmbianceRating"
                                         ValueChanged="v => _model.AmbianceRating = v" />
                        </div>
                    </div>

                    <div class="card shadow-sm mb-4">
                        <div class="card-header">
                            <h5 class="mb-0"><i class="fa-solid fa-comment me-2"></i>Szczegóły</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label fw-medium">Treść recenzji</label>
                                <textarea class="form-control" rows="5" @bind="_model.Content"
                                          placeholder="Opisz swoje doswiadczenie... Co Ci smakowalo? Co mozna poprawic?"></textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-medium">Data wizyty</label>
                                <input type="date" class="form-control" @bind="_visitDate" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>
                        </div>
                    </div>

                    <!-- Submit -->
                    <div class="d-flex justify-content-between">
                        <button class="btn btn-outline-secondary" @onclick="GoBack">
                            <i class="fa-solid fa-arrow-left me-1"></i>Anuluj
                        </button>
                        <button class="btn btn-primary btn-lg" @onclick="HandleSubmit" disabled="@_submitting">
                            @if (_submitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            <i class="fa-solid fa-paper-plane me-1"></i>Opublikuj recenzje
                        </button>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "dish")]
    public string? DishSlug { get; set; }

    private CreateReviewDto _model = new();
    private DishDetailDto? _selectedDish;
    private DateTime _visitDate = DateTime.Today;
    private bool _loadingDish;
    private bool _submitting;
    private string? _error;

    private string _dishSearchQuery = "";
    private List<DishCardDto>? _dishSearchResults;
    private bool _searchingDishes;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(DishSlug))
        {
            _loadingDish = true;
            _selectedDish = await DishService.GetBySlugAsync(DishSlug);
            if (_selectedDish != null)
            {
                _model.DishPublicId = _selectedDish.PublicId;
            }
            _loadingDish = false;
        }
    }

    private async Task SearchDishes()
    {
        if (string.IsNullOrWhiteSpace(_dishSearchQuery)) return;

        _searchingDishes = true;
        var result = await SearchService.SearchAsync("dishes", _dishSearchQuery, pageSize: 5);
        _dishSearchResults = result?.Dishes.ToList() ?? new List<DishCardDto>();
        _searchingDishes = false;
    }

    private void HandleDishSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") _ = SearchDishes();
    }

    private async Task SelectDish(DishCardDto dish)
    {
        _selectedDish = await DishService.GetBySlugAsync(dish.Slug);
        if (_selectedDish != null)
        {
            _model.DishPublicId = _selectedDish.PublicId;
        }
        _dishSearchResults = null;
        _dishSearchQuery = "";
    }

    private void ClearDishSelection()
    {
        _selectedDish = null;
        _model.DishPublicId = Guid.Empty;
        _dishSearchResults = null;
    }

    private async Task HandleSubmit()
    {
        _error = null;

        if (_selectedDish == null || _model.DishPublicId == Guid.Empty)
        {
            _error = "Wybierz danie, ktore chcesz ocenic.";
            return;
        }
        if (_model.DishRating < 1)
        {
            _error = "Ocena dania jest wymagana (minimum 1).";
            return;
        }
        if (_model.ServiceRating < 1)
        {
            _error = "Ocena obslugi jest wymagana (minimum 1).";
            return;
        }
        if (_model.CleanlinessRating < 1)
        {
            _error = "Ocena czystosci jest wymagana (minimum 1).";
            return;
        }
        if (_model.AmbianceRating < 1)
        {
            _error = "Ocena atmosfery jest wymagana (minimum 1).";
            return;
        }

        _model.VisitDate = _visitDate.ToString("yyyy-MM-dd");
        _submitting = true;

        var result = await ReviewService.CreateAsync(_model);
        if (result.Success)
        {
            Toast.ShowSuccess("Recenzja zostala opublikowana!");
            Navigation.NavigateTo($"/dish/{_selectedDish.Slug}");
        }
        else
        {
            _error = result.Error?.Message ?? "Nie udalo sie opublikowac recenzji. Sprobuj ponownie.";
        }
        _submitting = false;
    }

    private void GoBack()
    {
        if (_selectedDish != null)
        {
            Navigation.NavigateTo($"/dish/{_selectedDish.Slug}");
        }
        else
        {
            Navigation.NavigateTo("/");
        }
    }
}
