@page "/profile/notifications"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IUserProfileService UserProfileService
@inject PushSubscriptionManager PushManager
@inject ToastService Toast

<PageTitle>Ustawienia powiadomień - Smakosz</PageTitle>

<div class="container mt-4">
    <h1 class="mb-4"><i class="fa-solid fa-bell me-2"></i>Ustawienia powiadomień</h1>

    <div class="row">
        <div class="col-lg-3 mb-4">
            <div class="list-group shadow-sm">
                <a href="/profile" class="list-group-item list-group-item-action">
                    <i class="fa-solid fa-user me-2"></i>Profil
                </a>
                <a href="/profile/settings" class="list-group-item list-group-item-action">
                    <i class="fa-solid fa-gear me-2"></i>Ustawienia
                </a>
                <a href="/profile/security" class="list-group-item list-group-item-action">
                    <i class="fa-solid fa-shield-halved me-2"></i>Bezpieczeństwo
                </a>
                <a href="/profile/notifications" class="list-group-item list-group-item-action active">
                    <i class="fa-solid fa-bell me-2"></i>Powiadomienia
                </a>
            </div>
        </div>

        <div class="col-lg-9">
            @if (_loading)
            {
                <LoadingSpinner Text="Ładowanie ustawień powiadomień..." />
            }
            else if (_settings == null)
            {
                <EmptyState Icon="fa-solid fa-bell-slash" Title="Nie udało się załadować ustawień"
                            Description="Spróbuj odświeżyć stronę." />
            }
            else
            {
                <div class="card shadow-sm">
                    <div class="card-header">
                        <h5 class="mb-0">Preferencje powiadomień</h5>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(_error))
                        {
                            <div class="alert alert-danger">
                                <i class="fa-solid fa-circle-exclamation me-2"></i>@_error
                            </div>
                        }
                        @if (_saved)
                        {
                            <div class="alert alert-success">
                                <i class="fa-solid fa-check me-2"></i>Ustawienia zostały zapisane.
                            </div>
                        }

                        <div class="list-group list-group-flush">
                            <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                                <div>
                                    <div class="fw-medium">
                                        <i class="fa-solid fa-thumbs-up me-2 text-muted"></i>Polubienia
                                    </div>
                                    <small class="text-muted">Powiadamiaj mnie, gdy ktoś polubi moją recenzję.</small>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch"
                                           checked="@_settings.PushLike"
                                           @onchange="e => { _settings.PushLike = (bool)e.Value!; }" />
                                </div>
                            </div>

                            <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                                <div>
                                    <div class="fw-medium">
                                        <i class="fa-solid fa-user-plus me-2 text-muted"></i>Nowi obserwujący
                                    </div>
                                    <small class="text-muted">Powiadamiaj mnie, gdy ktoś zacznie mnie obserwować.</small>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch"
                                           checked="@_settings.PushFollow"
                                           @onchange="e => { _settings.PushFollow = (bool)e.Value!; }" />
                                </div>
                            </div>

                            <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                                <div>
                                    <div class="fw-medium">
                                        <i class="fa-solid fa-circle-info me-2 text-muted"></i>Systemowe
                                    </div>
                                    <small class="text-muted">Otrzymuj powiadomienia systemowe i ważne informacje.</small>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch"
                                           checked="@_settings.PushSystem"
                                           @onchange="e => { _settings.PushSystem = (bool)e.Value!; }" />
                                </div>
                            </div>

                            <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                                <div>
                                    <div class="fw-medium">
                                        <i class="fa-solid fa-shield-halved me-2 text-muted"></i>Bezpieczeństwo (email)
                                    </div>
                                    <small class="text-muted">Otrzymuj e-maile o zmianach hasła, wyłączeniu 2FA, blokadzie konta i logowaniach z nowych krajów.</small>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch"
                                           checked="@_settings.EmailSecurity"
                                           @onchange="e => { _settings.EmailSecurity = (bool)e.Value!; }" />
                                </div>
                            </div>

                            <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                                <div>
                                    <div class="fw-medium">
                                        <i class="fa-solid fa-shield-halved me-2 text-muted"></i>Bezpieczeństwo (push)
                                    </div>
                                    <small class="text-muted">Powiadomienia push o zdarzeniach bezpieczeństwa. Domyślnie wyłączone.</small>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch"
                                           checked="@_settings.PushSecurity"
                                           @onchange="e => { _settings.PushSecurity = (bool)e.Value!; }" />
                                </div>
                            </div>
                        </div>

                        <div class="mt-4">
                            <button class="btn btn-primary" @onclick="HandleSave" disabled="@_saving">
                                @if (_saving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                Zapisz ustawienia
                            </button>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm mt-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="fa-solid fa-mobile-screen me-2"></i>Powiadomienia push</h5>
                    </div>
                    <div class="card-body">
                        @if (!_pushSupported)
                        {
                            <div class="alert alert-info mb-0">
                                <i class="fa-solid fa-circle-info me-2"></i>Twoja przeglądarka nie obsługuje powiadomień push.
                            </div>
                        }
                        else if (_pushPermission == "denied")
                        {
                            <div class="alert alert-warning mb-0">
                                <i class="fa-solid fa-triangle-exclamation me-2"></i>Powiadomienia push zostały zablokowane w ustawieniach przeglądarki. Aby je włączyć, zmień uprawnienia w ustawieniach witryny.
                            </div>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                                    <div>
                                        <div class="fw-medium">
                                            <i class="fa-solid fa-bell me-2 text-muted"></i>Powiadomienia push
                                        </div>
                                        <small class="text-muted">Otrzymuj natywne powiadomienia nawet gdy aplikacja jest zamknięta.</small>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" role="switch"
                                               checked="@_pushEnabled"
                                               disabled="@_pushToggling"
                                               @onchange="HandlePushToggle" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private NotificationSettingsDto? _settings;
    private bool _loading = true;
    private bool _saving;
    private bool _saved;
    private string? _error;
    private bool _pushSupported;
    private string _pushPermission = "default";
    private bool _pushEnabled;
    private bool _pushToggling;

    protected override async Task OnInitializedAsync()
    {
        _settings = await UserProfileService.GetNotificationSettingsAsync();
        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _pushSupported = await PushManager.IsSupportedAsync();
            if (_pushSupported)
            {
                _pushPermission = await PushManager.GetPermissionAsync();
                _pushEnabled = await PushManager.IsSubscribedAsync();
            }
            StateHasChanged();
        }
    }

    private async Task HandlePushToggle()
    {
        _pushToggling = true;

        if (_pushEnabled)
        {
            var ok = await PushManager.UnsubscribeAsync();
            if (ok)
            {
                _pushEnabled = false;
                Toast.ShowSuccess("Powiadomienia push zostały wyłączone.");
            }
            else
            {
                Toast.ShowError("Nie udało się wyłączyć powiadomień push.");
            }
        }
        else
        {
            var ok = await PushManager.SubscribeAsync();
            if (ok)
            {
                _pushEnabled = true;
                _pushPermission = await PushManager.GetPermissionAsync();
                Toast.ShowSuccess("Powiadomienia push zostały włączone.");
            }
            else
            {
                _pushPermission = await PushManager.GetPermissionAsync();
                if (_pushPermission == "denied")
                    Toast.ShowError("Powiadomienia push zostały zablokowane w przeglądarce.");
                else
                    Toast.ShowError("Nie udało się włączyć powiadomień push.");
            }
        }

        _pushToggling = false;
    }

    private async Task HandleSave()
    {
        _saving = true;
        _error = null;
        _saved = false;

        var success = await UserProfileService.UpdateNotificationSettingsAsync(_settings!);
        if (success)
        {
            _saved = true;
            Toast.ShowSuccess("Ustawienia powiadomień zostały zapisane.");
        }
        else
        {
            _error = "Nie udało się zapisać ustawień. Spróbuj ponownie.";
        }
        _saving = false;
    }
}
