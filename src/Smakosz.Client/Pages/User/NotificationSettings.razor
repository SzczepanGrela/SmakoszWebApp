@page "/profile/notifications"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IUserProfileService UserProfileService
@inject ToastService Toast

<PageTitle>Ustawienia powiadomień - Smakosz</PageTitle>

<div class="container mt-4">
    <h1 class="mb-4"><i class="fa-solid fa-bell me-2"></i>Ustawienia powiadomień</h1>

    <div class="row">
        <!-- Sidebar navigation -->
        <div class="col-lg-3 mb-4">
            <div class="list-group shadow-sm">
                <a href="/profile" class="list-group-item list-group-item-action">
                    <i class="fa-solid fa-user me-2"></i>Profil
                </a>
                <a href="/profile/settings" class="list-group-item list-group-item-action">
                    <i class="fa-solid fa-gear me-2"></i>Ustawienia
                </a>
                <a href="/profile/security" class="list-group-item list-group-item-action">
                    <i class="fa-solid fa-shield-halved me-2"></i>Bezpieczeństwo
                </a>
                <a href="/profile/notifications" class="list-group-item list-group-item-action active">
                    <i class="fa-solid fa-bell me-2"></i>Powiadomienia
                </a>
            </div>
        </div>

        <!-- Notification settings content -->
        <div class="col-lg-9">
            @if (_loading)
            {
                <LoadingSpinner Text="Ładowanie ustawień powiadomień..." />
            }
            else if (_settings == null)
            {
                <EmptyState Icon="fa-solid fa-bell-slash" Title="Nie udało się załadować ustawień"
                            Description="Spróbuj odświeżyć stronę." />
            }
            else
            {
                <div class="card shadow-sm">
                    <div class="card-header">
                        <h5 class="mb-0">Preferencje powiadomień</h5>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(_error))
                        {
                            <div class="alert alert-danger">
                                <i class="fa-solid fa-circle-exclamation me-2"></i>@_error
                            </div>
                        }
                        @if (_saved)
                        {
                            <div class="alert alert-success">
                                <i class="fa-solid fa-check me-2"></i>Ustawienia zostały zapisane.
                            </div>
                        }

                        <div class="list-group list-group-flush">
                            <!-- Push Like -->
                            <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                                <div>
                                    <div class="fw-medium">
                                        <i class="fa-solid fa-thumbs-up me-2 text-muted"></i>Polubienia
                                    </div>
                                    <small class="text-muted">Powiadamiaj mnie, gdy ktoś polubi moją recenzję.</small>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch"
                                           checked="@_settings.PushLike"
                                           @onchange="e => { _settings.PushLike = (bool)e.Value!; }" />
                                </div>
                            </div>

                            <!-- Push Follow -->
                            <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                                <div>
                                    <div class="fw-medium">
                                        <i class="fa-solid fa-user-plus me-2 text-muted"></i>Nowi obserwujący
                                    </div>
                                    <small class="text-muted">Powiadamiaj mnie, gdy ktoś zacznie mnie obserwować.</small>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch"
                                           checked="@_settings.PushFollow"
                                           @onchange="e => { _settings.PushFollow = (bool)e.Value!; }" />
                                </div>
                            </div>

                            <!-- Push System -->
                            <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                                <div>
                                    <div class="fw-medium">
                                        <i class="fa-solid fa-circle-info me-2 text-muted"></i>Systemowe
                                    </div>
                                    <small class="text-muted">Otrzymuj powiadomienia systemowe i ważne informacje.</small>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch"
                                           checked="@_settings.PushSystem"
                                           @onchange="e => { _settings.PushSystem = (bool)e.Value!; }" />
                                </div>
                            </div>
                        </div>

                        <div class="mt-4">
                            <button class="btn btn-primary" @onclick="HandleSave" disabled="@_saving">
                                @if (_saving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                Zapisz ustawienia
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private NotificationSettingsDto? _settings;
    private bool _loading = true;
    private bool _saving;
    private bool _saved;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _settings = await UserProfileService.GetNotificationSettingsAsync();
        _loading = false;
    }

    private async Task HandleSave()
    {
        _saving = true;
        _error = null;
        _saved = false;

        var success = await UserProfileService.UpdateNotificationSettingsAsync(_settings!);
        if (success)
        {
            _saved = true;
            Toast.ShowSuccess("Ustawienia powiadomień zostały zapisane.");
        }
        else
        {
            _error = "Nie udało się zapisać ustawień. Spróbuj ponownie.";
        }
        _saving = false;
    }
}
