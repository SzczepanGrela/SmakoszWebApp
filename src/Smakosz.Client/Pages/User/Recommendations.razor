@page "/recommendations"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IRecommendationService RecommendationService

<PageTitle>Rekomendacje AI - Smakosz</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1"><i class="fa-solid fa-wand-magic-sparkles me-2"></i>Rekomendacje dla Ciebie</h1>
            <p class="text-muted mb-0">Dania dobrane specjalnie na podstawie Twoich preferencji i recenzji.</p>
        </div>
        <button class="btn btn-outline-primary" @onclick="LoadRecommendations" disabled="@_loading">
            <i class="fa-solid fa-rotate me-1"></i>Odswiez
        </button>
    </div>

    @if (_loading)
    {
        <LoadingSpinner Text="Generowanie rekomendacji AI..." />
    }
    else if (_data == null || !_data.Items.Any())
    {
        <EmptyState Icon="fa-solid fa-wand-magic-sparkles" Title="Brak rekomendacji"
                    Description="Dodaj wiecej recenzji, a nasz system AI przygotuje dla Ciebie spersonalizowane rekomendacje."
                    ActionText="Dodaj recenzje" ActionUrl="/review/add" />
    }
    else
    {
        @if (!string.IsNullOrEmpty(_data.GeneratedAt))
        {
            <div class="alert alert-info mb-4">
                <i class="fa-solid fa-robot me-2"></i>
                Rekomendacje wygenerowane: @_data.GeneratedAt
            </div>
        }

        <div class="row">
            @foreach (var item in _data.Items)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card shadow-sm h-100">
                        <a href="/dishes/@item.Dish.Slug" class="text-decoration-none">
                            <div class="position-relative">
                                <img src="@ImageHelper.GetDishImage(item.Dish.ImageUrl)"
                                     class="card-img-top" style="height:200px;object-fit:cover;"
                                     alt="@item.Dish.DishName" loading="lazy" />
                                <span class="badge bg-primary position-absolute top-0 end-0 m-2">
                                    <i class="fa-solid fa-wand-magic-sparkles me-1"></i>@item.Score.ToString("F0")% dopasowanie
                                </span>
                            </div>
                        </a>
                        <div class="card-body d-flex flex-column">
                            <a href="/dishes/@item.Dish.Slug" class="text-decoration-none" style="color:var(--text-color);">
                                <h5 class="card-title mb-1">@item.Dish.DishName</h5>
                            </a>
                            @if (!string.IsNullOrEmpty(item.Dish.RestaurantName))
                            {
                                <small class="text-muted mb-2">
                                    <i class="fa-solid fa-store me-1"></i>@item.Dish.RestaurantName
                                </small>
                            }
                            <div class="mb-2">
                                @if (item.Dish.AvgRating.HasValue)
                                {
                                    <RatingStars Rating="@item.Dish.AvgRating.Value" Size="sm" />
                                    <small class="text-muted ms-1">(@item.Dish.ReviewCount)</small>
                                }
                            </div>
                            @if (item.Dish.Price.HasValue)
                            {
                                <span class="fw-bold mb-2" style="color:var(--accent-color);">
                                    @item.Dish.Price.Value.ToString("F2") zł
                                </span>
                            }
                            <DietaryBadges IsVegan="@item.Dish.IsVegan" IsVegetarian="@item.Dish.IsVegetarian"
                                           IsGlutenFree="@item.Dish.IsGlutenFree" />

                            <div class="mt-auto pt-3 border-top">
                                <div class="d-flex align-items-start gap-2">
                                    <i class="fa-solid fa-robot text-primary mt-1"></i>
                                    <small class="text-muted">@item.Reason</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private RecommendationsDto? _data;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadRecommendations();
    }

    private async Task LoadRecommendations()
    {
        _loading = true;
        _data = await RecommendationService.GetRecommendationsAsync();
        _loading = false;
    }
}
