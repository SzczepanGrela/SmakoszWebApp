@page "/profile/security"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IUserProfileService UserProfileService
@inject Smakosz.Client.Services.IPublicConfigService ConfigService
@inject Smakosz.Client.Services.IAuthService AuthService
@inject NavigationManager Navigation
@inject ToastService Toast

<PageTitle>Bezpieczeństwo - Smakosz</PageTitle>

<div class="container mt-4">
    <h1 class="mb-4"><i class="fa-solid fa-shield-halved me-2"></i>Bezpieczeństwo</h1>

    <div class="row">
        <div class="col-lg-3 mb-4">
            <div class="list-group shadow-sm">
                <a href="/profile" class="list-group-item list-group-item-action">
                    <i class="fa-solid fa-user me-2"></i>Profil
                </a>
                <a href="/profile/settings" class="list-group-item list-group-item-action">
                    <i class="fa-solid fa-gear me-2"></i>Ustawienia
                </a>
                <a href="/profile/security" class="list-group-item list-group-item-action active">
                    <i class="fa-solid fa-shield-halved me-2"></i>Bezpieczeństwo
                </a>
                <a href="/profile/notifications" class="list-group-item list-group-item-action">
                    <i class="fa-solid fa-bell me-2"></i>Powiadomienia
                </a>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fa-solid fa-key me-2"></i>Zmiana hasła</h5>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(_passwordError))
                    {
                        <div class="alert alert-danger">
                            <i class="fa-solid fa-circle-exclamation me-2"></i>@_passwordError
                        </div>
                    }
                    @if (_passwordChanged)
                    {
                        <div class="alert alert-success">
                            <i class="fa-solid fa-check me-2"></i>Hasło zostało zmienione.
                        </div>
                    }

                    <EditForm Model="_passwordModel" OnValidSubmit="HandleChangePassword">
                        <div class="mb-3">
                            <label class="form-label fw-medium">Obecne hasło</label>
                            <PasswordInput Value="@_passwordModel.CurrentPassword"
                                           ValueChanged="v => _passwordModel.CurrentPassword = v"
                                           Placeholder="Wprowadź obecne hasło" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-medium">Nowe hasło</label>
                            <PasswordInput Value="@_passwordModel.NewPassword"
                                           ValueChanged="v => _passwordModel.NewPassword = v"
                                           Placeholder="Wprowadź nowe hasło" />
                            <small class="text-muted">Minimum @_passwordMin znaków, wielka litera, cyfra i znak specjalny.</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-medium">Potwierdź nowe hasło</label>
                            <PasswordInput Value="@_passwordModel.ConfirmPassword"
                                           ValueChanged="v => _passwordModel.ConfirmPassword = v"
                                           Placeholder="Powtórz nowe hasło" />
                        </div>
                        <button type="submit" class="btn btn-primary" disabled="@_changingPassword">
                            @if (_changingPassword)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Zmień hasło
                        </button>
                    </EditForm>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fa-solid fa-desktop me-2"></i>Aktywne sesje</h5>
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-danger btn-sm" @onclick="RevokeAll"
                                disabled="@(_loadingSessions || _sessions == null || _sessions.Count <= 1)">
                            <i class="fa-solid fa-right-from-bracket me-1"></i>Wyloguj wszystkie inne
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="LoadSessions" disabled="@_loadingSessions">
                            <i class="fa-solid fa-rotate me-1"></i>Odśwież
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    @if (_loadingSessions)
                    {
                        <LoadingSpinner Text="Ładowanie sesji..." />
                    }
                    else if (_sessions == null || !_sessions.Any())
                    {
                        <EmptyState Icon="fa-solid fa-desktop" Title="Brak aktywnych sesji"
                                    Description="Nie znaleziono aktywnych sesji." />
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var session in _sessions)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="fa-solid fa-desktop text-muted"></i>
                                            <strong>Sesja #@session.SessionId</strong>
                                            @if (session.IsCurrent)
                                            {
                                                <span class="badge bg-success">Obecna sesja</span>
                                            }
                                        </div>
                                        <small class="text-muted d-block mt-1">
                                            Zalogowano: @(session.CreatedAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")
                                            <span class="mx-1">|</span>
                                            Wygasa: @session.ExpiresAt.ToString("dd.MM.yyyy HH:mm")
                                        </small>
                                    </div>
                                    @if (!session.IsCurrent)
                                    {
                                        <button class="btn btn-outline-danger btn-sm" @onclick="() => RevokeSession(session.SessionId)">
                                            <i class="fa-solid fa-right-from-bracket me-1"></i>Wyloguj
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="card shadow-sm mt-4 border-danger">
                <div class="card-header bg-danger bg-opacity-10">
                    <h5 class="mb-0 text-danger"><i class="fa-solid fa-trash-can me-2"></i>Usunięcie konta</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning mb-3">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>
                        <strong>Uwaga:</strong> Usunięcie konta jest nieodwracalne. Twoje dane osobowe zostaną zanonimizowane natychmiast,
                        a konto zostanie trwale usunięte po 30 dniach. Wszystkie recenzje, zapisane dania i obserwacje zostaną usunięte.
                    </div>
                    <button class="btn btn-danger" @onclick="() => _showDeleteModal = true">
                        <i class="fa-solid fa-trash-can me-1"></i>Usuń konto
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@if (_showDeleteModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger bg-opacity-10">
                    <h5 class="modal-title text-danger">
                        <i class="fa-solid fa-trash-can me-2"></i>Usunięcie konta
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseDeleteModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_deleteError))
                    {
                        <div class="alert alert-danger">
                            <i class="fa-solid fa-circle-exclamation me-2"></i>@_deleteError
                        </div>
                    }

                    @if (_deleteStep == 1)
                    {
                        <p>Aby kontynuować, wprowadź swoje hasło. Wyślemy kod potwierdzający na Twój adres email.</p>
                        <div class="mb-3">
                            <label class="form-label fw-medium">Hasło</label>
                            <PasswordInput Value="@_deletePassword"
                                           ValueChanged="v => _deletePassword = v"
                                           Placeholder="Wprowadź hasło" />
                        </div>
                    }
                    else if (_deleteStep == 2)
                    {
                        <div class="alert alert-info">
                            <i class="fa-solid fa-envelope me-2"></i>Kod weryfikacyjny został wysłany na Twój adres email.
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-medium">Kod weryfikacyjny</label>
                            <input type="text" class="form-control" @bind="_deleteCode"
                                   placeholder="Wprowadź 6-cyfrowy kod" maxlength="6" />
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDeleteModal" disabled="@_deleting">Anuluj</button>
                    @if (_deleteStep == 1)
                    {
                        <button type="button" class="btn btn-danger" @onclick="HandleRequestDeletion" disabled="@_deleting">
                            @if (_deleting)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Wyślij kod potwierdzający
                        </button>
                    }
                    else if (_deleteStep == 2)
                    {
                        <button type="button" class="btn btn-danger" @onclick="HandleConfirmDeletion" disabled="@_deleting">
                            @if (_deleting)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Potwierdź usunięcie
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<SessionDto>? _sessions;
    private bool _loadingSessions = true;
    private bool _changingPassword;
    private bool _passwordChanged;
    private string? _passwordError;

    private ChangePasswordModel _passwordModel = new();
    private int _passwordMin = 8;

    protected override async Task OnInitializedAsync()
    {
        _passwordMin = await ConfigService.GetIntAsync("auth.password_min_length", 8);
        await LoadSessions();
    }

    private async Task LoadSessions()
    {
        _loadingSessions = true;
        _sessions = await UserProfileService.GetSessionsAsync();
        _loadingSessions = false;
    }

    private async Task HandleChangePassword()
    {
        _passwordError = null;
        _passwordChanged = false;

        if (string.IsNullOrWhiteSpace(_passwordModel.CurrentPassword))
        {
            _passwordError = "Wprowadź obecne hasło.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_passwordModel.NewPassword))
        {
            _passwordError = "Wprowadź nowe hasło.";
            return;
        }
        if (_passwordModel.NewPassword.Length < _passwordMin)
        {
            _passwordError = $"Nowe hasło musi mieć co najmniej {_passwordMin} znaków.";
            return;
        }
        if (_passwordModel.NewPassword != _passwordModel.ConfirmPassword)
        {
            _passwordError = "Hasła nie są zgodne.";
            return;
        }

        _changingPassword = true;
        var success = await UserProfileService.ChangePasswordAsync(
            _passwordModel.CurrentPassword, _passwordModel.NewPassword);

        if (success)
        {
            _passwordChanged = true;
            _passwordModel = new ChangePasswordModel();
            Toast.ShowSuccess("Hasło zostało zmienione.");
        }
        else
        {
            _passwordError = "Nie udało się zmienić hasła. Sprawdź, czy obecne hasło jest poprawne.";
        }
        _changingPassword = false;
    }

    private async Task RevokeSession(long sessionId)
    {
        var success = await UserProfileService.RevokeSessionAsync(sessionId);
        if (success)
        {
            Toast.ShowSuccess("Sesja została wylogowana.");
            await LoadSessions();
        }
        else
        {
            Toast.ShowError("Nie udało się wylogować sesji.");
        }
    }

    private async Task RevokeAll()
    {
        var success = await UserProfileService.RevokeAllSessionsAsync();
        if (success)
        {
            Toast.ShowSuccess("Wszystkie inne sesje zostały wylogowane.");
            await LoadSessions();
        }
        else
        {
            Toast.ShowError("Nie udało się wylogować sesji.");
        }
    }

    private bool _showDeleteModal;
    private int _deleteStep = 1;
    private string _deletePassword = "";
    private string _deleteCode = "";
    private bool _deleting;
    private string? _deleteError;

    private async Task HandleRequestDeletion()
    {
        _deleteError = null;

        if (string.IsNullOrWhiteSpace(_deletePassword))
        {
            _deleteError = "Wprowadź hasło.";
            return;
        }

        _deleting = true;
        var success = await UserProfileService.RequestAccountDeletionAsync(_deletePassword);

        if (success)
        {
            _deleteStep = 2;
            _deleteError = null;
        }
        else
        {
            _deleteError = "Nieprawidłowe hasło lub nie można usunąć konta.";
        }
        _deleting = false;
    }

    private async Task HandleConfirmDeletion()
    {
        _deleteError = null;

        if (string.IsNullOrWhiteSpace(_deleteCode))
        {
            _deleteError = "Wprowadź kod weryfikacyjny.";
            return;
        }

        _deleting = true;
        var success = await UserProfileService.ConfirmAccountDeletionAsync(_deleteCode);

        if (success)
        {
            await AuthService.LogoutAsync();
            Navigation.NavigateTo("/", forceLoad: true);
        }
        else
        {
            _deleteError = "Nieprawidłowy lub wygasły kod weryfikacyjny.";
        }
        _deleting = false;
    }

    private void CloseDeleteModal()
    {
        _showDeleteModal = false;
        _deleteStep = 1;
        _deletePassword = "";
        _deleteCode = "";
        _deleteError = null;
    }

    private class ChangePasswordModel
    {
        public string CurrentPassword { get; set; } = "";
        public string NewPassword { get; set; } = "";
        public string ConfirmPassword { get; set; } = "";
    }
}
