@page "/verify-email"
@layout Smakosz.Client.Layout.AuthLayout
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Weryfikacja email - Smakosz</PageTitle>

<div class="text-center">
    <i class="fa-solid fa-envelope-open-text fa-3x mb-3" style="color:var(--primary-color);"></i>
    <h4 class="mb-3">Zweryfikuj swój email</h4>
    @if (!string.IsNullOrEmpty(Email))
    {
        <p class="text-muted">Wysłaliśmy kod weryfikacyjny na adres <strong>@Email</strong></p>
    }
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger mt-3"><i class="fa-solid fa-circle-exclamation me-2"></i>@_error</div>
}
@if (_success)
{
    <div class="alert alert-success mt-3"><i class="fa-solid fa-check-circle me-2"></i>Email zweryfikowany! Przekierowywanie...</div>
}

<div class="mt-4">
    <label class="form-label">Kod weryfikacyjny</label>
    <input type="text" class="form-control form-control-lg text-center" maxlength="6" @bind="_code" placeholder="000000" />
</div>
<button class="btn btn-primary w-100 mt-3" @onclick="Verify" disabled="@_loading">
    @if (_loading) { <span class="spinner-border spinner-border-sm me-2"></span> }
    Zweryfikuj
</button>

<div class="text-center mt-3">
    <button class="btn btn-link btn-sm text-decoration-none" @onclick="ResendCode" disabled="@(_resendCooldown > 0)">
        <i class="fa-solid fa-rotate-right me-1"></i>
        @if (_resendCooldown > 0)
        {
            <span>Wyślij ponownie kod (@_resendCooldown s)</span>
        }
        else
        {
            <span>Wyślij ponownie kod</span>
        }
    </button>
</div>

@code {
    [SupplyParameterFromQuery] public string? Email { get; set; }
    private string _code = "";
    private string? _error;
    private bool _loading;
    private bool _success;
    private int _resendCooldown;
    private System.Threading.Timer? _timer;

    private async Task Verify()
    {
        _loading = true;
        _error = null;
        var result = await AuthService.VerifyEmailAsync(new VerifyEmailRequest { Email = Email ?? "", Code = _code });
        if (result.Success)
        {
            _success = true;
            await Task.Delay(1500);
            Navigation.NavigateTo("/login", forceLoad: true);
        }
        else
        {
            _error = result.Error?.GetDisplayMessage() ?? "Nieprawidłowy kod.";
        }
        _loading = false;
    }

    private async Task ResendCode()
    {
        if (string.IsNullOrEmpty(Email)) return;
        _error = null;
        var result = await AuthService.ResendVerificationAsync(Email);
        if (result.Success)
        {
            StartCooldown();
        }
        else
        {
            _error = result.Error?.GetDisplayMessage() ?? "Nie udało się wysłać kodu.";
        }
    }

    private void StartCooldown()
    {
        _resendCooldown = 60;
        _timer?.Dispose();
        _timer = new System.Threading.Timer(_ =>
        {
            _resendCooldown--;
            if (_resendCooldown <= 0) _timer?.Dispose();
            InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
