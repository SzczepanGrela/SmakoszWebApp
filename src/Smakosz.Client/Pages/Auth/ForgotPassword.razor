@page "/forgot-password"
@layout Smakosz.Client.Layout.AuthLayout
@inject IAuthService AuthService

<PageTitle>Resetuj haslo - Smakosz</PageTitle>

<div class="text-center mb-4">
    <i class="fa-solid fa-key fa-3x mb-3" style="color:var(--primary-color);"></i>
    <h4>Nie pamietasz hasla?</h4>
    <p class="text-muted small">Podaj swoj adres email, a wyslemy Ci link do resetowania hasla.</p>
</div>

@if (_sent)
{
    <div class="alert alert-success">
        <i class="fa-solid fa-check-circle me-2"></i>
        Jezeli konto z tym adresem istnieje, wyslalismy link do resetowania hasla.
    </div>
}

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">
        <i class="fa-solid fa-circle-exclamation me-2"></i>@_error
    </div>
}

<div class="mb-3">
    <label class="form-label">Email</label>
    <input type="email" class="form-control" @bind="_email" required />
</div>
<button class="btn btn-primary w-100" @onclick="Send" disabled="@(_sent || _loading)">
    @if (_loading) { <span class="spinner-border spinner-border-sm me-2"></span> }
    Wyslij link
</button>

<div class="text-center mt-3">
    <a href="/login" class="small"><i class="fa-solid fa-arrow-left me-1"></i>Powrot do logowania</a>
</div>

@code {
    private string _email = "";
    private bool _sent;
    private bool _loading;
    private string? _error;

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(_email)) return;
        _loading = true;
        _error = null;
        var result = await AuthService.ForgotPasswordAsync(_email);
        if (result.Success)
        {
            _sent = true;
        }
        else
        {
            _error = result.Error?.Message ?? "Wystapil blad. Sprobuj ponownie.";
        }
        _loading = false;
    }
}
