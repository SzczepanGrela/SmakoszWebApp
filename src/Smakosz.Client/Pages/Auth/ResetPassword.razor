@page "/reset-password"
@layout Smakosz.Client.Layout.AuthLayout
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Nowe hasło - Smakosz</PageTitle>

<div class="text-center mb-4">
    <h4>Ustaw nowe hasło</h4>
</div>

@if (_success)
{
    <div class="alert alert-success">
        <i class="fa-solid fa-check-circle me-2"></i>Hasło zostało zmienione. Możesz się teraz zalogować.
    </div>
    <a href="/login" class="btn btn-primary w-100">Przejdź do logowania</a>
}
else
{
    <div class="mb-3">
        <label class="form-label">Nowe hasło</label>
        <Smakosz.Client.Components.PasswordInput Value="@_password" ValueChanged="v => _password = v" Placeholder="Min. 8 znaków" />
    </div>
    <div class="mb-3">
        <label class="form-label">Potwierdź hasło</label>
        <Smakosz.Client.Components.PasswordInput Value="@_confirmPassword" ValueChanged="v => _confirmPassword = v" Placeholder="Powtórz hasło" />
    </div>
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger small">@_error</div>
    }
    <button class="btn btn-primary w-100" @onclick="Submit" disabled="@_loading">
        @if (_loading) { <span class="spinner-border spinner-border-sm me-2"></span> }
        Zmień hasło
    </button>
}

@code {
    [SupplyParameterFromQuery] public string? Token { get; set; }
    private string _password = "";
    private string _confirmPassword = "";
    private string? _error;
    private bool _success;
    private bool _loading;

    private async Task Submit()
    {
        if (_password.Length < 8) { _error = "Hasło musi mieć min. 8 znaków."; return; }
        if (_password != _confirmPassword) { _error = "Hasła nie są identyczne."; return; }
        if (string.IsNullOrEmpty(Token)) { _error = "Brak tokenu resetowania."; return; }

        _loading = true;
        _error = null;
        var result = await AuthService.ResetPasswordAsync(Token, _password, _confirmPassword);
        if (result.Success)
        {
            _success = true;
        }
        else
        {
            _error = result.Error?.Message ?? "Nie udało się zresetować hasła.";
        }
        _loading = false;
    }
}
