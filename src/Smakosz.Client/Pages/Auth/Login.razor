@page "/login"
@layout Smakosz.Client.Layout.AuthLayout
@inject Smakosz.Client.Services.IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Logowanie - Smakosz</PageTitle>

<h4 class="text-center mb-4">Zaloguj się</h4>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation me-2"></i>@_error</div>
}

<EditForm Model="_model" OnValidSubmit="HandleLogin">
    <div class="mb-3">
        <label class="form-label">Email</label>
        <input type="email" class="form-control" @bind="_model.Email" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Hasło</label>
        <Smakosz.Client.Components.PasswordInput Value="@_model.Password" ValueChanged="v => _model.Password = v" />
    </div>
    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" @bind="_model.RememberMe" />
        <label class="form-check-label">Zapamiętaj mnie</label>
    </div>
    <div class="mb-3">
        <Smakosz.Client.Components.TurnstileWidget @ref="_turnstileWidget" OnVerified="t => _turnstileToken = t" />
    </div>
    <button type="submit" class="btn btn-primary w-100 @(_loading ? "loading" : "")" disabled="@_loading">
        @if (_loading) { <span class="spinner-border spinner-border-sm me-2"></span> }
        Zaloguj się
    </button>
</EditForm>

<div class="text-center mt-3">
    <a href="/forgot-password" class="small">Nie pamiętasz hasła?</a>
</div>
<div class="text-center mt-2">
    <span class="small">Nie masz konta?</span> <a href="/register" class="small fw-bold">Zarejestruj się</a>
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    private Smakosz.Client.Models.LoginRequest _model = new();
    private string? _error;
    private bool _loading;
    private string? _turnstileToken;
    private Smakosz.Client.Components.TurnstileWidget? _turnstileWidget;

    private async Task HandleLogin()
    {
        _loading = true;
        _error = null;
        try
        {
            _model.TurnstileToken = _turnstileToken;
            var result = await AuthService.LoginAsync(_model);
            if (result.Success)
            {
                Navigation.NavigateTo(ReturnUrl ?? "/", forceLoad: true);
                return;
            }
            else if (result.Error?.Code == "AUTH_EMAIL_NOT_VERIFIED")
            {
                Navigation.NavigateTo($"/verify-email?email={Uri.EscapeDataString(_model.Email)}");
                return;
            }
            else if (result.Error?.Code == "AUTH_2FA_REQUIRED")
            {
                Navigation.NavigateTo($"/verify-2fa?email={Uri.EscapeDataString(_model.Email)}");
                return;
            }
            else if (result.Error?.Code == "AUTH_ACCOUNT_LOCKED")
            {
                _error = "Konto tymczasowo zablokowane z powodu zbyt wielu prób logowania. Spróbuj ponownie za kilka minut.";
            }
            else
            {
                _error = result.Error?.GetDisplayMessage() ?? "Nieprawidłowy email lub hasło.";
            }
        }
        catch (Exception)
        {
            _error = "Wystąpił błąd połączenia. Spróbuj ponownie.";
        }
        finally
        {
            _turnstileToken = null;
            if (_turnstileWidget is not null)
            {
                try { await _turnstileWidget.ResetAsync(); } catch { }
            }
            _loading = false;
        }
    }
}
