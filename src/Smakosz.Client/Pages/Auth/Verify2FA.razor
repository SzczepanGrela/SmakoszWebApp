@page "/verify-2fa"
@layout Smakosz.Client.Layout.AuthLayout
@inject NavigationManager Navigation

<PageTitle>Weryfikacja 2FA - Smakosz</PageTitle>

<div class="text-center mb-4">
    <i class="fa-solid fa-shield-halved fa-3x mb-3" style="color:var(--primary-color);"></i>
    <h4>Weryfikacja dwuetapowa</h4>
    <p class="text-muted small">Wprowadz kod z aplikacji uwierzytelniajcej.</p>
</div>

<div class="mb-3">
    <input type="text" class="form-control form-control-lg text-center" maxlength="6" @bind="_code" placeholder="000000" />
</div>
<button class="btn btn-primary w-100" @onclick="Verify">Zweryfikuj</button>
<div class="text-center mt-3">
    <a href="/login" class="small"><i class="fa-solid fa-arrow-left me-1"></i>Powrot</a>
</div>

@code {
    private string _code = "";

    private void Verify()
    {
        if (_code.Length == 6)
            Navigation.NavigateTo("/", forceLoad: true);
    }
}
