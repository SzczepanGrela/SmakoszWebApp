@page "/register"
@layout Smakosz.Client.Layout.AuthLayout
@inject Smakosz.Client.Services.IAuthService AuthService
@inject Smakosz.Client.Services.IPublicConfigService ConfigService
@inject NavigationManager Navigation

<PageTitle>Rejestracja - Smakosz</PageTitle>

<h4 class="text-center mb-4">Utwórz konto</h4>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation me-2"></i>@_error</div>
}

<EditForm Model="_model" OnValidSubmit="HandleRegister">
    <div class="mb-3">
        <label class="form-label">Nazwa użytkownika</label>
        <input type="text" class="form-control" @bind="_model.Username" required minlength="@_usernameMin" maxlength="@_usernameMax" />
    </div>
    <div class="mb-3">
        <label class="form-label">Email</label>
        <input type="email" class="form-control" @bind="_model.Email" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Hasło</label>
        <Smakosz.Client.Components.PasswordInput Value="@_model.Password" ValueChanged="v => _model.Password = v" Placeholder="@($"Min. {_passwordMin} znaków")" />
    </div>
    <div class="mb-3">
        <Smakosz.Client.Components.TurnstileWidget @ref="_turnstileWidget" OnVerified="t => _turnstileToken = t" />
    </div>
    <button type="submit" class="btn btn-primary w-100 @(_loading ? "loading" : "")" disabled="@_loading">
        @if (_loading) { <span class="spinner-border spinner-border-sm me-2"></span> }
        Zarejestruj się
    </button>
</EditForm>

<div class="text-center mt-3">
    <span class="small">Masz już konto?</span> <a href="/login" class="small fw-bold">Zaloguj się</a>
</div>

@code {
    private Smakosz.Client.Models.RegisterRequest _model = new();
    private string? _error;
    private bool _loading;
    private string? _turnstileToken;
    private Smakosz.Client.Components.TurnstileWidget? _turnstileWidget;
    private int _usernameMin = 3;
    private int _usernameMax = 30;
    private int _passwordMin = 8;

    protected override async Task OnInitializedAsync()
    {
        _usernameMin = await ConfigService.GetIntAsync("auth.username_min_length", 3);
        _usernameMax = await ConfigService.GetIntAsync("auth.username_max_length", 30);
        _passwordMin = await ConfigService.GetIntAsync("auth.password_min_length", 8);
    }

    private async Task HandleRegister()
    {
        _loading = true;
        _error = null;
        _model.TurnstileToken = _turnstileToken;
        var result = await AuthService.RegisterAsync(_model);
        if (result.Success)
        {
            Navigation.NavigateTo($"/verify-email?email={Uri.EscapeDataString(_model.Email)}");
            return;
        }
        _error = result.Error?.GetDisplayMessage() ?? "Błąd rejestracji.";
        _turnstileToken = null;
        if (_turnstileWidget is not null) await _turnstileWidget.ResetAsync();
        _loading = false;
    }
}
