@page "/"
@inject IHomeService HomeService
@inject IDishService DishService
@inject IRecommendationService RecommendationService
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation

<PageTitle>Smakosz - Znajdź najlepszy smak w mieście</PageTitle>

@if (_loading)
{
    <LoadingSpinner Text="Ładowanie..." />
}
else if (_data != null)
{
    <HeroSection BackgroundUrl="@_heroImage" BlurHash="@_heroBlurHash" CreditText="@_heroCreditText">
        <h1 class="display-4 fw-bold mb-3">Znajdź najlepszy smak w mieście</h1>
        <p class="lead mb-4">Najlepsze dania ze wszystkich restauracji.</p>

        <div class="row justify-content-center mb-4">
            <div class="col-auto">
                <div class="d-flex gap-4 text-center stats-container">
                    <div>
                        <div class="fw-bold fs-4">@_data.Stats.TotalDishes.ToString("N0")</div>
                        <small>Dań</small>
                    </div>
                    <div>
                        <div class="fw-bold fs-4">@_data.Stats.TotalRestaurants</div>
                        <small>Restauracji</small>
                    </div>
                    <div>
                        <div class="fw-bold fs-4">@_data.Stats.TotalReviews.ToString("N0")</div>
                        <small>Ocen</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="d-flex flex-column flex-md-row gap-2">
                    <SearchAutocomplete @bind-Value="_searchQuery"
                                        OnSearch="_ => DoSearch()"
                                        CssClass="form-control form-control-lg"
                                        Placeholder="Jakiego dania szukasz? (np. pizza, ramen...)" />
                    <button class="btn btn-primary btn-lg" @onclick="DoSearch">
                        <i class="fa-solid fa-magnifying-glass"></i> Szukaj
                    </button>
                </div>
            </div>
        </div>
    </HeroSection>

    <div class="container mt-5">
        @if (_recs?.NcfAvailable == true && _recs.Personalized.Count > 0)
        {
            <section class="mb-5">
                <SectionHeader Title="Polecane dla Ciebie" Icon="fa-solid fa-wand-magic-sparkles text-primary" />
                <HorizontalCarousel Items="@_recs.Personalized.Take(4).ToList()" Context="rec">
                    <a href="/dishes/@(rec.Slug ?? rec.DishId.ToString())" class="card recommended-dish-card text-decoration-none h-100">
                        <img src="@ImageHelper.GetDishImage(rec.ImageUrl)" alt="@rec.Name"
                             class="card-img-top" style="height:160px;object-fit:cover;" loading="lazy" />
                        <div class="card-body">
                            <div class="fw-semibold mb-1">@rec.Name</div>
                            @if (!string.IsNullOrWhiteSpace(rec.RestaurantName))
                            {
                                <small class="text-muted"><i class="fa-solid fa-store me-1"></i>@rec.RestaurantName</small>
                            }
                        </div>
                    </a>
                </HorizontalCarousel>
            </section>
        }

        @if (_data.PopularCategories.Any())
        {
            <section class="mb-5">
                <h2 class="text-center mb-4">Popularne kategorie</h2>
                <div class="row g-3 justify-content-center">
                    @foreach (var category in _data.PopularCategories)
                    {
                        <div class="col-6 col-md-3">
                            <CategoryCard Name="@category.Name" Slug="@category.Slug" Icon="@category.Icon" />
                        </div>
                    }
                    <div class="col-6 col-md-3">
                        <CategoryCard Name="Wszystkie kategorie" Icon="📋" Href="/kategorie" />
                    </div>
                </div>
            </section>
        }

        @if (_data.TrendingDishes.Any())
        {
            <section class="mb-5">
                <SectionHeader Title="Teraz na topie" Icon="fa-solid fa-fire text-danger" />
                <HorizontalCarousel Items="@_data.TrendingDishes" Context="dish">
                    <DishCard Dish="@dish" BadgeText="Trending" BadgeClass="bg-danger" />
                </HorizontalCarousel>
            </section>
        }

        @if (_data.TrendingRestaurants.Any())
        {
            <section class="mb-5">
                <SectionHeader Title="Popularne miejsca" Icon="fa-solid fa-fire text-danger" />
                <HorizontalCarousel Items="@_data.TrendingRestaurants" Context="restaurant">
                    <RestaurantCard Restaurant="@restaurant" />
                </HorizontalCarousel>
            </section>
        }

        @if (_data.TopRatedDishes.Any())
        {
            <section class="mb-5">
                <SectionHeader Title="Wysoko oceniane" Icon="fa-solid fa-star text-warning" />
                <HorizontalCarousel Items="@_data.TopRatedDishes" Context="dish">
                    <DishCard Dish="@dish" />
                </HorizontalCarousel>
            </section>
        }

        @if (_data.NewestRestaurants.Any())
        {
            <section class="mb-5">
                <SectionHeader Title="Najnowsze miejsca" Icon="fa-solid fa-sparkles text-info" />
                <HorizontalCarousel Items="@_data.NewestRestaurants" Context="restaurant">
                    <RestaurantCard Restaurant="@restaurant" />
                </HorizontalCarousel>
            </section>
        }

        @if (_data.MostReviewedDishes.Any())
        {
            <section class="mb-5">
                <SectionHeader Title="Najczęściej oceniane" Icon="fa-solid fa-comments text-success" />
                <HorizontalCarousel Items="@_data.MostReviewedDishes" Context="dish">
                    <DishCard Dish="@dish" />
                </HorizontalCarousel>
            </section>
        }

        @if (_data.RecentReviews.Any())
        {
            <section class="mb-5">
                <SectionHeader Title="Najnowsze opinie" Icon="fa-solid fa-comments" />
                <HorizontalCarousel Items="@_data.RecentReviews" Context="review">
                    <ReviewCard Review="@review" Compact="true" />
                </HorizontalCarousel>
            </section>
        }
    </div>
}

@code {
    private Models.HomeDataDto? _data;
    private RecommendationsDto? _recs;
    private bool _loading = true;
    private string _searchQuery = "";

    private string _heroImage = "/images/restaurant-placeholder.svg";
    private string? _heroBlurHash;
    private string? _heroCreditText;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var isAuthed = auth.User.Identity?.IsAuthenticated == true;

        var homeTask = HomeService.GetHomeDataAsync();
        var recsTask = isAuthed
            ? RecommendationService.GetRecommendationsAsync()
            : Task.FromResult<RecommendationsDto?>(null);

        await Task.WhenAll(homeTask, recsTask);

        _data = await homeTask;
        _recs = await recsTask;

        if (_data?.HeroImage != null)
        {
            _heroImage = _data.HeroImage.Url;
            _heroBlurHash = _data.HeroImage.Blurhash;
            _heroCreditText = _data.HeroImage.CreditText;
        }
        _loading = false;
    }

    private void DoSearch()
    {
        if (!string.IsNullOrWhiteSpace(_searchQuery))
            Navigation.NavigateTo($"/search?query={Uri.EscapeDataString(_searchQuery)}&type=dishes");
    }

}
