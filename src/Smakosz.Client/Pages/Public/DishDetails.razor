@page "/dishes/{Slug}"
@inject IDishService DishService
@inject IReviewService ReviewService
@inject IUserProfileService UserProfileService

<PageTitle>@(_dish?.DishName ?? "Danie") - Smakosz</PageTitle>

@if (_loading)
{
    <LoadingSpinner Text="Ładowanie dania..." />
}
else if (_dish == null)
{
    <div class="container mt-5">
        <EmptyState Icon="fa-solid fa-bowl-food" Title="Nie znaleziono dania" ActionText="Strona główna" ActionUrl="/" />
    </div>
}
else
{
    <div class="container mt-4">
        <div class="row">
            <div class="col-lg-8">
                <div class="mb-4">
                    <img src="@Helpers.ImageHelper.GetDishImage(_dish.ImageUrl)" alt="@_dish.DishName"
                         class="img-fluid rounded-3 w-100" style="max-height:450px;object-fit:cover;" />
                </div>

                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h1 class="mb-1">@_dish.DishName</h1>
                        @if (_dish.RestaurantName != null)
                        {
                            <a href="/restaurants/@_dish.RestaurantSlug" class="text-decoration-none" style="color:var(--accent-color);">
                                <i class="fa-solid fa-store me-1"></i>@_dish.RestaurantName
                            </a>
                        }
                    </div>
                    <AuthorizeView>
                        <Authorized>
                            <SaveDishButton IsSaved="@_dish.IsSaved" OnToggle="ToggleSaveDish" />
                        </Authorized>
                    </AuthorizeView>
                </div>

                <div class="d-flex flex-wrap gap-3 mb-4 align-items-center">
                    @if (_dish.AvgRating.HasValue)
                    {
                        <div>
                            <RatingStars Rating="@_dish.AvgRating.Value" Size="lg" ShowValue="true" />
                            <small class="text-muted ms-1">(@_dish.ReviewCount recenzji)</small>
                        </div>
                    }
                    @if (_dish.Price.HasValue)
                    {
                        <span class="fs-4 fw-bold" style="color:var(--accent-color);">@_dish.Price.Value.ToString("F2") zł</span>
                    }
                </div>

                @if (_dish.Tags.Any(t => t.Category != "dietary" && t.Category != "spice"))
                {
                    <div class="dish-tags mt-1 d-flex flex-wrap gap-1">
                        @foreach (var tag in _dish.Tags.Where(t => t.Category != "dietary" && t.Category != "spice"))
                        {
                            <a href="/search?type=dishes&tags=@Uri.EscapeDataString(tag.TagName)"
                               class="badge text-decoration-none"
                               style="background-color:@(tag.DisplayColor ?? "#6c757d");color:#fff;cursor:pointer;">
                                @tag.TagName
                            </a>
                        }
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_dish.Description))
                {
                    <div class="mt-4">
                        <h5>Opis</h5>
                        <p>@_dish.Description</p>
                    </div>
                }

                @if (_dish.Calories.HasValue)
                {
                    <div class="mt-3">
                        <small class="text-muted"><i class="fa-solid fa-fire me-1"></i>@_dish.Calories kcal</small>
                    </div>
                }

                @if (_dish.Ingredients?.Any() == true)
                {
                    <IngredientList Ingredients="@_dish.Ingredients" />
                }
            </div>

            <div class="col-lg-4">
                <div class="dish-details-panel">
                    <h5 class="mb-3">Informacje</h5>
                    @if (_dish.RestaurantName != null)
                    {
                        <div class="mb-3">
                            <small class="text-muted d-block">Restauracja</small>
                            <a href="/restaurants/@_dish.RestaurantSlug" class="fw-bold text-decoration-none" style="color:var(--accent-color);">
                                @_dish.RestaurantName
                            </a>
                        </div>
                    }
                    @if (_dish.CuisineType != null)
                    {
                        <div class="mb-3">
                            <small class="text-muted d-block">Kuchnia</small>
                            <span>@_dish.CuisineType</span>
                        </div>
                    }
                    @if (_dish.CityName != null)
                    {
                        <div class="mb-3">
                            <small class="text-muted d-block">Miasto</small>
                            <span><i class="fa-solid fa-location-dot me-1"></i>@_dish.CityName</span>
                        </div>
                    }
                    @if (!_dish.IsVegetarian)
                    {
                        <div class="mb-3">
                            <small class="text-muted d-block">Dieta</small>
                            <span><i class="fa-solid fa-drumstick-bite me-1"></i>Zawiera mięso</span>
                        </div>
                    }
                    <DietaryBadges IsVegan="@_dish.IsVegan" IsVegetarian="@_dish.IsVegetarian"
                                   IsGlutenFree="@_dish.IsGlutenFree" IsLactoseFree="@_dish.IsLactoseFree"
                                   IsSpicy="@_dish.IsSpicy" />
                    @if (!_dish.IsAvailable)
                    {
                        <div class="alert alert-warning small">
                            <i class="fa-solid fa-circle-exclamation me-1"></i>To danie jest aktualnie niedostępne.
                        </div>
                    }
                    <ShareButton Url="@Navigation.Uri" Title="@_dish.DishName" />
                    <div class="mt-3">
                        <button class="btn btn-outline-primary w-100" @onclick="GetRandomDish">
                            <i class="fa-solid fa-shuffle me-1"></i>Nowe losowe danie
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-8">
                <div class="mt-5">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <SectionHeader Title="Recenzje" Icon="fa-solid fa-comments" />
                        <div class="d-flex align-items-center gap-2">
                            @if (_reviews != null && _reviews.Data.Any())
                            {
                                <SortDropdown CurrentSort="@_sortBy" Options="@_reviewSortOptions" OnSortChange="ChangeReviewSort" />
                            }
                            <AuthorizeView Roles="User">
                                <Authorized>
                                    <a href="/review/add?dish=@Slug" class="btn btn-primary btn-sm">
                                        <i class="fa-solid fa-pen me-1"></i>Ocen to danie
                                    </a>
                                </Authorized>
                            </AuthorizeView>
                        </div>
                    </div>

                    @if (_reviews != null && _reviews.Data.Any())
                    {
                        @foreach (var review in _reviews.Data)
                        {
                            <ReviewCard Review="@review" ShowDish="false" ShowActions="true" />
                        }
                        <Pagination Info="@_reviews.Pagination" OnPageChange="LoadReviewPage" />
                    }
                    else
                    {
                        <EmptyState Icon="fa-solid fa-comments" Title="Brak recenzji"
                                    Description="Bądź pierwszym, który oceni to danie!" />
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = default!;
    @inject NavigationManager Navigation

    private Models.DishDetailDto? _dish;
    private Models.PagedResult<Models.ReviewCardDto>? _reviews;
    private bool _loading = true;
    private string _sortBy = "newest";

    private static readonly List<Components.SortOption> _reviewSortOptions = new()
    {
        new() { Label = "Najnowsze", Value = "newest" },
        new() { Label = "Najstarsze", Value = "oldest" },
        new() { Label = "Najpopularniejsze", Value = "helpful" },
        new() { Label = "Najlepsze", Value = "rating_desc" },
        new() { Label = "Najgorsze", Value = "rating_asc" }
    };

    private string? _lastSlug;

    protected override async Task OnParametersSetAsync()
    {
        if (Slug == _lastSlug) return;
        _lastSlug = Slug;

        _loading = true;
        _dish = await DishService.GetBySlugAsync(Slug);
        if (_dish != null)
            _reviews = await ReviewService.GetByDishAsync(Slug, 1, 10, _sortBy);
        _loading = false;
    }

    private async Task LoadReviewPage(int page)
    {
        _reviews = await ReviewService.GetByDishAsync(Slug, page, 10, _sortBy);
    }

    private async Task ChangeReviewSort(string sort)
    {
        _sortBy = sort;
        _reviews = await ReviewService.GetByDishAsync(Slug, 1, 10, _sortBy);
    }

    private async Task GetRandomDish()
    {
        var dish = await DishService.GetRandomAsync();
        if (dish != null)
            Navigation.NavigateTo($"/dishes/{dish.Slug}");
    }

    private async Task ToggleSaveDish()
    {
        if (_dish == null) return;
        bool success;
        if (_dish.IsSaved)
            success = await UserProfileService.UnsaveDishAsync(Slug);
        else
            success = await UserProfileService.SaveDishAsync(Slug);

        if (success)
            _dish.IsSaved = !_dish.IsSaved;
    }
}
