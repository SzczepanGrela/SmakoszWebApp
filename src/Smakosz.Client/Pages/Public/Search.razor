@page "/search"
@inject ISearchService SearchService
@inject NavigationManager Navigation
@inject Smakosz.Client.Services.IPublicConfigService Config

<PageTitle>@(_type == "restaurants" ? "Restauracje" : "Szukaj") - Smakosz</PageTitle>

<div class="container mt-4">
    <h1 class="mb-4">
        @if (_type == "restaurants")
        {
            <i class="fa-solid fa-store me-2"></i>@("Restauracje")
        }
        else
        {
            <i class="fa-solid fa-magnifying-glass me-2"></i>@("Szukaj")
        }
    </h1>

    <div class="row mb-4">
        <div class="col-md-8">
            <div class="input-group">
                <SearchAutocomplete @bind-Value="_query"
                                    OnSearch="_ => DoSearch()"
                                    CssClass="form-control"
                                    Placeholder="Szukaj dan lub restauracji..." />
                <button class="btn btn-primary" @onclick="DoSearch">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
            </div>
        </div>
        <div class="col-md-4 d-flex align-items-center gap-2 mt-2 mt-md-0 search-controls">
            <SearchTypeSlider ActiveType="@_type" OnTypeChange="ChangeType" />
            <SortDropdown CurrentSort="@_sortBy" Options="@_sortOptions" OnSortChange="ChangeSort" />
        </div>
    </div>

    <div class="d-lg-none mb-3">
        <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="offcanvas" data-bs-target="#filterDrawer">
            <i class="fa-solid fa-filter me-1"></i>Filtry
            @if (TotalActiveFilterCount > 0)
            {
                <span class="badge bg-warning text-dark ms-1">@TotalActiveFilterCount</span>
            }
        </button>
    </div>

    <div class="row">
        <div class="col-lg-3 mb-4 d-none d-lg-block">
            <FilterPanel TotalActiveCount="@TotalActiveFilterCount"
                         OnApply="DoSearch"
                         OnClearAll="ClearFilters"
                         IsDirty="@_isDirty"
                         IsMobile="false">
                @SectionsContent
            </FilterPanel>
        </div>

        <FilterPanel TotalActiveCount="@TotalActiveFilterCount"
                     OnApply="DoSearch"
                     OnClearAll="ClearFilters"
                     IsDirty="@_isDirty"
                     IsMobile="true">
            @SectionsContent
        </FilterPanel>

        <div class="col-12 col-lg-9">
            @{
                var activeChips = BuildActiveFilters();
            }
            @if (activeChips.Any())
            {
                <div class="results-chips-bar mb-3">
                    @foreach (var filter in activeChips)
                    {
                        <FilterChip Label="@filter.Label" OnRemove="() => RemoveFilter(filter)" />
                    }
                    <button type="button" class="results-chips-clear-btn" @onclick="ClearFilters">
                        <i class="fa-solid fa-xmark me-1"></i>Wyczyść (@TotalActiveFilterCount)
                    </button>
                </div>
            }
            @if (_loading)
            {
                <LoadingSpinner />
            }
            else if (_result == null || (!_result.Restaurants.Any() && !_result.Dishes.Any()))
            {
                <EmptyState Icon="fa-solid fa-magnifying-glass" Title="Brak wyników"
                            Description="Spróbuj zmienić kryteria wyszukiwania." />
            }
            else
            {
                @if (_type == "restaurants" && _result.Restaurants.Any())
                {
                    <div class="row">
                        @foreach (var r in _result.Restaurants)
                        {
                            <div class="col-md-6 mb-4">
                                <RestaurantCard Restaurant="@r" />
                            </div>
                        }
                    </div>
                }

                @if (_type == "dishes" && _result.Dishes.Any())
                {
                    <div class="row">
                        @foreach (var d in _result.Dishes)
                        {
                            <div class="col-md-6 col-lg-4 mb-4">
                                <DishCard Dish="@d" />
                            </div>
                        }
                    </div>
                }

                <Pagination Info="@_result.Pagination" OnPageChange="GoToPage" />
            }
        </div>
    </div>
</div>

@code {
    private RenderFragment SectionsContent => __builder =>
    {
        <FilterSection Title="Kuchnia" ActiveCount="@_selectedCuisines.Count">
            @foreach (var cuisine in _cuisineOptions)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" checked="@_selectedCuisines.Contains(cuisine.Value)"
                           @onchange="e => ToggleCuisine(cuisine.Value, (bool)e.Value!)" />
                    <label class="form-check-label small">@cuisine.Label</label>
                </div>
            }
        </FilterSection>
        <FilterSection Title="Dieta" ActiveCount="@_selectedDietary.Count">
            @foreach (var diet in _dietaryOptions)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" checked="@_selectedDietary.Contains(diet.Value)"
                           @onchange="e => ToggleDietary(diet.Value, (bool)e.Value!)" />
                    <label class="form-check-label small">@diet.Label</label>
                </div>
            }
        </FilterSection>
        @if (_type is "dishes" or "all" && _dishCategoryOptions.Any())
        {
            <FilterSection Title="Kategoria dania" ActiveCount="@_selectedDishCategories.Count">
                @foreach (var cat in _dishCategoryOptions)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" checked="@_selectedDishCategories.Contains(cat.Value)"
                               @onchange="e => ToggleDishCategory(cat.Value, (bool)e.Value!)" />
                        <label class="form-check-label small">@cat.Label</label>
                    </div>
                }
            </FilterSection>
        }
        @if (_type is "dishes" or "all" && _spiceLevelOptions.Any())
        {
            <FilterSection Title="Ostrość" ActiveCount="@_selectedSpiceLevels.Count">
                @foreach (var level in _spiceLevelOptions)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" checked="@_selectedSpiceLevels.Contains(level.Value)"
                               @onchange="e => ToggleSpiceLevel(level.Value, (bool)e.Value!)" />
                        <label class="form-check-label small">@level.Label</label>
                    </div>
                }
            </FilterSection>
        }
        @if (_type is "dishes" or "all" && _moodOptions.Any())
        {
            <FilterSection Title="Klimat" ActiveCount="@_selectedMoods.Count">
                @foreach (var mood in _moodOptions)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" checked="@_selectedMoods.Contains(mood.Value)"
                               @onchange="e => ToggleMood(mood.Value, (bool)e.Value!)" />
                        <label class="form-check-label small">@mood.Label</label>
                    </div>
                }
            </FilterSection>
        }
        @if (_type is "dishes" or "all" && _occasionOptions.Any())
        {
            <FilterSection Title="Pora dnia" ActiveCount="@_selectedOccasions.Count">
                @foreach (var occ in _occasionOptions)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" checked="@_selectedOccasions.Contains(occ.Value)"
                                   @onchange="e => ToggleOccasion(occ.Value, (bool)e.Value!)" />
                        <label class="form-check-label small">@occ.Label</label>
                    </div>
                }
            </FilterSection>
        }
        @if (_type is "dishes" or "all" && _featureOptions.Any())
        {
            <FilterSection Title="Cechy" ActiveCount="@_selectedFeatures.Count">
                @foreach (var feat in _featureOptions)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" checked="@_selectedFeatures.Contains(feat.Value)"
                               @onchange="e => ToggleFeature(feat.Value, (bool)e.Value!)" />
                        <label class="form-check-label small">@feat.Label</label>
                    </div>
                }
            </FilterSection>
        }
        @if (_cities.Any())
        {
            <FilterSection Title="Miasto" ActiveCount="@(string.IsNullOrEmpty(_selectedCity) ? 0 : 1)">
                <select class="form-select form-select-sm" @bind="_selectedCity" @bind:after="() => _isDirty = true">
                    <option value="">Wszystkie</option>
                    @foreach (var city in _cities)
                    {
                        <option value="@city">@city</option>
                    }
                </select>
            </FilterSection>
        }
    };

    private int TotalActiveFilterCount =>
        _selectedCuisines.Count + _selectedDietary.Count + _selectedDishCategories.Count
        + _selectedFeatures.Count + _selectedMoods.Count + _selectedOccasions.Count
        + _selectedSpiceLevels.Count + (string.IsNullOrEmpty(_selectedCity) ? 0 : 1);

    private List<ActiveFilterDto> BuildActiveFilters()
    {
        var list = new List<ActiveFilterDto>();
        foreach (var v in _selectedCuisines)
            list.Add(new("cuisines", v, _cuisineOptions.FirstOrDefault(o => o.Value == v)?.Label ?? v));
        foreach (var v in _selectedDietary)
            list.Add(new("dietary", v, _dietaryOptions.FirstOrDefault(o => o.Value == v)?.Label ?? v));
        foreach (var v in _selectedDishCategories)
            list.Add(new("dishCategories", v, _dishCategoryOptions.FirstOrDefault(o => o.Value == v)?.Label ?? v));
        foreach (var v in _selectedFeatures)
            list.Add(new("features", v, _featureOptions.FirstOrDefault(o => o.Value == v)?.Label ?? v));
        foreach (var v in _selectedMoods)
            list.Add(new("moods", v, _moodOptions.FirstOrDefault(o => o.Value == v)?.Label ?? v));
        foreach (var v in _selectedOccasions)
            list.Add(new("occasions", v, _occasionOptions.FirstOrDefault(o => o.Value == v)?.Label ?? v));
        foreach (var v in _selectedSpiceLevels)
            list.Add(new("spiceLevels", v, _spiceLevelOptions.FirstOrDefault(o => o.Value == v)?.Label ?? v));
        if (!string.IsNullOrEmpty(_selectedCity))
            list.Add(new("city", _selectedCity, _selectedCity));
        return list;
    }

    private void RemoveFilter(ActiveFilterDto filter)
    {
        switch (filter.Category)
        {
            case "cuisines": _selectedCuisines.Remove(filter.Value); break;
            case "dietary": _selectedDietary.Remove(filter.Value); break;
            case "dishCategories": _selectedDishCategories.Remove(filter.Value); break;
            case "features": _selectedFeatures.Remove(filter.Value); break;
            case "moods": _selectedMoods.Remove(filter.Value); break;
            case "occasions": _selectedOccasions.Remove(filter.Value); break;
            case "spiceLevels": _selectedSpiceLevels.Remove(filter.Value); break;
            case "city": _selectedCity = ""; break;
        }
        _isDirty = true;
    }

    [SupplyParameterFromQuery] public string? Query { get; set; }
    [SupplyParameterFromQuery] public string? Type { get; set; }
    [SupplyParameterFromQuery] public string? Cuisines { get; set; }
    [SupplyParameterFromQuery] public string? Dietary { get; set; }
    [SupplyParameterFromQuery] public string? City { get; set; }
    [SupplyParameterFromQuery] public string? Sort { get; set; }
    [SupplyParameterFromQuery] public string? Tags { get; set; }
    [SupplyParameterFromQuery(Name = "dishCategories")] public string? DishCategoriesParam { get; set; }
    [SupplyParameterFromQuery] public string? Features { get; set; }
    [SupplyParameterFromQuery] public string? Moods { get; set; }
    [SupplyParameterFromQuery] public string? Occasions { get; set; }
    [SupplyParameterFromQuery(Name = "spiceLevels")] public string? SpiceLevelsParam { get; set; }
    [SupplyParameterFromQuery] public int Page { get; set; } = 1;

    private SearchResultDto? _result;
    private bool _loading = true;
    private bool _isDirty;
    private string _query = "";
    private string _type = "dishes";
    private string _sortBy = "rating";
    private int _page = 1;
    private string _selectedCity = "";
    private readonly HashSet<string> _selectedCuisines = [];
    private readonly HashSet<string> _selectedDietary = [];
    private readonly HashSet<string> _selectedDishCategories = [];
    private readonly HashSet<string> _selectedFeatures = [];
    private readonly HashSet<string> _selectedMoods = [];
    private readonly HashSet<string> _selectedOccasions = [];
    private readonly HashSet<string> _selectedSpiceLevels = [];
    private string? _selectedTags;

    private List<FilterOption> _cuisineOptions = [];
    private List<FilterOption> _dietaryOptions = [];
    private List<FilterOption> _dishCategoryOptions = [];
    private List<FilterOption> _featureOptions = [];
    private List<FilterOption> _moodOptions = [];
    private List<FilterOption> _occasionOptions = [];
    private List<FilterOption> _spiceLevelOptions = [];
    private List<string> _cities = [];

    private static readonly FilterOption[] _fallbackCuisines =
    {
        new() { Value = "Polska", Label = "Polska" }, new() { Value = "Włoska", Label = "Włoska" },
        new() { Value = "Azjatycka", Label = "Azjatycka" }, new() { Value = "Amerykanska", Label = "Amerykańska" },
        new() { Value = "Meksykanska", Label = "Meksykańska" }, new() { Value = "Francuska", Label = "Francuska" }
    };
    private static readonly FilterOption[] _fallbackDietary =
    {
        new() { Value = "vegetarian", Label = "Wegetariańskie" }, new() { Value = "vegan", Label = "Wegańskie" },
        new() { Value = "gluten_free", Label = "Bezglutenowe" }, new() { Value = "lactose_free", Label = "Bezlaktozowe" }
    };

    private static readonly List<SortOption> _sortOptions = new()
    {
        new() { Label = "Ocena", Value = "rating" },
        new() { Label = "Nazwa A-Z", Value = "name_asc" },
        new() { Label = "Nazwa Z-A", Value = "name_desc" },
        new() { Label = "Cena rosnąco", Value = "price_asc" },
        new() { Label = "Cena malejąco", Value = "price_desc" },
        new() { Label = "Popularność", Value = "trending" }
    };

    private (string SortBy, string SortDir) ParseSort(string sort) => sort switch
    {
        "name_asc" => ("name", "asc"),
        "name_desc" => ("name", "desc"),
        "price_asc" => ("price", "asc"),
        "price_desc" => ("price", "desc"),
        "trending" => ("trending", "desc"),
        _ => ("rating", "desc")
    };

    protected override async Task OnInitializedAsync()
    {
        _query = Query ?? "";
        _type = Type ?? "dishes";
        _page = Page > 0 ? Page : 1;
        _sortBy = Sort ?? "rating";
        _selectedCity = City ?? "";

        if (!string.IsNullOrWhiteSpace(Cuisines))
        {
            foreach (var c in Cuisines.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                _selectedCuisines.Add(c);
        }

        if (!string.IsNullOrWhiteSpace(Dietary))
        {
            foreach (var d in Dietary.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                _selectedDietary.Add(d);
        }

        if (!string.IsNullOrWhiteSpace(Tags))
            _selectedTags = Tags;

        if (!string.IsNullOrWhiteSpace(DishCategoriesParam))
        {
            foreach (var c in DishCategoriesParam.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                _selectedDishCategories.Add(c);
        }

        PopulateSet(Features, _selectedFeatures);
        PopulateSet(Moods, _selectedMoods);
        PopulateSet(Occasions, _selectedOccasions);
        PopulateSet(SpiceLevelsParam, _selectedSpiceLevels);

        var filtersTask = SearchService.GetFiltersAsync();
        var resultsTask = LoadResults();

        var filters = await filtersTask;
        if (filters != null)
        {
            _cuisineOptions = filters.Cuisines.Any() ? filters.Cuisines : [.. _fallbackCuisines];
            _dietaryOptions = filters.DietaryOptions.Any() ? filters.DietaryOptions : [.. _fallbackDietary];
            _dishCategoryOptions = filters.DishCategories;
            _featureOptions = filters.Features;
            _moodOptions = filters.Moods;
            _occasionOptions = filters.Occasions;
            _spiceLevelOptions = filters.SpiceLevels;
            _cities = filters.Cities;
        }
        else
        {
            _cuisineOptions = [.. _fallbackCuisines];
            _dietaryOptions = [.. _fallbackDietary];
        }

        await resultsTask;
    }

    private async Task LoadResults()
    {
        _loading = true;
        var cuisines = _selectedCuisines.Any() ? string.Join(",", _selectedCuisines) : null;
        var dietary = _selectedDietary.Any() ? string.Join(",", _selectedDietary) : null;
        var location = !string.IsNullOrEmpty(_selectedCity) ? _selectedCity : null;
        var dishesSize = await Config.GetIntAsync("search.dishes_page_size", 6);
        var restSize = await Config.GetIntAsync("search.restaurants_page_size", 12);
        var pageSize = _type == "dishes" ? dishesSize : restSize;
        var tags = !string.IsNullOrWhiteSpace(_selectedTags) ? _selectedTags : null;
        var dishCategories = _selectedDishCategories.Any() ? string.Join(",", _selectedDishCategories) : null;
        var features = _selectedFeatures.Any() ? string.Join(",", _selectedFeatures) : null;
        var moods = _selectedMoods.Any() ? string.Join(",", _selectedMoods) : null;
        var occasions = _selectedOccasions.Any() ? string.Join(",", _selectedOccasions) : null;
        var spiceLevels = _selectedSpiceLevels.Any() ? string.Join(",", _selectedSpiceLevels) : null;
        var (sortBy, sortDir) = ParseSort(_sortBy);
        _result = await SearchService.SearchAsync(_type, _query, location, cuisines, null, null, dietary, sortBy, sortDir, _page, pageSize,
            tags: tags, dishCategories: dishCategories,
            features: features, moods: moods, occasions: occasions, spiceLevels: spiceLevels);
        _loading = false;
        _isDirty = false;
    }

    private async Task DoSearch()
    {
        _page = 1;
        await LoadResults();
        UpdateUrl();
    }

    private async Task ChangeType(string type) { _type = type; _page = 1; await LoadResults(); UpdateUrl(); }
    private async Task ChangeSort(string sort) { _sortBy = sort; _page = 1; await LoadResults(); UpdateUrl(); }
    private async Task GoToPage(int page) { _page = page; await LoadResults(); UpdateUrl(); }

    private void ToggleCuisine(string c, bool v) { if (v) _selectedCuisines.Add(c); else _selectedCuisines.Remove(c); _isDirty = true; }
    private void ToggleDietary(string d, bool v) { if (v) _selectedDietary.Add(d); else _selectedDietary.Remove(d); _isDirty = true; }
    private void ToggleDishCategory(string c, bool v) { if (v) _selectedDishCategories.Add(c); else _selectedDishCategories.Remove(c); _isDirty = true; }
    private void ToggleFeature(string c, bool v) { if (v) _selectedFeatures.Add(c); else _selectedFeatures.Remove(c); _isDirty = true; }
    private void ToggleMood(string c, bool v) { if (v) _selectedMoods.Add(c); else _selectedMoods.Remove(c); _isDirty = true; }
    private void ToggleOccasion(string c, bool v) { if (v) _selectedOccasions.Add(c); else _selectedOccasions.Remove(c); _isDirty = true; }
    private void ToggleSpiceLevel(string c, bool v) { if (v) _selectedSpiceLevels.Add(c); else _selectedSpiceLevels.Remove(c); _isDirty = true; }

    private static void PopulateSet(string? csv, HashSet<string> target)
    {
        if (string.IsNullOrWhiteSpace(csv)) return;
        foreach (var v in csv.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            target.Add(v);
    }

    private async Task ClearFilters()
    {
        _selectedCuisines.Clear();
        _selectedDietary.Clear();
        _selectedDishCategories.Clear();
        _selectedFeatures.Clear();
        _selectedMoods.Clear();
        _selectedOccasions.Clear();
        _selectedSpiceLevels.Clear();
        _selectedCity = "";
        _page = 1;
        await LoadResults();
        UpdateUrl();
    }

    private void UpdateUrl()
    {
        var url = $"/search?type={_type}&page={_page}";
        if (!string.IsNullOrWhiteSpace(_query)) url += $"&query={Uri.EscapeDataString(_query)}";
        if (_selectedCuisines.Any()) url += $"&cuisines={Uri.EscapeDataString(string.Join(",", _selectedCuisines))}";
        if (_selectedDietary.Any()) url += $"&dietary={Uri.EscapeDataString(string.Join(",", _selectedDietary))}";
        if (!string.IsNullOrEmpty(_selectedCity)) url += $"&city={Uri.EscapeDataString(_selectedCity)}";
        if (_sortBy != "rating") url += $"&sort={_sortBy}";
        if (!string.IsNullOrWhiteSpace(_selectedTags)) url += $"&tags={Uri.EscapeDataString(_selectedTags)}";
        if (_selectedDishCategories.Any()) url += $"&dishCategories={Uri.EscapeDataString(string.Join(",", _selectedDishCategories))}";
        if (_selectedFeatures.Any()) url += $"&features={Uri.EscapeDataString(string.Join(",", _selectedFeatures))}";
        if (_selectedMoods.Any()) url += $"&moods={Uri.EscapeDataString(string.Join(",", _selectedMoods))}";
        if (_selectedOccasions.Any()) url += $"&occasions={Uri.EscapeDataString(string.Join(",", _selectedOccasions))}";
        if (_selectedSpiceLevels.Any()) url += $"&spiceLevels={Uri.EscapeDataString(string.Join(",", _selectedSpiceLevels))}";
        Navigation.NavigateTo(url, replace: true);
    }
}
