@page "/restaurant/{Slug}"
@inject IRestaurantService RestaurantService
@inject IUserProfileService UserProfileService
@inject ToastService Toast

<PageTitle>@(_restaurant?.RestaurantName ?? "Restauracja") - Smakosz</PageTitle>

@if (_loading)
{
    <LoadingSpinner Text="Ładowanie restauracji..." />
}
else if (_restaurant == null)
{
    <div class="container mt-5">
        <EmptyState Icon="fa-solid fa-store" Title="Nie znaleziono restauracji" ActionText="Strona główna" ActionUrl="/" />
    </div>
}
else
{
    <!-- Restaurant Hero -->
    <div class="restaurant-header position-relative"
         style="background-image:url('@Helpers.ImageHelper.GetRestaurantImage(_restaurant.ImageUrl)');">
        <div style="position:absolute;inset:0;background:linear-gradient(rgba(0,0,0,0.5),rgba(0,0,0,0.7));"></div>
        <div class="container position-relative z-index-1 text-white text-center">
            <h1 class="display-5 fw-bold">@_restaurant.RestaurantName</h1>
            <div class="d-flex justify-content-center gap-3 mt-3 flex-wrap">
                @if (_restaurant.CuisineType != null)
                {
                    <span><i class="fa-solid fa-utensils me-1"></i>@_restaurant.CuisineType</span>
                }
                @if (_restaurant.CityName != null)
                {
                    <span><i class="fa-solid fa-location-dot me-1"></i>@_restaurant.CityName</span>
                }
                @if (_restaurant.PriceLevel.HasValue)
                {
                    <span>@(new string('$', _restaurant.PriceLevel.Value))</span>
                }
                @if (_restaurant.IsVerified)
                {
                    <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i>Zweryfikowana</span>
                }
            </div>
        </div>
    </div>

    <div class="container mt-4">
        <div class="row">
            <!-- Main content -->
            <div class="col-lg-8">
                <!-- Ratings Breakdown -->
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="mb-3">Oceny</h5>
                        <div class="row">
                            <div class="col-6 col-md-3 text-center mb-3">
                                <div class="fs-3 fw-bold" style="color:var(--accent-color);">@FormatScore(_restaurant.AvgFoodScore)</div>
                                <small class="text-muted">Jedzenie</small>
                            </div>
                            <div class="col-6 col-md-3 text-center mb-3">
                                <div class="fs-3 fw-bold" style="color:var(--accent-color);">@FormatScore(_restaurant.AvgService)</div>
                                <small class="text-muted">Obsługa</small>
                            </div>
                            <div class="col-6 col-md-3 text-center mb-3">
                                <div class="fs-3 fw-bold" style="color:var(--accent-color);">@FormatScore(_restaurant.AvgCleanliness)</div>
                                <small class="text-muted">Czystość</small>
                            </div>
                            <div class="col-6 col-md-3 text-center mb-3">
                                <div class="fs-3 fw-bold" style="color:var(--accent-color);">@FormatScore(_restaurant.AvgAmbiance)</div>
                                <small class="text-muted">Atmosfera</small>
                            </div>
                        </div>
                        <div class="text-center">
                            <small class="text-muted">Na podstawie @_restaurant.ReviewCount recenzji</small>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_restaurant.Description))
                {
                    <div class="mb-4">
                        <h5>O restauracji</h5>
                        <p>@_restaurant.Description</p>
                    </div>
                }

                <!-- Menu Sections & Dishes -->
                <div class="mb-4">
                    <SectionHeader Title="Menu" Icon="fa-solid fa-bars" />

                    @if (_dishes != null && _dishes.Data.Any())
                    {
                        @if (_restaurant.MenuSections.Any())
                        {
                            @foreach (var menuSec in _restaurant.MenuSections.OrderBy(s => s.DisplayOrder))
                            {
                                <h6 class="mt-3 mb-2 fw-bold">@menuSec.SectionName</h6>
                                <div class="row">
                                    @foreach (var dish in _dishes.Data)
                                    {
                                        <div class="col-md-6 col-lg-4 mb-3">
                                            <DishCard Dish="@dish" Size="small" />
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="row">
                                @foreach (var dish in _dishes.Data)
                                {
                                    <div class="col-md-6 col-lg-4 mb-3">
                                        <DishCard Dish="@dish" />
                                    </div>
                                }
                            </div>
                        }

                        @if (_dishes.Pagination.TotalPages > 1)
                        {
                            <Pagination Info="@_dishes.Pagination" OnPageChange="LoadDishPage" />
                        }
                    }
                    else
                    {
                        <EmptyState Icon="fa-solid fa-bowl-food" Title="Brak dań w menu" />
                    }
                </div>
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4">
                <div class="dish-details-panel mb-4">
                    <h5 class="mb-3">Informacje kontaktowe</h5>
                    @if (_restaurant.Address != null)
                    {
                        <div class="mb-2">
                            <i class="fa-solid fa-location-dot me-2"></i>@_restaurant.Address
                        </div>
                    }
                    @if (_restaurant.Phone != null)
                    {
                        <div class="mb-2">
                            <i class="fa-solid fa-phone me-2"></i>
                            <a href="tel:@_restaurant.Phone">@_restaurant.Phone</a>
                        </div>
                    }
                    @if (_restaurant.Email != null)
                    {
                        <div class="mb-2">
                            <i class="fa-solid fa-envelope me-2"></i>@_restaurant.Email
                        </div>
                    }
                    @if (_restaurant.Website != null)
                    {
                        <div class="mb-2">
                            <i class="fa-solid fa-globe me-2"></i>
                            <a href="@_restaurant.Website" target="_blank">Strona www</a>
                        </div>
                    }
                    <div class="d-flex gap-2 mt-3">
                        <AuthorizeView>
                            <Authorized>
                                <FavoriteButton IsFavorite="@_restaurant.IsFavorite" OnToggle="ToggleFavorite" />
                            </Authorized>
                        </AuthorizeView>
                        <ShareButton Url="@Navigation.Uri" Title="@_restaurant.RestaurantName" />
                    </div>
                </div>

                <!-- User Actions -->
                <AuthorizeView>
                    <Authorized>
                        <div class="dish-details-panel mb-4">
                            <h5 class="mb-3"><i class="fa-solid fa-comment-dots me-2"></i>Akcje</h5>
                            <div class="d-grid gap-2">
                                <button class="btn btn-outline-primary btn-sm" @onclick="() => _showCorrectionModal = true">
                                    <i class="fa-solid fa-pen-to-square me-1"></i>Zaproponuj poprawkę
                                </button>
                                <AuthorizeView Roles="Restaurant,Admin" Context="roleCtx">
                                    <Authorized>
                                        <button class="btn btn-outline-primary btn-sm" @onclick="() => _showIngredientModal = true">
                                            <i class="fa-solid fa-seedling me-1"></i>Zaproponuj składnik
                                        </button>
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                        </div>
                    </Authorized>
                </AuthorizeView>

                <!-- Opening Hours -->
                @if (_restaurant.OpeningHours.Any())
                {
                    <div class="dish-details-panel">
                        <h5 class="mb-3"><i class="fa-solid fa-clock me-2"></i>Godziny otwarcia</h5>
                        @foreach (var hours in _restaurant.OpeningHours.OrderBy(h => h.DayOfWeek))
                        {
                            <div class="d-flex justify-content-between small mb-1">
                                <span>@DayName(hours.DayOfWeek)</span>
                                <span>@(hours.IsClosed ? "Zamknięte" : $"{FormatTime(hours.OpenTime)} - {FormatTime(hours.CloseTime)}")</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

@* Data Correction Modal *@
@if (_showCorrectionModal)
{
    <Modal IsOpen="true" Title="Zaproponuj poprawkę danych" OnClose="() => _showCorrectionModal = false">
        <div class="mb-3">
            <label class="form-label">Typ problemu *</label>
            <select class="form-select" @bind="_correctionIssueType">
                <option value="">-- Wybierz --</option>
                <option value="Hours">Godziny otwarcia</option>
                <option value="Address">Adres</option>
                <option value="Phone">Telefon</option>
                <option value="Menu">Menu</option>
                <option value="Other">Inne</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">Opis problemu</label>
            <textarea class="form-control" rows="3" @bind="_correctionDescription" placeholder="Opisz co jest nieprawidłowe..."></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label">Proponowana wartość</label>
            <textarea class="form-control" rows="2" @bind="_correctionProposedValue" placeholder="Jaka powinna być prawidłowa wartość?"></textarea>
        </div>
        <div class="d-flex justify-content-end gap-2">
            <button class="btn btn-outline-secondary btn-sm" @onclick="() => _showCorrectionModal = false">Anuluj</button>
            <button class="btn btn-primary btn-sm" @onclick="SubmitCorrection" disabled="@(string.IsNullOrWhiteSpace(_correctionIssueType) || _correctionSubmitting)">
                @if (_correctionSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                Wyślij
            </button>
        </div>
    </Modal>
}

@* Ingredient Suggestion Modal *@
@if (_showIngredientModal)
{
    <Modal IsOpen="true" Title="Zaproponuj składnik" OnClose="() => _showIngredientModal = false">
        <div class="mb-3">
            <label class="form-label">Nazwa składnika *</label>
            <input type="text" class="form-control" @bind="_ingredientName" placeholder="Np. Orzechy włoskie" />
        </div>
        <div class="mb-3">
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="isAllergen" @bind="_ingredientIsAllergen" />
                <label class="form-check-label" for="isAllergen">Alergen</label>
            </div>
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="isVegetarian" @bind="_ingredientIsVegetarian" />
                <label class="form-check-label" for="isVegetarian">Wegetariański</label>
            </div>
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="isVegan" @bind="_ingredientIsVegan" />
                <label class="form-check-label" for="isVegan">Wegański</label>
            </div>
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="isGlutenFree" @bind="_ingredientIsGlutenFree" />
                <label class="form-check-label" for="isGlutenFree">Bezglutenowy</label>
            </div>
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="isLactoseFree" @bind="_ingredientIsLactoseFree" />
                <label class="form-check-label" for="isLactoseFree">Bezlaktozowy</label>
            </div>
        </div>
        <div class="d-flex justify-content-end gap-2">
            <button class="btn btn-outline-secondary btn-sm" @onclick="() => _showIngredientModal = false">Anuluj</button>
            <button class="btn btn-primary btn-sm" @onclick="SubmitIngredientSuggestion" disabled="@(string.IsNullOrWhiteSpace(_ingredientName) || _ingredientSubmitting)">
                @if (_ingredientSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                Wyślij
            </button>
        </div>
    </Modal>
}

@code {
    [Parameter] public string Slug { get; set; } = default!;
    @inject NavigationManager Navigation

    private Models.RestaurantDetailDto? _restaurant;
    private Models.PagedResult<Models.DishCardDto>? _dishes;
    private bool _loading = true;

    private bool _showCorrectionModal;
    private string _correctionIssueType = "";
    private string? _correctionDescription;
    private string? _correctionProposedValue;
    private bool _correctionSubmitting;

    private bool _showIngredientModal;
    private string _ingredientName = "";
    private bool _ingredientIsAllergen;
    private bool _ingredientIsVegetarian = true;
    private bool _ingredientIsVegan = true;
    private bool _ingredientIsGlutenFree = true;
    private bool _ingredientIsLactoseFree = true;
    private bool _ingredientSubmitting;

    protected override async Task OnInitializedAsync()
    {
        _restaurant = await RestaurantService.GetBySlugAsync(Slug);
        if (_restaurant != null)
            _dishes = await RestaurantService.GetDishesAsync(Slug);
        _loading = false;
    }

    private async Task LoadDishPage(int page)
    {
        _dishes = await RestaurantService.GetDishesAsync(Slug, page);
    }

    private static string FormatScore(double? score) => score.HasValue ? score.Value.ToString("F1") : "-";

    private static string FormatTime(string time) => time.Length >= 5 ? time[..5] : time;

    private static string DayName(int day) => day switch
    {
        0 => "Niedziela", 1 => "Poniedziałek", 2 => "Wtorek", 3 => "Środa",
        4 => "Czwartek", 5 => "Piątek", 6 => "Sobota", _ => ""
    };

    private async Task ToggleFavorite()
    {
        if (_restaurant == null) return;
        bool success;
        if (_restaurant.IsFavorite)
            success = await UserProfileService.UnfavoriteRestaurantAsync(Slug);
        else
            success = await UserProfileService.FavoriteRestaurantAsync(Slug);

        if (success)
            _restaurant.IsFavorite = !_restaurant.IsFavorite;
    }

    private async Task SubmitCorrection()
    {
        if (string.IsNullOrWhiteSpace(_correctionIssueType)) return;

        _correctionSubmitting = true;
        var dto = new CreateDataCorrectionDto(_correctionIssueType, _correctionDescription, _correctionProposedValue);
        var success = await RestaurantService.SubmitCorrectionAsync(Slug, dto);
        _correctionSubmitting = false;

        if (success)
        {
            Toast.ShowSuccess("Poprawka została wysłana. Dziękujemy!");
            _showCorrectionModal = false;
            _correctionIssueType = "";
            _correctionDescription = null;
            _correctionProposedValue = null;
        }
        else
        {
            Toast.ShowError("Nie udało się wysłać poprawki.");
        }
    }

    private async Task SubmitIngredientSuggestion()
    {
        if (string.IsNullOrWhiteSpace(_ingredientName)) return;

        _ingredientSubmitting = true;
        var dto = new CreateIngredientSuggestionDto(
            _ingredientName, _ingredientIsAllergen, _ingredientIsVegetarian,
            _ingredientIsVegan, _ingredientIsGlutenFree, _ingredientIsLactoseFree);
        var success = await RestaurantService.SuggestIngredientAsync(Slug, dto);
        _ingredientSubmitting = false;

        if (success)
        {
            Toast.ShowSuccess("Sugestia składnika została wysłana. Dziękujemy!");
            _showIngredientModal = false;
            _ingredientName = "";
            _ingredientIsAllergen = false;
            _ingredientIsVegetarian = true;
            _ingredientIsVegan = true;
            _ingredientIsGlutenFree = true;
            _ingredientIsLactoseFree = true;
        }
        else
        {
            Toast.ShowError("Nie udało się wysłać sugestii.");
        }
    }
}
