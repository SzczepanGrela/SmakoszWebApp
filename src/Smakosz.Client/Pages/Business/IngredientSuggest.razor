@page "/restaurant/ingredients/suggest"
@layout BusinessLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Restaurant")]
@inject IBusinessService BusinessService
@inject ToastService Toast

<PageTitle>Sugeruj składnik - Panel restauracji</PageTitle>

<h2 class="fw-bold mb-4"><i class="fa-solid fa-lightbulb me-2"></i>Sugeruj składnik</h2>

<p class="text-muted mb-4">Zaproponuj nowy skladnik, ktory zostanie dodany do bazy po zatwierdzeniu przez administratora.</p>

<div class="row">
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body">
                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation me-2"></i>@_error</div>
                }
                <div class="mb-3">
                    <label class="form-label fw-medium">Nazwa skladnika *</label>
                    <input type="text" class="form-control" @bind="_name" placeholder="np. Mozzarella, Bazylia..." />
                </div>
                <button class="btn btn-primary" @onclick="HandleSubmit" disabled="@_saving">
                    @if (_saving) { <span class="spinner-border spinner-border-sm me-2"></span> }
                    <i class="fa-solid fa-paper-plane me-1"></i>Wyslij sugestie
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private string _name = "";
    private bool _saving;
    private string? _error;
    private string? _restaurantSlug;

    protected override async Task OnInitializedAsync()
    {
        var restaurant = await BusinessService.GetRestaurantInfoAsync();
        _restaurantSlug = restaurant?.Slug;
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            _error = "Nazwa skladnika jest wymagana.";
            return;
        }

        if (string.IsNullOrEmpty(_restaurantSlug))
        {
            _error = "Nie znaleziono restauracji.";
            return;
        }

        _saving = true;
        _error = null;

        var success = await BusinessService.CreateIngredientSuggestionAsync(_restaurantSlug, _name.Trim());
        if (success)
        {
            Toast.ShowSuccess($"Sugestia \"{_name}\" zostala wyslana!");
            _name = "";
        }
        else
        {
            _error = "Nie udalo sie wyslac sugestii. Skladnik moze juz istniec lub sugestia czeka na rozpatrzenie.";
        }

        _saving = false;
    }
}
