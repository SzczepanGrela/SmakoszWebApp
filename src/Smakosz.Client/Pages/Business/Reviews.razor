@page "/restaurant/reviews"
@layout BusinessLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "restaurant")]
@inject IBusinessService BusinessService

<PageTitle>Recenzje - Panel restauracji</PageTitle>

<h2 class="fw-bold mb-4"><i class="fa-solid fa-comments me-2"></i>Recenzje</h2>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_reviews == null || !_reviews.Data.Any())
{
    <EmptyState Icon="fa-solid fa-comments" Title="Brak recenzji" Description="Gdy klienci dodadza recenzje, pojawia sie tutaj." />
}
else
{
    <div class="mb-3">
        <small class="text-muted">Laczna liczba recenzji: @_reviews.Pagination.TotalCount</small>
    </div>

    @foreach (var review in _reviews.Data)
    {
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="d-flex align-items-center gap-2">
                        <img src="@Helpers.ImageHelper.GetAvatarUrl(review.Author?.AvatarUrl, review.Author?.Username ?? "U")"
                             class="rounded-circle" style="width:40px;height:40px;object-fit:cover;" alt="" />
                        <div>
                            <strong>@(review.Author?.Username ?? "Anonim")</strong>
                            <small class="text-muted d-block">@review.VisitDate</small>
                        </div>
                    </div>
                    <StatusBadge Status="@review.ContentStatus" />
                </div>

                <div class="d-flex gap-3 mb-2 small">
                    <span><i class="fa-solid fa-utensils me-1"></i>Danie: @review.DishRating/10</span>
                    <span><i class="fa-solid fa-bell-concierge me-1"></i>Obsluga: @review.ServiceRating/10</span>
                    <span><i class="fa-solid fa-broom me-1"></i>Czystosc: @review.CleanlinessRating/10</span>
                    <span><i class="fa-solid fa-couch me-1"></i>Atmosfera: @review.AmbianceRating/10</span>
                </div>

                @if (!string.IsNullOrEmpty(review.DishName))
                {
                    <small class="text-muted d-block mb-2">
                        <i class="fa-solid fa-bowl-food me-1"></i>@review.DishName
                    </small>
                }

                @if (!string.IsNullOrEmpty(review.Content))
                {
                    <p class="mb-0">@review.Content</p>
                }
            </div>
        </div>
    }

    @if (_reviews.Pagination.TotalPages > 1)
    {
        <Pagination Info="@_reviews.Pagination" OnPageChange="LoadPage" />
    }
}

@code {
    private PagedResult<ReviewCardDto>? _reviews;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadPage(1);
    }

    private async Task LoadPage(int page)
    {
        _loading = true;
        _reviews = await BusinessService.GetReviewsAsync(page);
        _loading = false;
    }
}
