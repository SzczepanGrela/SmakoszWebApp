@page "/restaurant/photos"
@layout BusinessLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "restaurant")]
@inject ToastService Toast

<PageTitle>Zdjęcia - Panel restauracji</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="fa-solid fa-images me-2"></i>Galeria zdjec</h2>
    <button class="btn btn-primary" @onclick="() => _showUpload = !_showUpload">
        <i class="fa-solid fa-upload me-1"></i>Dodaj zdjecie
    </button>
</div>

@if (_showUpload)
{
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label fw-medium">URL zdjecia</label>
                <div class="input-group">
                    <input type="url" class="form-control" @bind="_newPhotoUrl" placeholder="https://..." />
                    <button class="btn btn-primary" @onclick="AddPhoto" disabled="@string.IsNullOrWhiteSpace(_newPhotoUrl)">
                        <i class="fa-solid fa-plus me-1"></i>Dodaj
                    </button>
                </div>
                <small class="text-muted">W pelnej wersji bedzie mozliwosc przesylania plikow.</small>
            </div>
        </div>
    </div>
}

@if (!_photos.Any())
{
    <EmptyState Icon="fa-solid fa-images" Title="Brak zdjec" Description="Dodaj zdjecia swojej restauracji i dan." />
}
else
{
    <div class="row">
        @foreach (var photo in _photos)
        {
            <div class="col-md-4 col-lg-3 mb-4">
                <div class="card shadow-sm h-100">
                    <img src="@photo" class="card-img-top" style="height:200px;object-fit:cover;" alt="Zdjęcie restauracji" />
                    <div class="card-body p-2 text-center">
                        <button class="btn btn-outline-danger btn-sm" @onclick="() => RemovePhoto(photo)">
                            <i class="fa-solid fa-trash me-1"></i>Usuń
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<string> _photos = new()
    {
        "https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=400",
        "https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=400",
        "https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=400",
        "https://images.unsplash.com/photo-1555396273-367ea4eb4db5?w=400",
        "https://images.unsplash.com/photo-1476224203421-9ac39bcb3327?w=400",
        "https://images.unsplash.com/photo-1540189549336-e6e99c3679fe?w=400"
    };
    private bool _showUpload;
    private string _newPhotoUrl = "";

    private void AddPhoto()
    {
        if (!string.IsNullOrWhiteSpace(_newPhotoUrl))
        {
            _photos.Insert(0, _newPhotoUrl);
            _newPhotoUrl = "";
            _showUpload = false;
            Toast.ShowSuccess("Zdjęcie zostalo dodane.");
        }
    }

    private void RemovePhoto(string url)
    {
        _photos.Remove(url);
        Toast.ShowSuccess("Zdjęcie zostalo usuniete.");
    }
}
