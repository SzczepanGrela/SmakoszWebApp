@page "/restaurant/photos"
@layout BusinessLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Restaurant")]
@inject IBusinessService BusinessService
@inject ToastService Toast

<PageTitle>Zdjęcia - Panel restauracji</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="fa-solid fa-images me-2"></i>Galeria zdjęć</h2>
    <button class="btn btn-primary" @onclick="() => _showUpload = !_showUpload">
        <i class="fa-solid fa-upload me-1"></i>Dodaj zdjęcie
    </button>
</div>

@if (_showUpload)
{
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <ImageUpload EntityType="restaurant" OnImageUploaded="AddPhoto" />
        </div>
    </div>
}

@if (!_photos.Any())
{
    <EmptyState Icon="fa-solid fa-images" Title="Brak zdjęć" Description="Dodaj zdjęcia swojej restauracji i dań." />
}
else
{
    <div class="row">
        @foreach (var photo in _photos)
        {
            <div class="col-md-4 col-lg-3 mb-4">
                <div class="card shadow-sm h-100">
                    <img src="@photo" class="card-img-top" style="height:200px;object-fit:cover;" alt="Zdjęcie restauracji" />
                    <div class="card-body p-2 text-center">
                        <button class="btn btn-outline-danger btn-sm" @onclick="() => RemovePhoto(photo)">
                            <i class="fa-solid fa-trash me-1"></i>Usuń
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<string> _photos = [];
    private bool _showUpload;

    private void AddPhoto(string url)
    {
        _photos.Insert(0, url);
        _showUpload = false;
        Toast.ShowSuccess("Zdjęcie zostało dodane.");
    }

    private void RemovePhoto(string url)
    {
        _photos.Remove(url);
        Toast.ShowSuccess("Zdjęcie zostało usunięte.");
    }
}
