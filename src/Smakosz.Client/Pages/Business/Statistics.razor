@page "/restaurant/stats"
@layout BusinessLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Restaurant")]
@inject IBusinessService BusinessService

<PageTitle>Statystyki - Panel restauracji</PageTitle>

<h2 class="fw-bold mb-4"><i class="fa-solid fa-chart-bar me-2"></i>Statystyki</h2>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_stats == null)
{
    <EmptyState Icon="fa-solid fa-chart-bar" Title="Brak danych" Description="Nie udało się pobrać statystyk." />
}
else
{
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm text-center p-3">
                <div class="fs-2 fw-bold" style="color:var(--accent-color);">@_stats.TotalReviews</div>
                <small class="text-muted">Łączna liczba recenzji</small>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm text-center p-3">
                <div class="fs-2 fw-bold" style="color:var(--accent-color);">@(_stats.AverageRating?.ToString("F1") ?? "-")</div>
                <small class="text-muted">Średnia ocena</small>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm text-center p-3">
                <div class="fs-2 fw-bold" style="color:var(--accent-color);">@_stats.ReviewsThisMonth</div>
                <small class="text-muted">Recenzje w tym miesiącu</small>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm text-center p-3">
                <div class="fs-2 fw-bold" style="color:var(--accent-color);">@_stats.ReviewsLastMonth</div>
                <small class="text-muted">Recenzje w poprzednim miesiącu</small>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body text-center p-4">
            @if (ReviewDiff > 0)
            {
                <i class="fa-solid fa-arrow-trend-up fa-2x mb-2 text-success"></i>
                <p class="mb-0">Wzrost o <strong>@ReviewDiff</strong> recenzji w porównaniu do poprzedniego miesiąca</p>
            }
            else if (ReviewDiff < 0)
            {
                <i class="fa-solid fa-arrow-trend-down fa-2x mb-2 text-danger"></i>
                <p class="mb-0">Spadek o <strong>@Math.Abs(ReviewDiff)</strong> recenzji w porównaniu do poprzedniego miesiąca</p>
            }
            else
            {
                <i class="fa-solid fa-equals fa-2x mb-2 text-muted"></i>
                <p class="mb-0">Taka sama liczba recenzji jak w poprzednim miesiącu</p>
            }
        </div>
    </div>

    @if (_chartData != null)
    {
        <h4 class="fw-bold mb-3"><i class="fa-solid fa-chart-line me-2"></i>Wykresy</h4>
        <div class="row">
            <div class="col-lg-6 mb-4">
                <div class="card shadow-sm" data-testid="chart-review-trend">
                    <div class="card-header fw-semibold">Trend recenzji (30 dni)</div>
                    <div class="card-body">
                        <ApexChart TItem="DailyReviewCount" Height="300">
                            <ApexPointSeries TItem="DailyReviewCount"
                                             Items="_chartData.ReviewTrend"
                                             SeriesType="SeriesType.Line"
                                             Name="Recenzje"
                                             XValue="e => e.Date.ToString()"
                                             YValue="e => e.Count" />
                        </ApexChart>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 mb-4">
                <div class="card shadow-sm" data-testid="chart-rating-distribution">
                    <div class="card-header fw-semibold">Rozkład ocen (1-10)</div>
                    <div class="card-body">
                        <ApexChart TItem="RatingDistributionItem" Height="300">
                            <ApexPointSeries TItem="RatingDistributionItem"
                                             Items="_chartData.RatingDistribution"
                                             SeriesType="SeriesType.Bar"
                                             Name="Liczba"
                                             XValue="e => e.Rating.ToString()"
                                             YValue="e => (decimal)e.Count" />
                        </ApexChart>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 mb-4">
                <div class="card shadow-sm" data-testid="chart-category-averages">
                    <div class="card-header fw-semibold">Oceny wg kategorii</div>
                    <div class="card-body">
                        <ApexChart TItem="CategoryDataPoint" Height="300">
                            <ApexPointSeries TItem="CategoryDataPoint"
                                             Items="_categoryPoints"
                                             SeriesType="SeriesType.Radar"
                                             Name="Ocena"
                                             XValue="e => e.Category"
                                             YValue="e => (decimal)e.Value" />
                        </ApexChart>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 mb-4">
                <div class="card shadow-sm" data-testid="chart-top-dishes">
                    <div class="card-header fw-semibold">Ranking dań (top 5)</div>
                    <div class="card-body">
                        @if (_chartData.TopDishes.Count > 0)
                        {
                            <ApexChart TItem="DishRankingItem" Height="300"
                                       Options="@_topDishesOptions">
                                <ApexPointSeries TItem="DishRankingItem"
                                                 Items="_chartData.TopDishes"
                                                 SeriesType="SeriesType.Bar"
                                                 Name="Średnia ocena"
                                                 XValue="e => e.DishName"
                                                 YValue="e => (decimal)e.AvgRating" />
                            </ApexChart>
                        }
                        else
                        {
                            <p class="text-muted text-center py-4">Brak dań z wystarczającą liczbą recenzji</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    private BusinessStatsDto? _stats;
    private BusinessChartDataDto? _chartData;
    private List<CategoryDataPoint> _categoryPoints = [];
    private bool _loading = true;

    private ApexChartOptions<DishRankingItem> _topDishesOptions = new()
    {
        PlotOptions = new PlotOptions
        {
            Bar = new PlotOptionsBar { Horizontal = true }
        }
    };

    private int ReviewDiff => _stats is not null ? _stats.ReviewsThisMonth - _stats.ReviewsLastMonth : 0;

    protected override async Task OnInitializedAsync()
    {
        var statsTask = BusinessService.GetStatsAsync();
        var chartTask = BusinessService.GetChartDataAsync();

        await Task.WhenAll(statsTask, chartTask);

        _stats = statsTask.Result;
        _chartData = chartTask.Result;

        if (_chartData != null)
        {
            _categoryPoints =
            [
                new("Jedzenie", _chartData.CategoryAverages.Food),
                new("Obsługa", _chartData.CategoryAverages.Service),
                new("Czystość", _chartData.CategoryAverages.Cleanliness),
                new("Atmosfera", _chartData.CategoryAverages.Ambiance)
            ];
        }

        _loading = false;
    }

    private record CategoryDataPoint(string Category, double Value);
}
