@page "/restaurant/info"
@layout BusinessLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "restaurant")]
@inject IBusinessService BusinessService
@inject ToastService Toast
@inject SmakoszApiClient Api

<PageTitle>Informacje o restauracji - Panel restauracji</PageTitle>

<h2 class="fw-bold mb-4"><i class="fa-solid fa-circle-info me-2"></i>Informacje o restauracji</h2>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_restaurant == null)
{
    <EmptyState Icon="fa-solid fa-store" Title="Brak danych" />
}
else
{
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation me-2"></i>@_error</div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-medium">Nazwa restauracji</label>
                    <input type="text" class="form-control" @bind="_restaurant.RestaurantName" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-medium">Typ kuchni</label>
                    <select class="form-select" @bind="_restaurant.CuisineType">
                        <option value="">Wybierz...</option>
                        <option>Polska</option>
                        <option>Wloska</option>
                        <option>Azjatycka</option>
                        <option>Amerykanska</option>
                        <option>Meksykanska</option>
                        <option>Francuska</option>
                    </select>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-medium">Opis</label>
                <textarea class="form-control" rows="4" @bind="_restaurant.Description"></textarea>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-medium">Miasto</label>
                    <select class="form-select" @bind="_restaurant.CityId">
                        <option value="">Wybierz miasto...</option>
                        @foreach (var city in _cities)
                        {
                            <option value="@city.Id">@city.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-medium">Adres</label>
                    <input type="text" class="form-control" @bind="_restaurant.Address" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-medium">Telefon</label>
                    <input type="tel" class="form-control" @bind="_restaurant.Phone" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-medium">Email</label>
                    <input type="email" class="form-control" @bind="_restaurant.Email" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-medium">Strona www</label>
                    <input type="url" class="form-control" @bind="_restaurant.Website" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-medium">Poziom cenowy</label>
                    <select class="form-select" @bind="_restaurant.PriceLevel">
                        <option value="1">$ - Budzetowy</option>
                        <option value="2">$$ - Sredni</option>
                        <option value="3">$$$ - Wyzszy</option>
                        <option value="4">$$$$ - Premium</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-medium">URL zdjecia</label>
                    <input type="url" class="form-control" @bind="_restaurant.ImageUrl" placeholder="https://..." />
                </div>
            </div>

            <button class="btn btn-primary" @onclick="HandleSave" disabled="@_saving">
                @if (_saving) { <span class="spinner-border spinner-border-sm me-2"></span> }
                <i class="fa-solid fa-floppy-disk me-1"></i>Zapisz zmiany
            </button>
        </div>
    </div>
}

@code {
    private BusinessRestaurantDto? _restaurant;
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private List<CityDto> _cities = [];

    protected override async Task OnInitializedAsync()
    {
        var citiesTask = Api.GetAsync<List<CityDto>>("/api/cities");
        _restaurant = await BusinessService.GetRestaurantInfoAsync();
        _cities = await citiesTask ?? [];
        _loading = false;
    }

    private async Task HandleSave()
    {
        _saving = true;
        _error = null;
        var success = await BusinessService.UpdateRestaurantInfoAsync(_restaurant!);
        if (success)
            Toast.ShowSuccess("Informacje zostaly zaktualizowane.");
        else
            _error = "Nie udalo sie zapisac zmian.";
        _saving = false;
    }
}
