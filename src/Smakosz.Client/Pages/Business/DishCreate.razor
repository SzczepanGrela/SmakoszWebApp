@page "/restaurant/dishes/add"
@layout BusinessLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Restaurant")]
@inject IBusinessService BusinessService
@inject ISearchService SearchService
@inject NavigationManager Navigation
@inject ToastService Toast

<PageTitle>Dodaj danie - Panel restauracji</PageTitle>

<h2 class="fw-bold mb-4"><i class="fa-solid fa-plus me-2"></i>Dodaj nowe danie</h2>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation me-2"></i>@_error</div>
}

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm mb-4">
            <div class="card-header"><h5 class="mb-0">Informacje o daniu</h5></div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label fw-medium">Nazwa dania *</label>
                    <input type="text" class="form-control" @bind="_dish.DishName" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-medium">Opis</label>
                    <textarea class="form-control" rows="3" @bind="_dish.Description" placeholder="Opisz danie..."></textarea>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-medium">Cena (zł)</label>
                        <input type="number" class="form-control" step="0.01" @bind="_dish.Price" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-medium">Kalorie (kcal)</label>
                        <input type="number" class="form-control" @bind="_dish.Calories" />
                    </div>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" @bind="_dish.IsAvailable" />
                    <label class="form-check-label">Dostępne</label>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-medium">Zdjęcie dania</label>
                    <ImageUpload EntityType="dish" OnImageUploaded="url => _dish.ImageUrl = url" />
                </div>
                <div class="mb-3">
                    <label for="dishCategory" class="form-label fw-medium">Kategoria dania *</label>
                    <select id="dishCategory"
                            class="form-select"
                            @bind="_selectedCategory">
                        <option value="">-- wybierz kategorie --</option>
                        @foreach (var cat in _categories)
                        {
                            <option value="@cat.Value">@cat.Label</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header"><h5 class="mb-0">Cechy dania</h5></div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label fw-medium">Ostrość</label>
                    <select class="form-select" @bind="_selectedSpiceLevel">
                        <option value="">-- brak --</option>
                        @foreach (var lvl in _spiceLevelOptions)
                        {
                            <option value="@lvl.Value">@lvl.Label</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-medium">Klimat</label>
                    <select class="form-select" @bind="_selectedMood">
                        <option value="">-- brak --</option>
                        @foreach (var mood in _moodOptions)
                        {
                            <option value="@mood.Value">@mood.Label</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-medium">Pora dnia</label>
                    @foreach (var occ in _occasionOptions)
                    {
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox"
                                   checked="@_selectedOccasions.Contains(occ.Value)"
                                   @onchange="e => ToggleOccasion(occ.Value, (bool)e.Value!)" />
                            <label class="form-check-label">@occ.Label</label>
                        </div>
                    }
                </div>
                <div class="mb-3">
                    <label class="form-label fw-medium">Cechy</label>
                    @foreach (var feat in _featureOptions)
                    {
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox"
                                   checked="@_selectedFeatures.Contains(feat.Value)"
                                   @onchange="e => ToggleFeature(feat.Value, (bool)e.Value!)" />
                            <label class="form-check-label">@feat.Label</label>
                        </div>
                    }
                </div>
            </div>
        </div>

        <IngredientPicker @bind-SelectedIds="_selectedIngredientIds" />

        <MenuSectionPicker @bind-SelectedIds="_selectedSectionIds" />
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                @if (!string.IsNullOrEmpty(_dish.ImageUrl))
                {
                    <img src="@_dish.ImageUrl" class="img-fluid rounded mb-3" alt="Podglad" />
                }
                else
                {
                    <div class="bg-light rounded d-flex align-items-center justify-content-center mb-3" style="height:200px;">
                        <i class="fa-solid fa-image fa-3x text-muted"></i>
                    </div>
                }
                <h6 class="fw-bold">@(string.IsNullOrEmpty(_dish.DishName) ? "Nazwa dania" : _dish.DishName)</h6>
                @if (_dish.Price.HasValue)
                {
                    <span class="fw-bold" style="color:var(--accent-color);">@_dish.Price.Value.ToString("F2") zł</span>
                }
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between">
    <a href="/restaurant/dishes" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i>Powrot
    </a>
    <button class="btn btn-primary" @onclick="HandleCreate" disabled="@_saving">
        @if (_saving) { <span class="spinner-border spinner-border-sm me-2"></span> }
        <i class="fa-solid fa-plus me-1"></i>Dodaj danie
    </button>
</div>

@code {
    private DishDetailDto _dish = new() { IsAvailable = true };
    private List<int> _selectedIngredientIds = [];
    private List<int> _selectedSectionIds = [];
    private string? _selectedCategory;
    private string? _selectedSpiceLevel;
    private string? _selectedMood;
    private readonly HashSet<string> _selectedOccasions = [];
    private readonly HashSet<string> _selectedFeatures = [];
    private List<FilterOption> _categories = new();
    private List<FilterOption> _spiceLevelOptions = new();
    private List<FilterOption> _moodOptions = new();
    private List<FilterOption> _occasionOptions = new();
    private List<FilterOption> _featureOptions = new();
    private bool _saving;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var filters = await SearchService.GetFiltersAsync();
        _categories = filters?.DishCategories ?? new();
        _spiceLevelOptions = filters?.SpiceLevels ?? new();
        _moodOptions = filters?.Moods ?? new();
        _occasionOptions = filters?.Occasions ?? new();
        _featureOptions = filters?.Features ?? new();
    }

    private void ToggleOccasion(string v, bool on) { if (on) _selectedOccasions.Add(v); else _selectedOccasions.Remove(v); }
    private void ToggleFeature(string v, bool on) { if (on) _selectedFeatures.Add(v); else _selectedFeatures.Remove(v); }

    private async Task HandleCreate()
    {
        if (string.IsNullOrWhiteSpace(_dish.DishName))
        {
            _error = "Nazwa dania jest wymagana.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_selectedCategory))
        {
            Toast.ShowError("Wybór kategorii dania jest wymagany");
            return;
        }

        _saving = true;
        _error = null;
        _dish.CategoryTagName = _selectedCategory;
        var success = await BusinessService.CreateDishAsync(
            _dish,
            _selectedIngredientIds,
            _selectedSectionIds,
            spiceLevel: string.IsNullOrEmpty(_selectedSpiceLevel) ? null : _selectedSpiceLevel,
            mood: string.IsNullOrEmpty(_selectedMood) ? null : _selectedMood,
            features: _selectedFeatures.ToList(),
            occasions: _selectedOccasions.ToList());
        if (success)
        {
            Toast.ShowSuccess("Danie zostalo dodane!");
            Navigation.NavigateTo("/restaurant/dishes");
        }
        else
        {
            _error = "Nie udalo sie dodac dania.";
        }
        _saving = false;
    }
}
