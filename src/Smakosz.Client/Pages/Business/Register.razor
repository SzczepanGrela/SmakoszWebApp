@page "/business/register"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IBusinessService BusinessService
@inject NavigationManager Navigation
@inject ToastService Toast
@inject SmakoszApiClient Api

<PageTitle>Zgłoś nowa restauracje - Smakosz</PageTitle>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="mb-3"><i class="fa-solid fa-store me-2"></i>Zgłoś nowa restauracje</h1>
            <p class="text-muted mb-4">
                Twoja restauracja nie istnieje jeszcze na Smakoszu? Wypelnij formularz, a administrator
                zweryfikuje zgloszenie i utworzy wpis. Jesli restauracja juz tu jest, znajdz ja w
                <a href="/restaurants">katalogu</a> i kliknij "Czy to twoja restauracja?".
            </p>

            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label fw-medium">Nazwa restauracji *</label>
                        <input type="text" class="form-control" @bind="_model.Name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium">Adres *</label>
                        <input type="text" class="form-control" @bind="_model.Address"
                               placeholder="ul. Przykładowa 1, Warszawa" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium">Miasto</label>
                        <select class="form-select" @bind="_model.CityId">
                            <option value="">Wybierz miasto...</option>
                            @foreach (var city in _cities)
                            {
                                <option value="@city.Id">@city.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium">Telefon</label>
                        <input type="tel" class="form-control" @bind="_model.Phone" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium">Email kontaktowy restauracji</label>
                        <input type="email" class="form-control" @bind="_model.Email" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium">Opis (opcjonalnie)</label>
                        <textarea class="form-control" rows="3" @bind="_model.Description"></textarea>
                    </div>

                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="alert alert-danger">
                            <i class="fa-solid fa-circle-exclamation me-2"></i>@_error
                        </div>
                    }

                    <button class="btn btn-primary" @onclick="HandleSubmit" disabled="@_submitting">
                        <i class="fa-solid fa-paper-plane me-2"></i>Wyslij zgloszenie
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private NewRestaurantRequestDto _model = new();
    private string? _error;
    private bool _submitting;
    private List<CityDto> _cities = [];

    protected override async Task OnInitializedAsync()
    {
        _cities = await Api.GetAsync<List<CityDto>>("/api/cities") ?? [];
    }

    private async Task HandleSubmit()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_model.Name) || _model.Name.Length < 2)
        {
            _error = "Nazwa restauracji jest wymagana (min 2 znaki).";
            return;
        }
        if (string.IsNullOrWhiteSpace(_model.Address) || _model.Address.Length < 5)
        {
            _error = "Adres jest wymagany (min 5 znakow).";
            return;
        }

        _submitting = true;
        var ticketId = await BusinessService.RequestNewRestaurantAsync(_model);
        _submitting = false;

        if (ticketId.HasValue)
        {
            Toast.ShowSuccess("Twoje zgloszenie zostalo wyslane do administratora.");
            Navigation.NavigateTo("/me/claims");
        }
        else
        {
            _error = "Nie udalo sie wyslac zgloszenia. Sprobuj ponownie.";
        }
    }
}
