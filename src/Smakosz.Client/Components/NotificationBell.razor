@implements IDisposable
@inject Smakosz.Client.Services.INotificationService NotificationService

<a href="/notifications" class="nav-link notification-bell position-relative">
    <i class="fa-solid fa-bell"></i>
    @if (_unreadCount > 0)
    {
        <span class="badge rounded-pill bg-danger">@_unreadCount</span>
    }
</a>

@code {
    private int _unreadCount;
    private System.Threading.Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        NotificationService.UnreadCountChanged += OnUnreadCountChanged;
        await RefreshCount();
        _timer = new System.Threading.Timer(async _ =>
        {
            await RefreshCount();
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(60), TimeSpan.FromSeconds(60));
    }

    private void OnUnreadCountChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await RefreshCount();
            StateHasChanged();
        });
    }

    private async Task RefreshCount()
    {
        try
        {
            _unreadCount = await NotificationService.GetUnreadCountAsync();
        }
        catch
        {
            // Silently ignore refresh failures
        }
    }

    public void Dispose()
    {
        NotificationService.UnreadCountChanged -= OnUnreadCountChanged;
        _timer?.Dispose();
    }
}
