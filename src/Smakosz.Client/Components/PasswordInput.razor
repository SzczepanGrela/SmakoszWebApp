<div class="input-group">
    <input type="@(_showPassword ? "text" : "password")" class="form-control" value="@Value"
           @oninput="OnInput" placeholder="@Placeholder" />
    <button class="btn btn-outline-secondary" type="button" @onclick="ToggleVisibility">
        <i class="fa-solid @(_showPassword ? "fa-eye-slash" : "fa-eye")"></i>
    </button>
</div>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string Placeholder { get; set; } = "Hasło";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private bool _showPassword;

    private void ToggleVisibility() => _showPassword = !_showPassword;

    private async Task OnInput(ChangeEventArgs e)
    {
        Value = e.Value?.ToString() ?? "";
        await ValueChanged.InvokeAsync(Value);
    }
}
