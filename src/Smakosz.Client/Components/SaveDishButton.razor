<button class="btn @(IsSaved ? "btn-danger" : "btn-outline-danger")" @onclick="OnToggle">
    <i class="@(IsSaved ? "fa-solid" : "fa-regular") fa-heart me-1"></i>
    @(IsSaved ? "Zapisane" : "Zapisz")
</button>

@code {
    [Parameter] public bool IsSaved { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }
}
