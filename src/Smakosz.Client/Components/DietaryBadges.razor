@if (IsVegan || IsVegetarian || IsGlutenFree || IsLactoseFree || !string.IsNullOrEmpty(SpiceLevel))
{
    <div class="dish-tags mt-1 d-flex flex-wrap gap-1">
        @if (IsVegan)
        {
            <span class="badge bg-success">Vegan</span>
        }
        @if (IsVegetarian)
        {
            <span class="badge bg-success">Wege</span>
        }
        @if (IsGlutenFree)
        {
            <span class="badge bg-info">Bez glutenu</span>
        }
        @if (IsLactoseFree)
        {
            <span class="badge bg-info">Bez laktozy</span>
        }
        @if (!string.IsNullOrEmpty(SpiceLevel))
        {
            <span class="@SpiceBadgeClass"><i class="fa-solid fa-pepper-hot me-1"></i>@SpiceLevel</span>
        }
    </div>
}

@code {
    [Parameter] public bool IsVegan { get; set; }
    [Parameter] public bool IsVegetarian { get; set; }
    [Parameter] public bool IsGlutenFree { get; set; }
    [Parameter] public bool IsLactoseFree { get; set; }
    [Parameter] public string? SpiceLevel { get; set; }

    private string SpiceBadgeClass => SpiceLevel switch
    {
        "Łagodne" => "badge bg-success",
        "Średnio ostre" => "badge bg-warning text-dark",
        "Ostre" => "badge bg-danger",
        "Bardzo ostre" => "badge bg-dark",
        _ => "badge bg-secondary"
    };
}
