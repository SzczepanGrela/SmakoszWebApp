@inject Smakosz.Client.Services.IDishService DishService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<section class="quick-actions-bar">
    <div class="d-flex flex-wrap gap-2">
        <button class="btn btn-outline-primary btn-sm" @onclick="GetRandomDish">
            <i class="fa-solid fa-dice me-1"></i>Losowe danie
        </button>
        <button class="btn btn-outline-info btn-sm" @onclick="NearbyRestaurants" disabled="@_locating">
            @if (_locating)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
            }
            else
            {
                <i class="fa-solid fa-location-dot me-1"></i>
            }
            W poblizu
        </button>
        <AuthorizeView>
            <Authorized>
                <a href="/recommendations" class="btn btn-primary btn-sm">
                    <i class="fa-solid fa-wand-magic-sparkles me-1"></i>Rekomendacje
                </a>
            </Authorized>
        </AuthorizeView>
    </div>
</section>

@code {
    private bool _locating;

    private async Task GetRandomDish()
    {
        var dish = await DishService.GetRandomAsync();
        if (dish != null)
            Navigation.NavigateTo($"/dish/{dish.Slug}");
    }

    private async Task NearbyRestaurants()
    {
        _locating = true;
        try
        {
            var coords = await JS.InvokeAsync<double[]>("smakoszGeo.getPosition", TimeSpan.FromSeconds(10));
            if (coords is { Length: 2 })
                Navigation.NavigateTo($"/search?type=restaurants&lat={coords[0].ToString(System.Globalization.CultureInfo.InvariantCulture)}&lng={coords[1].ToString(System.Globalization.CultureInfo.InvariantCulture)}");
            else
                Navigation.NavigateTo("/search?type=restaurants");
        }
        catch
        {
            Navigation.NavigateTo("/search?type=restaurants");
        }
        finally
        {
            _locating = false;
        }
    }
}
