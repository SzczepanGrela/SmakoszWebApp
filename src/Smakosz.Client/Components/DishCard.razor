@using Smakosz.Client.Helpers

<a href="/dishes/@Dish.Slug" class="text-decoration-none">
    <div class="@CardClass">
        <div class="position-relative">
            <BlurHashImage Src="@ImageHelper.GetDishImage(Dish.ImageUrl)" Alt="@Dish.DishName"
                           BlurHash="@Dish.ImageBlurhash" CssClass="w-100" ImgStyle="height:200px;object-fit:cover;width:100%;" />
            @if (!string.IsNullOrEmpty(BadgeText))
            {
                <span class="badge @BadgeClass position-absolute top-0 end-0 m-2">@BadgeText</span>
            }
        </div>
        <div class="card-body p-3">
            <h6 class="small-title mb-1" style="color:var(--text-color);">@Dish.DishName</h6>
            @if (Dish.RestaurantName != null)
            {
                <small class="text-muted d-block mb-1">@Dish.RestaurantName</small>
            }
            <div class="dish-card-footer">
                <div class="d-flex justify-content-between align-items-center mt-2">
                    <div style="min-width:0;overflow:hidden;">
                        @if (Dish.AvgRating.HasValue)
                        {
                            <RatingStars Rating="@Dish.AvgRating.Value" Compact="true" />
                            <small class="text-muted ms-1">(@Dish.ReviewCount)</small>
                        }
                    </div>
                    @if (Dish.Price.HasValue)
                    {
                        <span class="fw-bold" style="color:var(--accent-color);">@Dish.Price.Value.ToString("F2") zł</span>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(Dish.CategoryTagName))
                {
                    <span class="badge me-1 mt-1"
                          style="background-color:@(Dish.CategoryColor ?? "#e67e22");color:#fff;">@Dish.CategoryTagName</span>
                }
                <DietaryBadges IsVegan="@Dish.IsVegan" IsVegetarian="@Dish.IsVegetarian" IsGlutenFree="@Dish.IsGlutenFree" IsSpicy="@Dish.IsSpicy" />
            </div>
        </div>
    </div>
</a>

@code {
    [Parameter, EditorRequired] public Smakosz.Client.Models.DishCardDto Dish { get; set; } = default!;
    [Parameter] public string Size { get; set; } = "normal";
    [Parameter] public string? BadgeText { get; set; }
    [Parameter] public string BadgeClass { get; set; } = "bg-warning text-dark";

    private string CardClass => Size switch
    {
        "small" => "dish-card-small",
        "large" => "dish-card dish-card-large",
        _ => "dish-card"
    };
}
