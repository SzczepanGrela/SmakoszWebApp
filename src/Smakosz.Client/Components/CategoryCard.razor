<a href="@ResolvedHref" class="card category-card text-decoration-none">
    <div class="card-body text-center py-3">
        @if (!string.IsNullOrEmpty(Icon))
        {
            <span class="fs-4">@Icon</span>
        }
        <span class="d-block mt-1 small fw-medium" style="color:var(--text-color);">@Name</span>
    </div>
</a>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = default!;
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Href { get; set; }

    private string ResolvedHref => Href ?? $"/search?cuisines={Uri.EscapeDataString(Name)}&type=dishes";
}
