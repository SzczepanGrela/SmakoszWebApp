@using Smakosz.Client.Helpers
@inject Smakosz.Client.Services.IUserProfileService UserProfileService

<div class="d-flex align-items-center gap-3 p-2">
    <BlurHashImage Src="@ImageHelper.GetAvatarUrl(User.AvatarUrl, User.Username)" Alt="@User.Username"
                   BlurHash="@User.AvatarBlurhash"
                   ContainerStyle="width:48px;height:48px;border-radius:50%;overflow:hidden;flex-shrink:0;"
                   ImgStyle="object-fit:cover;width:100%;height:100%;" />
    <div class="flex-grow-1">
        <a href="/users/@User.Slug" class="fw-bold text-decoration-none" style="color:var(--text-color);">@User.Username</a>
        <small class="text-muted d-block">@User.ReviewCount recenzji</small>
    </div>
    @if (ShowFollowButton)
    {
        <FollowButton IsFollowing="@_isFollowing" OnToggle="ToggleFollow" />
    }
</div>

@code {
    [Parameter, EditorRequired] public Smakosz.Client.Models.UserSummaryDto User { get; set; } = default!;
    [Parameter] public bool ShowFollowButton { get; set; }
    [Parameter] public bool IsFollowing { get; set; }

    private bool _isFollowing;

    protected override void OnParametersSet()
    {
        _isFollowing = IsFollowing;
    }

    private async Task ToggleFollow()
    {
        bool success;
        if (_isFollowing)
            success = await UserProfileService.UnfollowUserAsync(User.Slug);
        else
            success = await UserProfileService.FollowUserAsync(User.Slug);

        if (success)
            _isFollowing = !_isFollowing;
    }
}
