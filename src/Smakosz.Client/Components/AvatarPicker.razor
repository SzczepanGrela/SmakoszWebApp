@using Smakosz.Client.Services
@inject IMediaService MediaService
@inject ToastService Toast

<div class="avatar-picker">
    @if (!string.IsNullOrEmpty(CurrentImageUrl))
    {
        <div class="mb-2">
            <img src="@CurrentImageUrl" class="rounded-circle" style="width:120px;height:120px;object-fit:cover;" alt="Awatar" />
        </div>
    }
    <div class="d-flex gap-2 flex-wrap">
        <button type="button" class="btn btn-outline-primary" @onclick="OpenCropper" disabled="@_busy">
            <i class="fa-solid fa-camera me-1"></i>@(string.IsNullOrEmpty(CurrentImageUrl) ? "Dodaj awatar" : "Zmień awatar")
        </button>
        @if (!string.IsNullOrEmpty(CurrentImageUrl))
        {
            <button type="button" class="btn btn-outline-danger" @onclick="DeleteAvatarAsync" disabled="@_busy">
                <i class="fa-solid fa-trash me-1"></i>Usuń
            </button>
        }
    </div>
</div>

<ImageCropper IsOpen="_open"
              AspectRatio="1.0"
              Title="Przytnij awatar"
              MaxSizeMb="@MaxSizeMb"
              OutputMaxWidth="800"
              OnClose="() => { _open = false; return Task.CompletedTask; }"
              OnCropped="OnCroppedAsync" />

@code {
    [Parameter] public string? CurrentImageUrl { get; set; }
    [Parameter] public EventCallback<string?> OnImageUploaded { get; set; }
    [Parameter] public int MaxSizeMb { get; set; } = 1;

    private bool _open;
    private bool _busy;

    private void OpenCropper() => _open = true;

    private async Task OnCroppedAsync(ImageCropper.CroppedImage cropped)
    {
        _open = false;
        _busy = true;
        try
        {
            using var stream = cropped.Stream;
            var result = await MediaService.UploadAvatarAsync(stream, cropped.FileName);
            if (result is null)
            {
                Toast.ShowError("Nie udało się przesłać awatara.");
                return;
            }
            await OnImageUploaded.InvokeAsync(result.Url);
            Toast.ShowSuccess("Awatar zaktualizowany.");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAvatarAsync()
    {
        _busy = true;
        try
        {
            var ok = await MediaService.DeleteAvatarAsync();
            if (ok)
            {
                await OnImageUploaded.InvokeAsync(null);
                Toast.ShowSuccess("Awatar usunięty.");
            }
            else
            {
                Toast.ShowError("Nie udało się usunąć awatara.");
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
