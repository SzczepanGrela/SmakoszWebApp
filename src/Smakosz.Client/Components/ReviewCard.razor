@using Smakosz.Client.Helpers
@inject IReviewService ReviewService
@inject ToastService Toast

<div class="review-card" @onclick="OpenDetail">
    <div class="review-card-header">
        <BlurHashImage Src="@ImageHelper.GetAvatarUrl(Review.Author.AvatarUrl, Review.Author.Username)"
                       Alt="@Review.Author.Username" BlurHash="@Review.Author.AvatarBlurhash"
                       ContainerStyle="width:32px;height:32px;border-radius:50%;overflow:hidden;flex-shrink:0;margin-top:2px;"
                       ImgStyle="object-fit:cover;width:100%;height:100%;" />
        <div class="review-card-meta">
            <a href="/users/@Review.Author.Slug" class="review-card-username" @onclick:stopPropagation="true">
                @Review.Author.Username
            </a>
            @if (ShowDish)
            {
                <a href="/dishes/@Review.DishSlug" class="review-card-dish" @onclick:stopPropagation="true"
                   title="@Review.DishName">@Review.DishName</a>
            }
            @if (ShowRestaurant)
            {
                <div class="review-card-restaurant">@Review.RestaurantName</div>
            }
        </div>
        <div class="review-card-badge">@Average.ToString("0.#")</div>
    </div>

    <div class="review-pills">
        <span class="review-pill">Danie <span class="review-pill-value">@Review.DishRating</span></span>
        <span class="review-pill">Obsługa <span class="review-pill-value">@Review.ServiceRating</span></span>
        <span class="review-pill">Czystość <span class="review-pill-value">@Review.CleanlinessRating</span></span>
        <span class="review-pill">Atmosfera <span class="review-pill-value">@Review.AmbianceRating</span></span>
    </div>

    @if (!string.IsNullOrWhiteSpace(Review.Content))
    {
        <div class="review-content-clamp">@Review.Content</div>
    }

    <div class="review-card-footer">
        <AuthorizeView Roles="User">
            <Authorized>
                <button class="review-like-pill @(_isLiked ? "review-like-pill--active" : "")"
                        @onclick="ToggleLike" @onclick:stopPropagation="true" disabled="@_likeSubmitting">
                    @if (_isLiked) { <span>&#9829;</span> } else { <span>&#9825;</span> }
                    <span>@_helpfulCount</span>
                </button>
            </Authorized>
            <NotAuthorized>
                <span class="review-like-pill" style="cursor:default;">
                    <span>&#9825;</span> <span>@Review.HelpfulCount</span>
                </span>
            </NotAuthorized>
        </AuthorizeView>
        <span>dodano @DateTimeHelper.TimeAgo(Review.CreatedAt ?? DateTime.UtcNow)</span>
    </div>
</div>

@if (_showDetail)
{
    <ReviewDetailModal Review="@Review" IsOpen="true" OnClose="() => _showDetail = false"
                       IsLiked="@_isLiked" HelpfulCount="@_helpfulCount"
                       OnLikeToggled="OnDetailLikeToggled" ShowActions="@ShowActions" />
}

@code {
    [Parameter, EditorRequired] public Smakosz.Client.Models.ReviewCardDto Review { get; set; } = default!;
    [Parameter] public bool ShowDish { get; set; } = true;
    [Parameter] public bool ShowRestaurant { get; set; } = true;
    [Parameter] public bool ShowActions { get; set; }
    [Parameter] public bool Compact { get; set; }

    private bool _isLiked;
    private int _helpfulCount;
    private bool _likeSubmitting;
    private bool _showDetail;

    private double Average => (Review.DishRating + Review.ServiceRating + Review.CleanlinessRating + Review.AmbianceRating) / 4.0;

    protected override void OnParametersSet()
    {
        _isLiked = Review.IsHelpfulByMe;
        _helpfulCount = Review.HelpfulCount;
    }

    private void OpenDetail()
    {
        _showDetail = true;
    }

    private void OnDetailLikeToggled((bool isLiked, int count) result)
    {
        _isLiked = result.isLiked;
        _helpfulCount = result.count;
    }

    private async Task ToggleLike()
    {
        _likeSubmitting = true;
        var response = await ReviewService.ToggleLikeAsync(Review.PublicId);
        _likeSubmitting = false;

        if (response.Success && response.Data != null)
        {
            _isLiked = response.Data.IsLiked;
            _helpfulCount = response.Data.HelpfulCount;
        }
        else
        {
            Toast.ShowError("Nie udało się zmienić polubienia.");
        }
    }

}
