@using Smakosz.Client.Helpers
@inject IReviewService ReviewService
@inject ToastService Toast

<div class="review-card p-3">
    <div class="d-flex gap-3">
        <img src="@ImageHelper.GetAvatarUrl(Review.Author.AvatarUrl, Review.Author.Username)"
             alt="@Review.Author.Username" class="rounded-circle" style="width:48px;height:48px;object-fit:cover;" />
        <div class="flex-grow-1">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <a href="/users/@Review.Author.Slug" class="fw-bold text-decoration-none" style="color:var(--text-color);">
                        @Review.Author.Username
                    </a>
                    @if (ShowDish)
                    {
                        <span class="text-muted mx-1">o</span>
                        <a href="/dish/@Review.DishSlug" class="text-decoration-none" style="color:var(--accent-color);">@Review.DishName</a>
                    }
                    @if (ShowRestaurant)
                    {
                        <small class="text-muted d-block">@Review.RestaurantName</small>
                    }
                </div>
                <div class="d-flex align-items-center gap-2">
                    @if (ShowActions)
                    {
                        <AuthorizeView Roles="user">
                            <Authorized>
                                <button class="btn btn-link btn-sm text-muted p-0" title="Zglos recenzje" @onclick="OpenReportModal">
                                    <i class="fa-solid fa-flag"></i>
                                </button>
                            </Authorized>
                        </AuthorizeView>
                    }
                    <small class="text-muted">@DateTimeHelper.TimeAgo(Review.CreatedAt ?? DateTime.UtcNow)</small>
                </div>
            </div>
            <div class="mt-1">
                <RatingStars Rating="@((Review.DishRating + Review.ServiceRating + Review.CleanlinessRating + Review.AmbianceRating) / 4.0)" Size="sm" ShowValue="true" />
            </div>
            @if (!string.IsNullOrWhiteSpace(Review.Content))
            {
                <p class="mt-2 mb-1 small">@Review.Content</p>
            }
        </div>
    </div>
</div>

@if (_showReportModal)
{
    <Modal IsOpen="true" Title="Zglos recenzje" OnClose="() => _showReportModal = false">
        <div class="mb-3">
            <label class="form-label fw-bold">Powod zgloszenia *</label>
            @if (_reportReasons == null)
            {
                <div class="text-center py-2">
                    <span class="spinner-border spinner-border-sm"></span> Ladowanie...
                </div>
            }
            else
            {
                @foreach (var reason in _reportReasons)
                {
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="reason-@reason.ReasonCode"
                               checked="@_selectedReasonCodes.Contains(reason.ReasonCode)"
                               @onchange="e => ToggleReason(reason.ReasonCode, (bool)(e.Value ?? false))" />
                        <label class="form-check-label" for="reason-@reason.ReasonCode">
                            @reason.LabelPl
                            @if (!string.IsNullOrEmpty(reason.Description))
                            {
                                <small class="text-muted d-block">@reason.Description</small>
                            }
                        </label>
                    </div>
                }
            }
        </div>
        <div class="mb-3">
            <label class="form-label">Dodatkowy opis (opcjonalnie)</label>
            <textarea class="form-control" rows="2" @bind="_reportDescription" placeholder="Dodatkowe szczegoly..."></textarea>
        </div>
        <div class="d-flex justify-content-end gap-2">
            <button class="btn btn-outline-secondary btn-sm" @onclick="() => _showReportModal = false">Anuluj</button>
            <button class="btn btn-danger btn-sm" @onclick="SubmitReport" disabled="@(!_selectedReasonCodes.Any() || _reportSubmitting)">
                @if (_reportSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                Wyslij zgloszenie
            </button>
        </div>
    </Modal>
}

@code {
    [Parameter, EditorRequired] public Smakosz.Client.Models.ReviewCardDto Review { get; set; } = default!;
    [Parameter] public bool ShowDish { get; set; } = true;
    [Parameter] public bool ShowRestaurant { get; set; } = true;
    [Parameter] public bool ShowActions { get; set; }

    private bool _showReportModal;
    private List<Smakosz.Client.Models.ReportReasonDto>? _reportReasons;
    private HashSet<string> _selectedReasonCodes = new();
    private string? _reportDescription;
    private bool _reportSubmitting;

    private async Task OpenReportModal()
    {
        _showReportModal = true;
        _selectedReasonCodes.Clear();
        _reportDescription = null;
        _reportReasons ??= await ReviewService.GetReportReasonsAsync();
    }

    private void ToggleReason(string code, bool isChecked)
    {
        if (isChecked)
            _selectedReasonCodes.Add(code);
        else
            _selectedReasonCodes.Remove(code);
    }

    private async Task SubmitReport()
    {
        if (!_selectedReasonCodes.Any()) return;

        _reportSubmitting = true;
        var success = await ReviewService.ReportReviewAsync(Review.PublicId, _selectedReasonCodes.ToList(), _reportDescription);
        _reportSubmitting = false;

        if (success)
        {
            Toast.ShowSuccess("Zgloszenie zostalo wyslane.");
            _showReportModal = false;
            _selectedReasonCodes.Clear();
            _reportDescription = null;
        }
        else
        {
            Toast.ShowError("Nie udalo sie wyslac zgloszenia.");
        }
    }
}
