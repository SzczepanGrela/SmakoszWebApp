@using Smakosz.Client.Helpers
@inject IReviewService ReviewService
@inject ToastService Toast

<div class="review-card p-3">
    <div class="d-flex gap-3">
        <img src="@ImageHelper.GetAvatarUrl(Review.Author.AvatarUrl, Review.Author.Username)"
             alt="@Review.Author.Username" class="rounded-circle" style="width:48px;height:48px;object-fit:cover;" />
        <div class="flex-grow-1">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <a href="/users/@Review.Author.Slug" class="fw-bold text-decoration-none" style="color:var(--text-color);">
                        @Review.Author.Username
                    </a>
                    @if (ShowDish)
                    {
                        <span class="text-muted mx-1">o</span>
                        <a href="/dish/@Review.DishSlug" class="text-decoration-none" style="color:var(--accent-color);">@Review.DishName</a>
                    }
                    @if (ShowRestaurant)
                    {
                        <small class="text-muted d-block">@Review.RestaurantName</small>
                    }
                </div>
                <div class="d-flex align-items-center gap-2">
                    @if (ShowActions)
                    {
                        <AuthorizeView>
                            <Authorized>
                                <button class="btn btn-link btn-sm text-muted p-0" title="Zglos recenzje" @onclick="() => _showReportModal = true">
                                    <i class="fa-solid fa-flag"></i>
                                </button>
                            </Authorized>
                        </AuthorizeView>
                    }
                    <small class="text-muted">@DateTimeHelper.TimeAgo(Review.CreatedAt ?? DateTime.UtcNow)</small>
                </div>
            </div>
            <div class="mt-1">
                <RatingStars Rating="@((Review.DishRating + Review.ServiceRating + Review.CleanlinessRating + Review.AmbianceRating) / 4.0)" Size="sm" ShowValue="true" />
            </div>
            @if (!string.IsNullOrWhiteSpace(Review.Content))
            {
                <p class="mt-2 mb-1 small">@Review.Content</p>
            }
        </div>
    </div>
</div>

@if (_showReportModal)
{
    <Modal IsOpen="true" Title="Zglos recenzje" OnClose="() => _showReportModal = false">
        <div class="mb-3">
            <label class="form-label">Powód zgloszenia *</label>
            <textarea class="form-control" rows="3" @bind="_reportReason" placeholder="Opisz powod zgloszenia..."></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label">Dodatkowy opis (opcjonalnie)</label>
            <textarea class="form-control" rows="2" @bind="_reportDescription" placeholder="Dodatkowe szczegoly..."></textarea>
        </div>
        <div class="d-flex justify-content-end gap-2">
            <button class="btn btn-outline-secondary btn-sm" @onclick="() => _showReportModal = false">Anuluj</button>
            <button class="btn btn-danger btn-sm" @onclick="SubmitReport" disabled="@(string.IsNullOrWhiteSpace(_reportReason) || _reportSubmitting)">
                @if (_reportSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                Wyslij zgloszenie
            </button>
        </div>
    </Modal>
}

@code {
    [Parameter, EditorRequired] public Smakosz.Client.Models.ReviewCardDto Review { get; set; } = default!;
    [Parameter] public bool ShowDish { get; set; } = true;
    [Parameter] public bool ShowRestaurant { get; set; } = true;
    [Parameter] public bool ShowActions { get; set; }

    private bool _showReportModal;
    private string _reportReason = "";
    private string? _reportDescription;
    private bool _reportSubmitting;

    private async Task SubmitReport()
    {
        if (string.IsNullOrWhiteSpace(_reportReason)) return;

        _reportSubmitting = true;
        var success = await ReviewService.ReportReviewAsync(Review.PublicId, _reportReason, _reportDescription);
        _reportSubmitting = false;

        if (success)
        {
            Toast.ShowSuccess("Zgloszenie zostalo wyslane.");
            _showReportModal = false;
            _reportReason = "";
            _reportDescription = null;
        }
        else
        {
            Toast.ShowError("Nie udalo sie wyslac zgloszenia.");
        }
    }
}
