<div class="filter-section">
    <button type="button" class="filter-section-header @(_expanded ? "expanded" : "")" @onclick="Toggle">
        <span class="filter-section-title">@Title</span>
        @if (ActiveCount > 0)
        {
            <span class="filter-section-count">@ActiveCount</span>
        }
        <i class="fa-solid fa-chevron-down filter-section-chevron"></i>
    </button>
    @if (_expanded)
    {
        <div class="filter-section-content">
            @ChildContent
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = default!;
    [Parameter] public int ActiveCount { get; set; }
    [Parameter] public bool IsExpandedByDefault { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _expanded;

    protected override void OnInitialized() => _expanded = IsExpandedByDefault;

    private void Toggle() => _expanded = !_expanded;
}
