<button class="btn-share-honey" @onclick="Share">
    <i class="fa-solid fa-share-nodes me-2"></i>Udostępnij
</button>

@code {
    [Parameter] public string Url { get; set; } = "";
    [Parameter] public string Title { get; set; } = "";

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private async Task Share()
    {
        await JS.InvokeVoidAsync("navigator.share", new { title = Title, url = Url });
    }
}
