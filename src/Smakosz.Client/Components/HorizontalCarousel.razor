@typeparam TItem
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="carousel-wrapper position-relative">
    <button class="carousel-arrow carousel-arrow-left" @onclick="ScrollLeft" style="@(CanScrollLeft ? "" : "opacity:0;pointer-events:none;")">
        <i class="fa-solid fa-chevron-left"></i>
    </button>
    <div class="carousel-track" id="@_trackId">
        @foreach (var item in Items)
        {
            <div class="carousel-item-wrapper">
                @ChildContent(item)
            </div>
        }
    </div>
    <button class="carousel-arrow carousel-arrow-right" @onclick="ScrollRight" style="@(CanScrollRight ? "" : "opacity:0;pointer-events:none;")">
        <i class="fa-solid fa-chevron-right"></i>
    </button>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<TItem> Items { get; set; } = [];
    [Parameter, EditorRequired] public RenderFragment<TItem> ChildContent { get; set; } = default!;

    private string _trackId = $"carousel-{Guid.NewGuid():N}";
    private DotNetObjectReference<HorizontalCarousel<TItem>>? _selfRef;
    private bool CanScrollLeft;
    private bool CanScrollRight = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("smakoszCarousel.installScrollListener", _trackId, _selfRef);
        }
    }

    private async Task ScrollLeft() => await JS.InvokeVoidAsync("smakoszCarousel.scrollLeft", _trackId);
    private async Task ScrollRight() => await JS.InvokeVoidAsync("smakoszCarousel.scrollRight", _trackId);

    [JSInvokable]
    public Task OnScrollStateChanged(bool canLeft, bool canRight)
    {
        CanScrollLeft = canLeft;
        CanScrollRight = canRight;
        StateHasChanged();
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        if (_selfRef is not null)
        {
            try { await JS.InvokeVoidAsync("smakoszCarousel.uninstallScrollListener", _trackId); } catch { }
            _selfRef.Dispose();
        }
    }
}
