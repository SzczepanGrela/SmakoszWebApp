@typeparam TItem
@inject IJSRuntime JS

<div class="carousel-wrapper position-relative">
    <button class="carousel-arrow carousel-arrow-left" @onclick="ScrollLeft" style="@(CanScrollLeft ? "" : "opacity:0;pointer-events:none;")">
        <i class="fa-solid fa-chevron-left"></i>
    </button>
    <div class="carousel-track" id="@_trackId" @onscroll="OnScroll">
        @foreach (var item in Items)
        {
            <div class="carousel-item-wrapper">
                @ChildContent(item)
            </div>
        }
    </div>
    <button class="carousel-arrow carousel-arrow-right" @onclick="ScrollRight" style="@(CanScrollRight ? "" : "opacity:0;pointer-events:none;")">
        <i class="fa-solid fa-chevron-right"></i>
    </button>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<TItem> Items { get; set; } = [];
    [Parameter, EditorRequired] public RenderFragment<TItem> ChildContent { get; set; } = default!;

    private string _trackId = $"carousel-{Guid.NewGuid():N}";
    private bool CanScrollLeft;
    private bool CanScrollRight = true;

    private async Task ScrollLeft()
    {
        await JS.InvokeVoidAsync("eval", $"document.getElementById('{_trackId}').scrollBy({{left:-600,behavior:'smooth'}})");
    }

    private async Task ScrollRight()
    {
        await JS.InvokeVoidAsync("eval", $"document.getElementById('{_trackId}').scrollBy({{left:600,behavior:'smooth'}})");
    }

    private async Task OnScroll()
    {
        var result = await JS.InvokeAsync<double[]>("eval",
            $"(function(){{var e=document.getElementById('{_trackId}');return [e.scrollLeft,e.scrollWidth,e.clientWidth]}})()");
        if (result is { Length: 3 })
        {
            CanScrollLeft = result[0] > 10;
            CanScrollRight = result[0] < result[1] - result[2] - 10;
        }
    }
}
