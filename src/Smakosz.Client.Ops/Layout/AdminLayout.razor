<ToastContainer />
<ConfirmModalHost />

@code {
    private static readonly string[] DictionaryPaths =
    {
        "/admin/cities",
        "/admin/cuisine-types",
        "/admin/ingredients",
        "/admin/tags",
        "/admin/rejection-reasons"
    };

    private bool _dictOpen;

    protected override void OnInitialized()
    {
        _dictOpen = IsDictionaryActive();
    }

    private string ActiveClass(string href, bool exact = false)
    {
        var uri = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (exact)
            return (uri == "admin" || uri == "admin/") ? "active" : "";
        return Navigation.Uri.Contains(href, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }

    private bool IsDictionaryActive()
    {
        foreach (var path in DictionaryPaths)
        {
            if (Navigation.Uri.Contains(path, StringComparison.OrdinalIgnoreCase))
                return true;
        }
        return false;
    }
}
