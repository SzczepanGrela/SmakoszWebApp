@namespace Smakosz.Client.Ops.Components
@inject IAdminService AdminService

<div class="d-flex flex-column gap-2">
    @if (!_showReject)
    {
        <div class="d-flex gap-2 align-items-center">
            <button class="btn btn-success btn-sm" @onclick="HandleApprove">
                <i class="fa-solid fa-check me-1"></i>Zatwierdź
            </button>
            <button class="btn btn-danger btn-sm" @onclick="OpenReject">
                <i class="fa-solid fa-xmark me-1"></i>Odrzuć
            </button>
        </div>
    }
    else if (string.IsNullOrEmpty(Category))
    {
        <div class="input-group input-group-sm" style="max-width:500px;">
            <input type="text" class="form-control" @bind="_freeTextReason" placeholder="Powód odrzucenia..." />
            <button class="btn btn-danger" @onclick="HandleRejectFreeText">
                <i class="fa-solid fa-xmark me-1"></i>Odrzuć
            </button>
            <button class="btn btn-outline-secondary" @onclick="CancelReject">Anuluj</button>
        </div>
    }
    else
    {
        <div class="card border-danger" style="max-width:600px;">
            <div class="card-body p-3">
                <h6 class="card-title mb-2"><i class="fa-solid fa-xmark text-danger me-1"></i>Odrzucenie</h6>
                @if (_loadingReasons)
                {
                    <div class="text-muted small"><i class="fa-solid fa-spinner fa-spin me-1"></i>Ładowanie powodów...</div>
                }
                else if (_reasons.Count == 0)
                {
                    <div class="alert alert-warning py-2 small mb-2">
                        Brak aktywnych powodów odrzucenia dla kategorii @Category. Dodaj je w <code>/admin/rejection-reasons</code>.
                    </div>
                }
                else
                {
                    <div class="mb-2">
                        <label class="form-label fw-medium small">Wybierz powody</label>
                        <div class="d-flex flex-column gap-1">
                            @foreach (var reason in _reasons)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox"
                                           id="rej-@_instanceId-@reason.ReasonCode"
                                           checked="@_selectedCodes.Contains(reason.ReasonCode)"
                                           @onchange="e => ToggleCode(reason.ReasonCode, (bool)(e.Value ?? false))" />
                                    <label class="form-check-label small" for="rej-@_instanceId-@reason.ReasonCode"
                                           title="@reason.UserMessageTemplate">
                                        @reason.AdminLabel
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                }
                <div class="mb-2">
                    <label class="form-label fw-medium small">Dodatkowa uwaga moderatora (opcjonalnie)</label>
                    <textarea class="form-control form-control-sm" rows="2" maxlength="500"
                              @bind="_moderatorNote"
                              placeholder="Dodaj szczegóły widoczne dla autora..."></textarea>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-danger btn-sm" @onclick="HandleRejectStructured">
                        <i class="fa-solid fa-xmark me-1"></i>Potwierdź odrzucenie
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="CancelReject">Anuluj</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public EventCallback<ModerationActionArgs> OnModerate { get; set; }
    [Parameter] public string? Category { get; set; }

    private readonly string _instanceId = Guid.NewGuid().ToString("N").Substring(0, 8);
    private bool _showReject;
    private string _freeTextReason = "";
    private string _moderatorNote = "";
    private readonly HashSet<string> _selectedCodes = new();
    private List<AdminRejectionReasonDto> _reasons = new();
    private bool _loadingReasons;
    private string? _loadedForCategory;

    private async Task HandleApprove()
    {
        ResetState();
        await OnModerate.InvokeAsync(new ModerationActionArgs("approve", null, Array.Empty<string>(), null));
    }

    private async Task OpenReject()
    {
        _showReject = true;
        if (!string.IsNullOrEmpty(Category) && _loadedForCategory != Category)
        {
            _loadingReasons = true;
            var result = await AdminService.GetRejectionReasonsAsync(1, 100, Category, false);
            _reasons = result?.Data ?? new List<AdminRejectionReasonDto>();
            _loadedForCategory = Category;
            _loadingReasons = false;
        }
    }

    private void CancelReject() => ResetState();

    private void ToggleCode(string code, bool isChecked)
    {
        if (isChecked) _selectedCodes.Add(code);
        else _selectedCodes.Remove(code);
    }

    private async Task HandleRejectFreeText()
    {
        var reason = _freeTextReason;
        ResetState();
        await OnModerate.InvokeAsync(new ModerationActionArgs("reject", reason, Array.Empty<string>(), null));
    }

    private async Task HandleRejectStructured()
    {
        var codes = _selectedCodes.ToArray();
        var note = string.IsNullOrWhiteSpace(_moderatorNote) ? null : _moderatorNote.Trim();
        if (codes.Length == 0 && note is null) return;

        ResetState();
        await OnModerate.InvokeAsync(new ModerationActionArgs("reject", null, codes, note));
    }

    private void ResetState()
    {
        _showReject = false;
        _freeTextReason = "";
        _moderatorNote = "";
        _selectedCodes.Clear();
    }

    public record ModerationActionArgs(
        string Action,
        string? Reason,
        IReadOnlyList<string> ReasonCodes,
        string? ModeratorNote);
}
