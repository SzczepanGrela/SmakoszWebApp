@namespace Smakosz.Client.Ops.Components

<div class="card shadow-sm h-100" style="border-left:4px solid @Color;">
    <div class="card-body d-flex align-items-center gap-3">
        <div class="rounded-circle d-flex align-items-center justify-content-center"
             style="width:48px;height:48px;background:@Color;color:white;font-size:1.2rem;">
            <i class="@Icon"></i>
        </div>
        <div class="flex-grow-1">
            <div class="fs-3 fw-bold">@Value</div>
            <small class="text-muted">@Label</small>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Icon { get; set; } = "fa-solid fa-chart-line";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Value { get; set; } = "0";
    [Parameter] public string Color { get; set; } = "var(--accent-color)";
}
