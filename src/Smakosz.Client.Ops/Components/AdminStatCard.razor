@namespace Smakosz.Client.Ops.Components

<div class="admin-stat-card @(IsClickable ? "is-clickable" : null)">
    <div class="stat-label">@Label</div>
    <div class="stat-num @(Attention ? "is-attention" : null)">@Value</div>
    @if (!string.IsNullOrEmpty(Context))
    {
        <div class="stat-context">@Context</div>
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Value { get; set; } = "0";
    [Parameter] public string? Context { get; set; }
    [Parameter] public bool Attention { get; set; }
    [Parameter] public bool IsClickable { get; set; }
}
