@namespace Smakosz.Client.Ops.Components
@using Smakosz.Client.Models

<div class="card shadow-sm h-100">
    <div class="card-body">
        <div class="mb-3">
            <h6 class="fw-bold mb-1"><i class="fa-solid fa-robot me-2"></i>@Model.ModelType</h6>
            @if (!string.IsNullOrEmpty(Model.ModelVersion))
            {
                <small class="text-muted">v@Model.ModelVersion</small>
            }
        </div>
        <div class="row text-center small">
            <div class="col-6">
                <div class="fw-bold">@Model.UsageCount</div>
                <span class="text-muted">Przetworzone</span>
            </div>
            <div class="col-6">
                <div class="fw-bold">@(Model.LastUsed?.ToString("dd.MM HH:mm") ?? "-")</div>
                <span class="text-muted">Ostatnie</span>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public AdminAiModelDto Model { get; set; } = default!;
}
