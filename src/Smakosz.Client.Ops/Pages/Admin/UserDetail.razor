@page "/admin/users/{Id:int}"
@layout AdminLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject IAdminService AdminService
@inject ToastService Toast

<PageTitle>Użytkownik - Admin Smakosz</PageTitle>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_user == null)
{
    <EmptyState Icon="fa-solid fa-user" Title="Nie znaleziono użytkownika" ActionText="Powrót do listy" ActionUrl="/admin/users" />
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a href="/admin/users" class="btn btn-outline-secondary btn-sm me-2">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <h2 class="fw-bold d-inline">@_user.Username</h2>
        </div>
        <div class="d-flex gap-2">
            @if (_user.Is2faEnabled)
            {
                <button class="btn btn-warning btn-sm" @onclick="HandleDisable2fa">
                    <i class="fa-solid fa-shield-halved me-1"></i>Wyłącz 2FA
                </button>
            }
            <button class="btn btn-secondary btn-sm" @onclick="OpenRoleModal">
                <i class="fa-solid fa-user-tag me-1"></i>Zmień rolę
            </button>
            <button class="btn btn-info btn-sm" @onclick="HandleResetPassword" disabled="@_resetInProgress">
                <i class="fa-solid fa-key me-1"></i>Resetuj hasło
            </button>
            @if (_user.Status == "Banned")
            {
                <button class="btn btn-success btn-sm" @onclick='() => UserAction("unban")'>
                    <i class="fa-solid fa-unlock me-1"></i>Odbanuj
                </button>
            }
            else
            {
                <button class="btn btn-danger btn-sm" @onclick='() => UserAction("ban")'>
                    <i class="fa-solid fa-ban me-1"></i>Zbanuj
                </button>
            }
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm mb-4">
                <div class="card-header"><h5 class="mb-0">Informacje</h5></div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@_user.Email @(_user.EmailVerified ? "(zweryfikowany)" : "(niezweryfikowany)")</dd>

                        <dt class="col-sm-4">Rola</dt>
                        <dd class="col-sm-8"><span class="badge bg-info">@_user.Role</span></dd>

                        <dt class="col-sm-4">2FA</dt>
                        <dd class="col-sm-8">
                            @if (_user.Is2faEnabled) { <span class="badge bg-success">Włączone</span> }
                            else { <span class="badge bg-secondary">Wyłączone</span> }
                        </dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">
                            @if (_user.Status == "Banned") { <span class="badge bg-danger">Zbanowany</span> }
                            else if (_user.Status == "Active") { <span class="badge bg-success">Aktywny</span> }
                            else { <span class="badge bg-secondary">@_user.Status</span> }
                        </dd>

                        <dt class="col-sm-4">Rejestracja</dt>
                        <dd class="col-sm-8">@(_user.CreatedAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <Smakosz.Client.Components.Modal IsOpen="_roleModalOpen" Title="Zmień rolę użytkownika" OnClose="CloseRoleModal">
        <div class="mb-3">
            <label class="form-label fw-medium">Nowa rola</label>
            <select class="form-select" @bind="_newRole">
                <option value="User">User</option>
                <option value="Moderator">Moderator</option>
                <option value="Admin">Admin</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label fw-medium">Uzasadnienie (opcjonalne)</label>
            <textarea class="form-control" rows="3" maxlength="500" @bind="_roleReason" placeholder="Powód zmiany roli, np. promocja na moderatora..."></textarea>
        </div>
        <div class="d-flex justify-content-end gap-2">
            <button class="btn btn-outline-secondary" @onclick="CloseRoleModal">Anuluj</button>
            <button class="btn btn-primary" @onclick="SubmitRoleChange" disabled="@_roleSaving">
                @if (_roleSaving) { <span class="spinner-border spinner-border-sm me-2"></span> }
                Zapisz
            </button>
        </div>
    </Smakosz.Client.Components.Modal>
}

@code {
    [Parameter] public int Id { get; set; }

    private AdminUserDto? _user;
    private bool _loading = true;
    private bool _resetInProgress;

    protected override async Task OnInitializedAsync()
    {
        _user = await AdminService.GetUserAsync(Id);
        _loading = false;
    }

    private async Task UserAction(string action)
    {
        var success = await AdminService.UpdateUserAsync(_user!.PublicId, action);
        if (success)
        {
            Toast.ShowSuccess("Użytkownik zaktualizowany.");
            _user = await AdminService.GetUserAsync(Id);
        }
        else Toast.ShowError("Operacja nieudana.");
    }

    private async Task HandleDisable2fa()
    {
        var success = await AdminService.Disable2faForUserAsync(_user!.PublicId);
        if (success)
        {
            Toast.ShowSuccess("Weryfikacja dwuetapowa wyłączona.");
            _user = await AdminService.GetUserAsync(Id);
        }
        else Toast.ShowError("Nie udało się wyłączyć 2FA.");
    }

    private async Task HandleResetPassword()
    {
        _resetInProgress = true;
        var success = await AdminService.ResetUserPasswordAsync(_user!.PublicId);
        _resetInProgress = false;
        if (success) Toast.ShowSuccess("Link resetujący wysłany na email użytkownika.");
        else Toast.ShowError("Nie udało się wysłać linku resetującego.");
    }

    private bool _roleModalOpen;
    private string _newRole = "User";
    private string _roleReason = "";
    private bool _roleSaving;

    private void OpenRoleModal()
    {
        _newRole = _user?.Role ?? "User";
        _roleReason = "";
        _roleModalOpen = true;
    }

    private void CloseRoleModal() => _roleModalOpen = false;

    private async Task SubmitRoleChange()
    {
        if (_user is null) return;
        _roleSaving = true;
        var success = await AdminService.ChangeUserRoleAsync(_user.PublicId, _newRole, string.IsNullOrWhiteSpace(_roleReason) ? null : _roleReason);
        _roleSaving = false;
        if (success)
        {
            Toast.ShowSuccess("Rola użytkownika zmieniona.");
            _roleModalOpen = false;
            _user = await AdminService.GetUserAsync(Id);
        }
        else
        {
            Toast.ShowError("Nie udało się zmienić roli. Sprawdź czy nie próbujesz zdegradować ostatniego administratora lub zmienić własnej roli.");
        }
    }
}
