@page "/admin/users/{PublicId:guid}"
@layout AdminLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Smakosz.Client.Components
@inject IAdminService AdminService
@inject ToastService Toast
@inject AuthenticationStateProvider AuthState
@inject IConfirmService Confirm

<PageTitle>Użytkownik - Admin Smakosz</PageTitle>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_user == null)
{
    <EmptyState Icon="fa-solid fa-user" Title="Nie znaleziono użytkownika" ActionText="Powrót do listy" ActionUrl="/admin/users" />
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center gap-2">
            <a href="/admin/users" class="btn btn-outline-secondary btn-sm">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <h2 class="fw-bold mb-0">@_user.Username</h2>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            @if (_user.Is2faEnabled)
            {
                <button class="btn btn-warning btn-sm" @onclick="ConfirmDisable2fa">
                    <i class="fa-solid fa-shield-halved me-1"></i>Wyłącz 2FA
                </button>
            }
            <button class="btn btn-secondary btn-sm" @onclick="OpenRoleModal">
                <i class="fa-solid fa-user-tag me-1"></i>Zmień rolę
            </button>
            <button class="btn btn-info btn-sm" @onclick="ConfirmResetPassword" disabled="@_resetInProgress">
                <i class="fa-solid fa-key me-1"></i>Resetuj hasło
            </button>
            @if (_user.IsActive)
            {
                <button class="btn btn-outline-warning btn-sm" @onclick="ConfirmDeactivate">
                    <i class="fa-solid fa-user-slash me-1"></i>Dezaktywuj
                </button>
            }
            else if (!_user.IsBanned)
            {
                <button class="btn btn-outline-success btn-sm" @onclick="ConfirmActivate">
                    <i class="fa-solid fa-user-check me-1"></i>Aktywuj
                </button>
            }
            @if (IsSelfProfile)
            {
                <button class="btn btn-outline-danger btn-sm" disabled title="Nie możesz zbanować własnego konta">
                    <i class="fa-solid fa-ban me-1"></i>Zbanuj
                </button>
            }
            else if (_user.Status == "Banned")
            {
                <button class="btn btn-success btn-sm" @onclick="ConfirmUnban">
                    <i class="fa-solid fa-unlock me-1"></i>Odbanuj
                </button>
            }
            else
            {
                <button class="btn btn-danger btn-sm" @onclick="ConfirmBan">
                    <i class="fa-solid fa-ban me-1"></i>Zbanuj
                </button>
            }
        </div>
    </div>

    <div class="row g-2 mb-3">
        <div class="col"><div class="card text-center p-2"><div class="fw-bold text-warning">@_user.ReviewCount</div><div class="small text-muted">Recenzje</div></div></div>
        <div class="col"><div class="card text-center p-2"><div class="fw-bold text-warning">@_user.FollowersCount</div><div class="small text-muted">Obserwujący</div></div></div>
        <div class="col"><div class="card text-center p-2"><div class="fw-bold text-warning">@_user.FollowingCount</div><div class="small text-muted">Obserwuje</div></div></div>
        <div class="col"><div class="card text-center p-2"><div class="fw-bold text-warning">@_user.PhotoCount</div><div class="small text-muted">Zdjęcia</div></div></div>
        <div class="col"><div class="card text-center p-2"><div class="fw-bold text-warning small">@FormatRelative(_user.LastLoginAt)</div><div class="small text-muted">Ostatnie log.</div></div></div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-header d-flex align-items-center gap-2">
            <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center fw-bold text-warning" style="width:34px;height:34px;font-size:13px">@GetInitials(_user.Username)</div>
            <span class="fw-semibold flex-grow-1">Informacje</span>
            @if (!string.IsNullOrEmpty(_user.Slug))
            {
                <a href="/u/@_user.Slug" target="_blank" class="small text-warning">&#8599; Profil publiczny</a>
            }
        </div>
        <div class="card-body p-0">
            <div class="row g-0">
                <div class="col-md-4 p-3 border-end">
                    <div class="text-uppercase small text-muted fw-bold mb-2">Tożsamość</div>
                    <div class="mb-2">
                        <div class="small text-muted">Email</div>
                        @if (_editingEmail)
                        {
                            <div class="d-flex gap-1">
                                <input type="email" class="form-control form-control-sm" @bind="_emailDraft" @bind:event="oninput" disabled="@_emailSaving" @onkeydown="@(async e => { if (e.Key == "Enter") await SaveEmail(); })" />
                                <button class="btn btn-warning btn-sm" @onclick="SaveEmail" disabled="@_emailSaving">Zapisz</button>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => _editingEmail = false" disabled="@_emailSaving">Anuluj</button>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <span class="text-truncate" style="max-width:220px" title="@_user.Email">@_user.Email</span>
                                <span class="badge @(_user.EmailVerified ? "bg-success" : "bg-secondary")">@(_user.EmailVerified ? "✓" : "?")</span>
                                <button class="btn btn-link btn-sm p-0" title="Zmień email" @onclick="StartEditEmail">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </button>
                            </div>
                        }
                    </div>
                    <div class="mb-2">
                        <div class="small text-muted">Nazwa użytkownika</div>
                        @if (_editingUsername)
                        {
                            <div class="d-flex gap-1">
                                <input type="text" class="form-control form-control-sm" @bind="_usernameDraft" @bind:event="oninput" disabled="@_usernameSaving" @onkeydown="@(async e => { if (e.Key == "Enter") await SaveUsername(); })" />
                                <button class="btn btn-warning btn-sm" @onclick="SaveUsername" disabled="@_usernameSaving">Zapisz</button>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => _editingUsername = false" disabled="@_usernameSaving">Anuluj</button>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex align-items-center gap-2">
                                <span>@_user.Username</span>
                                <button class="btn btn-link btn-sm p-0" title="Zmień nazwę użytkownika" @onclick="StartEditUsername">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </button>
                            </div>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(_user.FirstName) || !string.IsNullOrEmpty(_user.LastName))
                    {
                        <div class="mb-2">
                            <div class="small text-muted">Pełne imię</div>
                            <div class="text-muted">@_user.FirstName @_user.LastName</div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(_user.Slug))
                    {
                        <div class="mb-2">
                            <div class="small text-muted">Slug</div>
                            <div class="small text-muted">@_user.Slug</div>
                        </div>
                    }
                </div>

                <div class="col-md-4 p-3 border-end">
                    <div class="text-uppercase small text-muted fw-bold mb-2">Konto</div>
                    <div class="mb-2"><div class="small text-muted">Rola</div><span class="badge bg-info">@_user.Role</span></div>
                    <div class="mb-2">
                        <div class="small text-muted">Status</div>
                        @if (_user.Status == "Banned") { <span class="badge bg-danger">Zbanowany</span> }
                        else if (_user.Status == "Active") { <span class="badge bg-success">Aktywny</span> }
                        else { <span class="badge bg-secondary">Nieaktywny</span> }
                    </div>
                    <div class="mb-2"><div class="small text-muted">Weryfikacja email</div><span class="badge @(_user.EmailVerified ? "bg-success" : "bg-secondary")">@(_user.EmailVerified ? "Zweryfikowany" : "Niezweryfikowany")</span></div>
                    <div class="mb-2"><div class="small text-muted">2FA</div><span class="badge @(_user.Is2faEnabled ? "bg-success" : "bg-secondary")">@(_user.Is2faEnabled ? "Włączone" : "Wyłączone")</span></div>
                    <div class="mb-2"><div class="small text-muted">Rejestracja</div><div>@(_user.CreatedAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</div></div>
                </div>

                <div class="col-md-4 p-3">
                    <div class="text-uppercase small text-muted fw-bold mb-2">Aktywność i bezpieczeństwo</div>
                    <div class="mb-2"><div class="small text-muted">Ostatnie logowanie</div><div>@(_user.LastLoginAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</div></div>
                    <div class="mb-2">
                        <div class="small text-muted">Błędne logowania</div>
                        <div>@_user.FailedLoginCount</div>
                    </div>
                    @if (_user.LockedUntilUtc.HasValue && _user.LockedUntilUtc.Value > DateTime.UtcNow)
                    {
                        <div class="mb-2">
                            <span class="badge bg-danger">Zablokowane</span>
                            <div class="small text-danger">do @_user.LockedUntilUtc.Value.ToLocalTime().ToString("dd.MM HH:mm") · @_user.FailedLoginCount prób</div>
                        </div>
                    }
                    <div class="mb-2"><div class="small text-muted">Zdjęcia w systemie</div><div>@_user.PhotoCount</div></div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-2">
        <div class="card-header d-flex justify-content-between align-items-center" role="button" @onclick="ToggleReviews" style="cursor:pointer">
            <div><i class="fa-solid fa-comment-dots me-2"></i>Recenzje <span class="badge bg-warning ms-1">@_user.ReviewCount</span></div>
            <i class="fa-solid @(_openReviews ? "fa-chevron-up" : "fa-chevron-down")"></i>
        </div>
        @if (_openReviews)
        {
            <div class="card-body">
                @if (_loadErrorReviews)
                {
                    <div class="text-center text-danger small py-2">
                        Nie udało się załadować danych.
                        <a href="javascript:void(0)" @onclick="() => LoadReviews(true)" class="text-warning">Spróbuj ponownie</a>
                    </div>
                }
                else if (!_loadedReviews)
                {
                    <div class="text-center py-2"><div class="spinner-border spinner-border-sm text-warning" role="status"></div></div>
                }
                else if (_reviewItems.Count == 0)
                {
                    <div class="text-center text-muted small py-2">Brak recenzji.</div>
                }
                else
                {
                    @foreach (var r in _reviewItems)
                    {
                        <div class="d-flex justify-content-between align-items-center border-bottom py-1 small">
                            <a href="/admin/dishes/@r.DishPublicId" class="text-decoration-none flex-grow-1 text-truncate">
                                @r.DishName <span class="text-muted">— @r.RestaurantName</span>
                            </a>
                            <span class="badge bg-warning mx-2">@r.DishRating★</span>
                            <span class="badge @(r.ModerationStatus == "Approved" ? "bg-success" : "bg-secondary")">@r.ModerationStatus</span>
                            <span class="text-muted ms-2">@FormatRelative(r.CreatedAt)</span>
                        </div>
                    }
                    @if (_pageReviews < _totalPagesReviews)
                    {
                        <div class="text-center mt-2">
                            <button class="btn btn-link btn-sm text-warning" @onclick="LoadMoreReviews">Załaduj więcej</button>
                        </div>
                    }
                }
            </div>
        }
    </div>

    <div class="card mb-2">
        <div class="card-header d-flex justify-content-between align-items-center" role="button" @onclick="ToggleSecurityLogs" style="cursor:pointer">
            <div><i class="fa-solid fa-shield-halved me-2"></i>Historia logowań</div>
            <i class="fa-solid @(_openSecurityLogs ? "fa-chevron-up" : "fa-chevron-down")"></i>
        </div>
        @if (_openSecurityLogs)
        {
            <div class="card-body">
                @if (_loadErrorSecurityLogs)
                {
                    <div class="text-center text-danger small py-2">
                        Nie udało się załadować danych.
                        <a href="javascript:void(0)" @onclick="() => LoadSecurityLogs(true)" class="text-warning">Spróbuj ponownie</a>
                    </div>
                }
                else if (!_loadedSecurityLogs)
                {
                    <div class="text-center py-2"><div class="spinner-border spinner-border-sm text-warning" role="status"></div></div>
                }
                else if (_securityLogItems.Count == 0)
                {
                    <div class="text-center text-muted small py-2">Brak historii logowań.</div>
                }
                else
                {
                    @foreach (var s in _securityLogItems)
                    {
                        <div class="d-flex justify-content-between align-items-center border-bottom py-1 small">
                            <span class="flex-grow-1">@TranslateEventType(s.EventType)</span>
                            <span class="text-muted mx-2">@s.IpAddress @s.City @s.CountryCode</span>
                            <span class="text-muted">@FormatRelative(s.CreatedAt)</span>
                        </div>
                    }
                    @if (_pageSecurityLogs < _totalPagesSecurityLogs)
                    {
                        <div class="text-center mt-2">
                            <button class="btn btn-link btn-sm text-warning" @onclick="LoadMoreSecurityLogs">Załaduj więcej</button>
                        </div>
                    }
                }
            </div>
        }
    </div>

    <div class="card mb-2">
        <div class="card-header d-flex justify-content-between align-items-center" role="button" @onclick="TogglePhotos" style="cursor:pointer">
            <div><i class="fa-solid fa-image me-2"></i>Zdjęcia <span class="badge bg-warning ms-1">@_user.PhotoCount</span></div>
            <i class="fa-solid @(_openPhotos ? "fa-chevron-up" : "fa-chevron-down")"></i>
        </div>
        @if (_openPhotos)
        {
            <div class="card-body">
                @if (_loadErrorPhotos)
                {
                    <div class="text-center text-danger small py-2">
                        Nie udało się załadować danych.
                        <a href="javascript:void(0)" @onclick="() => LoadPhotos(true)" class="text-warning">Spróbuj ponownie</a>
                    </div>
                }
                else if (!_loadedPhotos)
                {
                    <div class="text-center py-2"><div class="spinner-border spinner-border-sm text-warning" role="status"></div></div>
                }
                else if (_photoItems.Count == 0)
                {
                    <div class="text-center text-muted small py-2">Brak zdjęć.</div>
                }
                else
                {
                    @foreach (var p in _photoItems)
                    {
                        <div class="d-flex align-items-center gap-2 border-bottom py-1 small">
                            <img src="@p.Url" style="width:40px;height:40px;object-fit:cover;border-radius:4px" alt="" />
                            <span class="badge bg-secondary">@p.EntityType</span>
                            @if (!string.IsNullOrEmpty(p.Status))
                            {
                                <span class="badge @(p.Status == "Approved" ? "bg-success" : "bg-secondary")">@p.Status</span>
                            }
                            <span class="text-muted ms-auto">@FormatRelative(p.CreatedAt)</span>
                        </div>
                    }
                    @if (_pagePhotos < _totalPagesPhotos)
                    {
                        <div class="text-center mt-2">
                            <button class="btn btn-link btn-sm text-warning" @onclick="LoadMorePhotos">Załaduj więcej</button>
                        </div>
                    }
                }
            </div>
        }
    </div>

    <div class="card mb-2">
        <div class="card-header d-flex justify-content-between align-items-center" role="button" @onclick="ToggleTickets" style="cursor:pointer">
            <div><i class="fa-solid fa-ticket me-2"></i>Tickety</div>
            <i class="fa-solid @(_openTickets ? "fa-chevron-up" : "fa-chevron-down")"></i>
        </div>
        @if (_openTickets)
        {
            <div class="card-body">
                @if (_loadErrorTickets)
                {
                    <div class="text-center text-danger small py-2">
                        Nie udało się załadować danych.
                        <a href="javascript:void(0)" @onclick="() => LoadTickets(true)" class="text-warning">Spróbuj ponownie</a>
                    </div>
                }
                else if (!_loadedTickets)
                {
                    <div class="text-center py-2"><div class="spinner-border spinner-border-sm text-warning" role="status"></div></div>
                }
                else if (_ticketItems.Count == 0)
                {
                    <div class="text-center text-muted small py-2">Brak ticketów.</div>
                }
                else
                {
                    @foreach (var t in _ticketItems)
                    {
                        <div class="d-flex justify-content-between align-items-center border-bottom py-1 small">
                            <a href="/admin/tickets/@t.TicketId" class="text-decoration-none flex-grow-1 text-truncate">@t.TicketType</a>
                            <span class="badge bg-secondary mx-2">@t.Status</span>
                            <span class="text-muted text-truncate" style="max-width:120px">@Truncate(t.Description, 50)</span>
                            <span class="text-muted ms-2">@FormatRelative(t.CreatedAt)</span>
                        </div>
                    }
                    @if (_pageTickets < _totalPagesTickets)
                    {
                        <div class="text-center mt-2">
                            <button class="btn btn-link btn-sm text-warning" @onclick="LoadMoreTickets">Załaduj więcej</button>
                        </div>
                    }
                }
            </div>
        }
    </div>

    <div class="card mb-2">
        <div class="card-header d-flex justify-content-between align-items-center" role="button" @onclick="ToggleActionLogs" style="cursor:pointer">
            <div><i class="fa-solid fa-clock-rotate-left me-2"></i>Historia akcji admina</div>
            <i class="fa-solid @(_openActionLogs ? "fa-chevron-up" : "fa-chevron-down")"></i>
        </div>
        @if (_openActionLogs)
        {
            <div class="card-body">
                @if (_loadErrorActionLogs)
                {
                    <div class="text-center text-danger small py-2">
                        Nie udało się załadować danych.
                        <a href="javascript:void(0)" @onclick="() => LoadActionLogs(true)" class="text-warning">Spróbuj ponownie</a>
                    </div>
                }
                else if (!_loadedActionLogs)
                {
                    <div class="text-center py-2"><div class="spinner-border spinner-border-sm text-warning" role="status"></div></div>
                }
                else if (_actionLogItems.Count == 0)
                {
                    <div class="text-center text-muted small py-2">Brak historii akcji.</div>
                }
                else
                {
                    @foreach (var l in _actionLogItems)
                    {
                        <div class="d-flex justify-content-between align-items-center border-bottom py-1 small">
                            <span class="flex-grow-1">@TranslateActionType(l.ActionType)</span>
                            @if (!string.IsNullOrEmpty(l.OldValue) && !string.IsNullOrEmpty(l.NewValue))
                            {
                                <span class="text-muted mx-2">@l.OldValue &#8594; @l.NewValue</span>
                            }
                            else if (!string.IsNullOrEmpty(l.OldValue))
                            {
                                <span class="text-muted mx-2">@l.OldValue</span>
                            }
                            else if (!string.IsNullOrEmpty(l.NewValue))
                            {
                                <span class="text-muted mx-2">@l.NewValue</span>
                            }
                            <span class="text-muted mx-2">@(l.ActorUsername ?? "system")</span>
                            @if (!string.IsNullOrEmpty(l.Reason))
                            {
                                <span class="text-muted fst-italic mx-1">@l.Reason</span>
                            }
                            <span class="text-muted">@FormatRelative(l.CreatedAt)</span>
                        </div>
                    }
                    @if (_pageActionLogs < _totalPagesActionLogs)
                    {
                        <div class="text-center mt-2">
                            <button class="btn btn-link btn-sm text-warning" @onclick="LoadMoreActionLogs">Załaduj więcej</button>
                        </div>
                    }
                }
            </div>
        }
    </div>

    <div class="card mb-2">
        <div class="card-header d-flex justify-content-between align-items-center" role="button" @onclick="ToggleFollowers" style="cursor:pointer">
            <div><i class="fa-solid fa-users me-2"></i>Obserwujący <span class="badge bg-warning ms-1">@_user.FollowersCount</span></div>
            <i class="fa-solid @(_openFollowers ? "fa-chevron-up" : "fa-chevron-down")"></i>
        </div>
        @if (_openFollowers)
        {
            <div class="card-body">
                @if (_loadErrorFollowers)
                {
                    <div class="text-center text-danger small py-2">
                        Nie udało się załadować danych.
                        <a href="javascript:void(0)" @onclick="() => LoadFollowers(true)" class="text-warning">Spróbuj ponownie</a>
                    </div>
                }
                else if (!_loadedFollowers)
                {
                    <div class="text-center py-2"><div class="spinner-border spinner-border-sm text-warning" role="status"></div></div>
                }
                else if (_followerItems.Count == 0)
                {
                    <div class="text-center text-muted small py-2">Brak obserwujących.</div>
                }
                else
                {
                    @foreach (var f in _followerItems)
                    {
                        <div class="d-flex align-items-center gap-2 border-bottom py-1 small">
                            @if (!string.IsNullOrEmpty(f.AvatarUrl))
                            {
                                <img src="@f.AvatarUrl" style="width:24px;height:24px;object-fit:cover;border-radius:50%" alt="" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center fw-bold text-warning" style="width:24px;height:24px;font-size:10px">@GetInitials(f.Username)</div>
                            }
                            <a href="/admin/users/@f.PublicId" class="text-decoration-none flex-grow-1">@f.Username</a>
                            <span class="text-muted">@FormatRelative(f.FollowedAt)</span>
                        </div>
                    }
                    @if (_pageFollowers < _totalPagesFollowers)
                    {
                        <div class="text-center mt-2">
                            <button class="btn btn-link btn-sm text-warning" @onclick="LoadMoreFollowers">Załaduj więcej</button>
                        </div>
                    }
                }
            </div>
        }
    </div>

    <div class="card mb-2">
        <div class="card-header d-flex justify-content-between align-items-center" role="button" @onclick="ToggleClaims" style="cursor:pointer">
            <div><i class="fa-solid fa-utensils me-2"></i>Claims restauracji</div>
            <i class="fa-solid @(_openClaims ? "fa-chevron-up" : "fa-chevron-down")"></i>
        </div>
        @if (_openClaims)
        {
            <div class="card-body">
                @if (_loadErrorClaims)
                {
                    <div class="text-center text-danger small py-2">
                        Nie udało się załadować danych.
                        <a href="javascript:void(0)" @onclick="() => LoadClaims(true)" class="text-warning">Spróbuj ponownie</a>
                    </div>
                }
                else if (!_loadedClaims)
                {
                    <div class="text-center py-2"><div class="spinner-border spinner-border-sm text-warning" role="status"></div></div>
                }
                else if (_claimItems.Count == 0)
                {
                    <div class="text-center text-muted small py-2">Brak claimów restauracji.</div>
                }
                else
                {
                    @foreach (var c in _claimItems)
                    {
                        <div class="d-flex justify-content-between align-items-center border-bottom py-1 small">
                            <a href="/admin/restaurants/by-id/@c.RestaurantId" class="text-decoration-none flex-grow-1 text-truncate">@c.RestaurantName</a>
                            <span class="badge bg-secondary mx-2">@c.Status</span>
                            <span class="text-muted">@FormatRelative(c.CreatedAt)</span>
                        </div>
                    }
                    @if (_pageClaims < _totalPagesClaims)
                    {
                        <div class="text-center mt-2">
                            <button class="btn btn-link btn-sm text-warning" @onclick="LoadMoreClaims">Załaduj więcej</button>
                        </div>
                    }
                }
            </div>
        }
    </div>

    <Smakosz.Client.Components.Modal IsOpen="_roleModalOpen" Title="Zmień rolę użytkownika" OnClose="CloseRoleModal">
        <div class="mb-3">
            <label class="form-label fw-medium">Nowa rola</label>
            <select class="form-select" @bind="_newRole">
                <option value="User">User</option>
                <option value="Moderator">Moderator</option>
                <option value="Admin">Admin</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label fw-medium">Uzasadnienie (opcjonalne)</label>
            <textarea class="form-control" rows="3" maxlength="500" @bind="_roleReason" placeholder="Powód zmiany roli, np. promocja na moderatora..."></textarea>
        </div>
        <div class="d-flex justify-content-end gap-2">
            <button class="btn btn-outline-secondary" @onclick="CloseRoleModal">Anuluj</button>
            <button class="btn btn-primary" @onclick="SubmitRoleChange" disabled="@_roleSaving">
                @if (_roleSaving) { <span class="spinner-border spinner-border-sm me-2"></span> }
                Zapisz
            </button>
        </div>
    </Smakosz.Client.Components.Modal>
}

