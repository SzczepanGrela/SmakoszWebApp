    private static string GetInitials(string username)
    {
        if (string.IsNullOrEmpty(username)) return "?";
        return username.Length >= 2
            ? username[..2].ToUpperInvariant()
            : username[..1].ToUpperInvariant();
    }

    private static string FormatRelative(DateTime? when)
    {
        if (when is null) return "-";
        var diff = DateTime.UtcNow - when.Value.ToUniversalTime();
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes} min temu";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h temu";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}d temu";
        return when.Value.ToLocalTime().ToString("dd.MM.yyyy");
    }

    private static string TranslateActionType(string code) => code switch
    {
        "ban" => "Zbanowany",
        "unban" => "Odbanowany",
        "role_change" => "Zmiana roli",
        "deactivate" => "Dezaktywowany",
        "activate" => "Aktywowany",
        "email_change" => "Zmiana emaila",
        "username_change" => "Zmiana nazwy użytkownika",
        _ => code
    };

    private static string TranslateEventType(string? code) => code switch
    {
        "FailedLogin" => "Nieudane logowanie",
        "PasswordReset" => "Reset hasła",
        "PasswordChanged" => "Zmiana hasła",
        "TwoFactorEnabled" => "Włączenie 2FA",
        "TwoFactorDisabled" => "Wyłączenie 2FA",
        "TwoFactorDisabledByAdmin" => "Wyłączenie 2FA przez admina",
        "PasswordResetByAdmin" => "Reset hasła przez admina",
        "RoleChanged" => "Zmiana roli",
        "AccountInvited" => "Zaproszenie do konta",
        "AccountDeleted" => "Usunięcie konta",
        "BlockedIp" => "Zablokowany IP",
        "SuspiciousActivity" => "Podejrzana aktywność",
        "BannedRegistration" => "Zbanowana rejestracja",
        null => "(brak)",
        _ => code
    };

    private static string Truncate(string? s, int max)
    {
        if (string.IsNullOrEmpty(s)) return "";
        return s.Length <= max ? s : s[..max] + "...";
    }
