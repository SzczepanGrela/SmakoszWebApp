@page "/admin/email-logs"
@layout AdminLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject IAdminService AdminService

<PageTitle>Logi email - Admin Smakosz</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="fa-solid fa-envelope me-2"></i>Logi email</h2>
</div>

<div class="d-flex flex-wrap gap-3 mb-3">
    <div>
        <div class="small text-muted mb-1">Status</div>
        <div class="btn-group btn-group-sm">
            <button class="btn @(_statusFilter == null ? "btn-primary" : "btn-outline-primary")" @onclick="() => FilterByStatus(null)">Wszystkie</button>
            <button class="btn @(_statusFilter == "sent" ? "btn-success" : "btn-outline-success")" @onclick='() => FilterByStatus("sent")'>Sent</button>
            <button class="btn @(_statusFilter == "failed" ? "btn-danger" : "btn-outline-danger")" @onclick='() => FilterByStatus("failed")'>Failed</button>
            <button class="btn @(_statusFilter == "pending" ? "btn-warning" : "btn-outline-warning")" @onclick='() => FilterByStatus("pending")'>Pending</button>
        </div>
    </div>
    <div>
        <div class="small text-muted mb-1">Typ</div>
        <div class="btn-group btn-group-sm">
            <button class="btn @(_typeFilter == null ? "btn-primary" : "btn-outline-primary")" @onclick="() => FilterByType(null)">Wszystkie</button>
            <button class="btn @(_typeFilter == "Verification" ? "btn-primary" : "btn-outline-primary")" @onclick='() => FilterByType("Verification")'>Verification</button>
            <button class="btn @(_typeFilter == "TwoFactorAuth" ? "btn-primary" : "btn-outline-primary")" @onclick='() => FilterByType("TwoFactorAuth")'>TwoFactorAuth</button>
            <button class="btn @(_typeFilter == "PasswordReset" ? "btn-primary" : "btn-outline-primary")" @onclick='() => FilterByType("PasswordReset")'>PasswordReset</button>
        </div>
    </div>
</div>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_logs == null || !_logs.Data.Any())
{
    <EmptyState Icon="fa-solid fa-envelope" Title="Brak logow email" />
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-hover" style="font-size:0.85rem;">
            <thead>
                <tr>
                    <th style="width:160px;">Czas</th>
                    <th style="width:140px;">Typ</th>
                    <th>Odbiorca</th>
                    <th>Temat</th>
                    <th style="width:100px;">Status</th>
                    <th style="width:100px;">Provider</th>
                    <th>Blad</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in _logs.Data)
                {
                    <tr>
                        <td class="text-muted">@log.CreatedAt?.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td><span class="badge bg-secondary">@log.Type</span></td>
                        <td>@log.Recipient</td>
                        <td class="text-truncate" style="max-width:260px;" title="@log.Subject">@log.Subject</td>
                        <td><span class="badge @StatusBadge(log.Status)">@log.Status</span></td>
                        <td class="text-muted">@log.Provider</td>
                        <td>
                            @if (!string.IsNullOrEmpty(log.ErrorMessage))
                            {
                                <details>
                                    <summary class="small text-danger">Szczegoly</summary>
                                    <pre class="small mb-0" style="max-height:200px;overflow:auto;">@log.ErrorMessage</pre>
                                </details>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_logs.Pagination.TotalPages > 1)
    {
        <Pagination Info="@_logs.Pagination" OnPageChange="LoadPage" />
    }
}

@code {
    private PagedResult<AdminEmailLogDto>? _logs;
    private string? _statusFilter;
    private string? _typeFilter;
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadPage(1);

    private async Task LoadPage(int page)
    {
        _loading = true;
        _logs = await AdminService.GetEmailLogsAsync(page, _statusFilter, _typeFilter);
        _loading = false;
    }

    private async Task FilterByStatus(string? status) { _statusFilter = status; await LoadPage(1); }
    private async Task FilterByType(string? type) { _typeFilter = type; await LoadPage(1); }

    private static string StatusBadge(string? status) => status switch
    {
        "sent" => "bg-success",
        "failed" => "bg-danger",
        "pending" => "bg-warning text-dark",
        _ => "bg-secondary"
    };
}
