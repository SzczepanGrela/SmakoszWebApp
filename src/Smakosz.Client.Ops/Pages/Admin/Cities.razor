@page "/admin/cities"
@layout AdminLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject IAdminService AdminService
@inject ToastService Toast
@inject IConfirmService Confirm

<PageTitle>Miasta - Admin Smakosz</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="fa-solid fa-city me-2"></i>Miasta</h2>
    <button class="btn btn-primary btn-sm" @onclick="ShowAddForm">
        <i class="fa-solid fa-plus me-1"></i>Dodaj miasto
    </button>
</div>

@if (_showForm)
{
    <div class="card shadow-sm mb-4">
        <div class="card-header"><h5 class="mb-0">@(_editingId.HasValue ? "Edytuj" : "Nowe") miasto</h5></div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-medium">Nazwa *</label>
                    <input type="text" class="form-control" @bind="_form.CityName" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-medium">Region</label>
                    <input type="text" class="form-control" @bind="_form.Region" />
                </div>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-primary btn-sm" @onclick="SaveCity">
                    <i class="fa-solid fa-floppy-disk me-1"></i>Zapisz
                </button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="CancelForm">Anuluj</button>
            </div>
        </div>
    </div>
}

@if (_loading)
{
    <LoadingSpinner />
}
else if (_cities == null || !_cities.Data.Any())
{
    <EmptyState Icon="fa-solid fa-city" Title="Brak miast" />
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr><th>Miasto</th><th>Region</th><th>Restauracje</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var city in _cities.Data)
                {
                    <tr>
                        <td class="fw-medium">@city.CityName</td>
                        <td>@(city.Region ?? "-")</td>
                        <td>@city.RestaurantCount</td>
                        <td class="text-end">
                            <button class="btn btn-outline-primary btn-sm me-1" @onclick="() => EditCity(city)">
                                <i class="fa-solid fa-pen"></i>
                            </button>
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteCity(city)" disabled="@(city.RestaurantCount > 0)" title="@(city.RestaurantCount > 0 ? "Nie można usunąć, miasto ma przypisane restauracje" : "Usuń")">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_cities.Pagination.TotalPages > 1)
    {
        <Pagination Info="@_cities.Pagination" OnPageChange="LoadPage" />
    }
}

@code {
    private PagedResult<AdminCityDto>? _cities;
    private bool _loading = true;
    private bool _showForm;
    private int? _editingId;
    private AdminCityDto _form = new();

    protected override async Task OnInitializedAsync() => await LoadPage(1);

    private async Task LoadPage(int page)
    {
        _loading = true;
        _cities = await AdminService.GetCitiesAsync(page);
        _loading = false;
    }

    private void ShowAddForm() { _form = new(); _editingId = null; _showForm = true; }
    private void EditCity(AdminCityDto city) { _form = new() { Id = city.Id, CityName = city.CityName, Region = city.Region }; _editingId = city.Id; _showForm = true; }
    private void CancelForm() { _showForm = false; _editingId = null; }

    private async Task SaveCity()
    {
        if (string.IsNullOrWhiteSpace(_form.CityName)) return;
        bool success;
        if (_editingId.HasValue)
            success = await AdminService.UpdateCityAsync(_editingId.Value, _form);
        else
            success = await AdminService.CreateCityAsync(_form);

        if (success) { Toast.ShowSuccess("Miasto zapisane."); _showForm = false; await LoadPage(1); }
        else Toast.ShowError("Nie udało się zapisać.");
    }

    private async Task DeleteCity(AdminCityDto city)
    {
        if (!await Confirm.AskAsync($"Czy na pewno chcesz usunąć miasto {city.CityName}?")) return;
        var success = await AdminService.DeleteCityAsync(city.Id);
        if (success) { Toast.ShowSuccess("Miasto usunięte."); await LoadPage(1); }
        else Toast.ShowError("Nie udało się usunąć miasta.");
    }
}
