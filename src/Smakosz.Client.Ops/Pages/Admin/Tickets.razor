@page "/admin/tickets"
@layout AdminLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "admin")]
@inject IAdminService AdminService
@inject ToastService Toast

<PageTitle>Zgloszenia - Admin Smakosz</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="fa-solid fa-ticket me-2"></i>Zgloszenia</h2>
    <div class="btn-group btn-group-sm">
        <button class="btn @(_statusFilter == null ? "btn-primary" : "btn-outline-primary")" @onclick="() => FilterByStatus(null)">Wszystkie</button>
        <button class="btn @(_statusFilter == "open" ? "btn-primary" : "btn-outline-primary")" @onclick='() => FilterByStatus("open")'>Otwarte</button>
        <button class="btn @(_statusFilter == "in_progress" ? "btn-primary" : "btn-outline-primary")" @onclick='() => FilterByStatus("in_progress")'>W toku</button>
        <button class="btn @(_statusFilter == "resolved" ? "btn-primary" : "btn-outline-primary")" @onclick='() => FilterByStatus("resolved")'>Rozwiazane</button>
    </div>
</div>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_tickets == null || !_tickets.Data.Any())
{
    <EmptyState Icon="fa-solid fa-ticket" Title="Brak zgloszen" />
}
else
{
    @foreach (var ticket in _tickets.Data)
    {
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h6 class="fw-bold mb-1">@ticket.Subject</h6>
                        <p class="text-muted small mb-2">@ticket.Description</p>
                        <div class="d-flex gap-3 small text-muted">
                            <span><i class="fa-solid fa-user me-1"></i>@ticket.CreatedBy</span>
                            <span><i class="fa-solid fa-calendar me-1"></i>@ticket.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                            @if (ticket.AssignedTo != null)
                            {
                                <span><i class="fa-solid fa-user-check me-1"></i>@ticket.AssignedTo</span>
                            }
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge @PriorityBadge(ticket.Priority)">@ticket.Priority</span>
                        <StatusBadge Status="@ticket.Status" />
                    </div>
                </div>
                @if (ticket.Status != "resolved")
                {
                    <div class="mt-3 d-flex gap-2">
                        @if (ticket.Status == "open")
                        {
                            <button class="btn btn-outline-primary btn-sm" @onclick="() => StartTicket(ticket.Id)">
                                <i class="fa-solid fa-play me-1"></i>Rozpocznij
                            </button>
                        }
                        <button class="btn btn-success btn-sm" @onclick="() => ResolveTicket(ticket.Id)">
                            <i class="fa-solid fa-check me-1"></i>Rozwiaz
                        </button>
                    </div>
                }
            </div>
        </div>
    }

    @if (_tickets.Pagination.TotalPages > 1)
    {
        <Pagination Info="@_tickets.Pagination" OnPageChange="LoadPage" />
    }
}

@code {
    private PagedResult<AdminTicketDto>? _tickets;
    private string? _statusFilter;
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadPage(1);

    private async Task LoadPage(int page)
    {
        _loading = true;
        _tickets = await AdminService.GetTicketsAsync(page, _statusFilter);
        _loading = false;
    }

    private async Task FilterByStatus(string? status) { _statusFilter = status; await LoadPage(1); }

    private Task StartTicket(int id) => UpdateStatus(id, "in_progress");
    private Task ResolveTicket(int id) => UpdateStatus(id, "resolved");

    private async Task UpdateStatus(int id, string status)
    {
        var success = await AdminService.UpdateTicketStatusAsync(id, status);
        if (success) { Toast.ShowSuccess("Status zaktualizowany."); await LoadPage(1); }
        else Toast.ShowError("Nie udalo sie zaktualizowac.");
    }

    private static string PriorityBadge(string priority) => priority?.ToLower() switch
    {
        "high" or "critical" => "bg-danger",
        "medium" => "bg-warning text-dark",
        _ => "bg-secondary"
    };
}
