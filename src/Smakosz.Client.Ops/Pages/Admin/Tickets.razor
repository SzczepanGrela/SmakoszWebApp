@page "/admin/tickets"
@layout AdminLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "admin")]
@inject IAdminService AdminService
@inject ToastService Toast

<PageTitle>Zgloszenia - Admin Smakosz</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold mb-0"><i class="fa-solid fa-ticket me-2"></i>Zgloszenia</h2>
    <div class="btn-group btn-group-sm">
        <button class="btn @(_statusFilter == null ? "btn-primary" : "btn-outline-primary")" @onclick="() => FilterByStatus(null)">Wszystkie</button>
        <button class="btn @(_statusFilter == "Open" ? "btn-primary" : "btn-outline-primary")" @onclick='() => FilterByStatus("Open")'>Otwarte</button>
        <button class="btn @(_statusFilter == "InProgress" ? "btn-primary" : "btn-outline-primary")" @onclick='() => FilterByStatus("InProgress")'>W toku</button>
        <button class="btn @(_statusFilter == "Resolved" ? "btn-primary" : "btn-outline-primary")" @onclick='() => FilterByStatus("Resolved")'>Rozwiązane</button>
    </div>
</div>
<div class="d-flex gap-2 flex-wrap mb-4">
    <small class="text-muted me-1 align-self-center">Typ:</small>
    <button class="btn btn-sm @(_ticketTypeFilter == null ? "btn-secondary" : "btn-outline-secondary")" @onclick="() => FilterByTicketType(null)">Wszystkie</button>
    <button class="btn btn-sm @(_ticketTypeFilter == "Contact" ? "btn-secondary" : "btn-outline-secondary")" @onclick='() => FilterByTicketType("Contact")'>Kontakt</button>
    <button class="btn btn-sm @(_ticketTypeFilter == "Photo" ? "btn-secondary" : "btn-outline-secondary")" @onclick='() => FilterByTicketType("Photo")'>Zdjęcie</button>
    <button class="btn btn-sm @(_ticketTypeFilter == "ReviewContent" ? "btn-secondary" : "btn-outline-secondary")" @onclick='() => FilterByTicketType("ReviewContent")'>Recenzja</button>
    <button class="btn btn-sm @(_ticketTypeFilter == "Report" ? "btn-secondary" : "btn-outline-secondary")" @onclick='() => FilterByTicketType("Report")'>Zgloszenie</button>
    <button class="btn btn-sm @(_ticketTypeFilter == "EditRequest" ? "btn-secondary" : "btn-outline-secondary")" @onclick='() => FilterByTicketType("EditRequest")'>Edycja</button>
    <button class="btn btn-sm @(_ticketTypeFilter == "IngredientSuggestion" ? "btn-secondary" : "btn-outline-secondary")" @onclick='() => FilterByTicketType("IngredientSuggestion")'>Skladnik</button>
    <button class="btn btn-sm @(_ticketTypeFilter == "DataCorrection" ? "btn-secondary" : "btn-outline-secondary")" @onclick='() => FilterByTicketType("DataCorrection")'>Korekta</button>
</div>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_tickets == null || !_tickets.Data.Any())
{
    <EmptyState Icon="fa-solid fa-ticket" Title="Brak zgloszen" />
}
else
{
    @foreach (var ticket in _tickets.Data)
    {
        <a href="/admin/tickets/@ticket.TicketId" class="card shadow-sm mb-3 text-decoration-none" style="color:inherit; display:block;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="flex-grow-1 me-3">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <h6 class="fw-bold mb-0">#@ticket.TicketId</h6>
                            <span class="badge bg-info">@TicketTypeLabel(ticket.TicketType)</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(ticket.Description))
                        {
                            <p class="text-muted small mb-2 text-break" style="white-space:pre-line;">@Truncate(ticket.Description, 300)</p>
                        }
                        <div class="d-flex gap-3 small text-muted">
                            <span><i class="fa-solid fa-calendar me-1"></i>@(ticket.CreatedAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</span>
                            @if (ticket.AssignedAdminUsername != null)
                            {
                                <span><i class="fa-solid fa-user-check me-1"></i>@ticket.AssignedAdminUsername</span>
                            }
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge @PriorityBadge(ticket.Priority)">P@ticket.Priority</span>
                        <StatusBadge Status="@ticket.Status" />
                    </div>
                </div>
                <div class="mt-3 d-flex justify-content-between align-items-center">
                    @if (ticket.Status is not "Resolved" and not "Closed" and not "Rejected" && ticket.Status == "Open")
                    {
                        <button class="btn btn-outline-primary btn-sm" @onclick="@(() => UpdateStatus(ticket.TicketId, "InProgress"))" @onclick:preventDefault @onclick:stopPropagation>
                            <i class="fa-solid fa-play me-1"></i>Rozpocznij
                        </button>
                    }
                    else
                    {
                        <span></span>
                    }
                    <span class="small text-primary">Szczegóły <i class="fa-solid fa-arrow-right ms-1"></i></span>
                </div>
            </div>
        </a>
    }

    @if (_tickets.Pagination.TotalPages > 1)
    {
        <Pagination Info="@_tickets.Pagination" OnPageChange="LoadPage" />
    }
}

@code {
    private PagedResult<AdminTicketDto>? _tickets;
    private string? _statusFilter;
    private string? _ticketTypeFilter;
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadPage(1);

    private async Task LoadPage(int page)
    {
        _loading = true;
        _tickets = await AdminService.GetTicketsAsync(page, _statusFilter, _ticketTypeFilter);
        _loading = false;
    }

    private async Task FilterByStatus(string? status) { _statusFilter = status; await LoadPage(1); }

    private async Task FilterByTicketType(string? type) { _ticketTypeFilter = type; await LoadPage(1); }

    private async Task UpdateStatus(int ticketId, string status)
    {
        var success = await AdminService.UpdateTicketStatusAsync(ticketId, status);
        if (success) { Toast.ShowSuccess("Status zaktualizowany."); await LoadPage(1); }
        else Toast.ShowError("Nie udalo sie zaktualizowac.");
    }

    private static string PriorityBadge(int priority) => priority switch
    {
        1 => "bg-danger",
        2 => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    private static string TicketTypeLabel(string type) => type switch
    {
        "Contact" => "Kontakt",
        "ReviewContent" => "Recenzja",
        "Photo" => "Zdjęcie",
        "Report" => "Zgloszenie",
        "EditRequest" => "Edycja",
        "IngredientSuggestion" => "Skladnik",
        "DataCorrection" => "Korekta",
        _ => type
    };

    private static string Truncate(string text, int max)
        => text.Length <= max ? text : text[..max] + "...";
}
