@page "/admin/tickets"
@layout AdminLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Moderator")]
@inject IAdminService AdminService

<PageTitle>Pulpit zgłoszeń - Admin Smakosz</PageTitle>

<h2 class="fw-bold mb-4"><i class="fa-solid fa-ticket me-2"></i>Pulpit zgłoszeń</h2>

@if (_loading)
{
    <LoadingSpinner />
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
        @foreach (var entry in TicketTypes)
        {
            var summary = _summaryMap.GetValueOrDefault(entry.TypeKey);
            <div class="col">
                <div class="card shadow-sm h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex align-items-center mb-2">
                            <i class="@entry.Icon fa-fw me-2 text-secondary"></i>
                            <h6 class="fw-bold mb-0">@entry.Label</h6>
                            @if (entry.Tooltip != null)
                            {
                                <i class="fa-solid fa-circle-info ms-2 text-muted small" title="@entry.Tooltip"></i>
                            }
                        </div>
                        @if (summary is { OpenCount: > 0 })
                        {
                            <div class="mb-1">
                                <span class="badge bg-danger me-2">@summary.OpenCount otwarte</span>
                            </div>
                            @if (summary.OldestOpenAt.HasValue)
                            {
                                <p class="text-muted small mb-2">Najstarszy: @FormatAge(summary.OldestOpenAt.Value)</p>
                            }
                        }
                        else
                        {
                            <p class="text-muted small mb-2">Brak otwartych</p>
                        }
                        <div class="mt-auto">
                            <a href="@entry.Link" class="btn btn-outline-primary btn-sm w-100">Przejdź</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private bool _loading = true;
    private Dictionary<string, TicketSummaryDto> _summaryMap = new();

    private record TicketTypeEntry(string TypeKey, string Label, string Icon, string Link, string? Tooltip = null);

    private static readonly TicketTypeEntry[] TicketTypes =
    [
        new("Contact", "Kontakt", "fa-solid fa-envelope", "/admin/contact-messages"),
        new("Photo", "Zdjęcia", "fa-solid fa-images", "/admin/photos"),
        new("ReviewContent", "Recenzje", "fa-solid fa-comments", "/admin/reviews"),
        new("Report", "Raporty", "fa-solid fa-flag", "/admin/reports"),
        new("EditRequest", "Prośby o edycję", "fa-solid fa-pen-to-square", "/admin/edit-requests",
            "Strukturalna prosba o zmiane danych restauracji z payload JSON."),
        new("DataCorrection", "Korekty danych", "fa-solid fa-pen", "/admin/data-corrections",
            "Wolny tekst od uzytkownika zglaszajacego blad w danych. Bez strukturalnego payload."),
        new("IngredientSuggestion", "Sugestie składników", "fa-solid fa-lightbulb", "/admin/ingredient-suggestions"),
        new("RestaurantClaim", "Wnioski o przejęcie", "fa-solid fa-store", "/admin/restaurant-claims"),
        new("RestaurantRequest", "Nowe restauracje", "fa-solid fa-utensils", "/admin/restaurant-requests"),
    ];

    protected override async Task OnInitializedAsync()
    {
        var summaries = await AdminService.GetTicketsSummaryAsync();
        _summaryMap = summaries?.ToDictionary(s => s.TicketType) ?? new();
        _loading = false;
    }

    private static string FormatAge(DateTime oldest)
    {
        var days = (int)(DateTime.UtcNow - oldest).TotalDays;
        return days == 0 ? "dzisiaj" : days == 1 ? "1 dzień temu" : $"{days} dni temu";
    }
}
