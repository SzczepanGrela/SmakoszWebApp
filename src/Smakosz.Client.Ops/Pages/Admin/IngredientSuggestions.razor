@page "/admin/ingredient-suggestions"
@layout AdminLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject IAdminService AdminService
@inject ToastService Toast

<PageTitle>Sugestie składników - Admin Smakosz</PageTitle>

<h2 class="fw-bold mb-4"><i class="fa-solid fa-lightbulb me-2"></i>Sugestie składników</h2>

<p class="text-muted mb-4">Składniki sugerowane przez uzytkownikow lub AI, oczekujace na dodanie do bazy.</p>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_suggestions == null || !_suggestions.Data.Any())
{
    <EmptyState Icon="fa-solid fa-lightbulb" Title="Brak sugestii" Description="Nie ma oczekujacych sugestii skladnikow." />
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr><th>Nazwa</th><th>Restauracja</th><th>Źródło</th><th>Data</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var s in _suggestions.Data)
                {
                    <tr>
                        <td class="fw-medium">@s.SuggestedName</td>
                        <td>@(s.RestaurantName ?? "\u2014")</td>
                        <td><span class="badge bg-info">@(s.Username ?? "AI")</span></td>
                        <td class="text-muted small">@(s.CreatedAt?.ToString("dd.MM.yyyy") ?? "\u2014")</td>
                        <td class="text-end">
                            <button class="btn btn-success btn-sm me-1" @onclick="() => StartAccept(s)">
                                <i class="fa-solid fa-check me-1"></i>Zatwierdz
                            </button>
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => Dismiss(s)">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_suggestions.Pagination.TotalPages > 1)
    {
        <Pagination Info="@_suggestions.Pagination" OnPageChange="LoadPage" />
    }
}

@if (_acceptingSuggestion != null)
{
    <div class="modal d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Zatwierdz skladnik: @_acceptingSuggestion.SuggestedName</h5>
                    <button type="button" class="btn-close" @onclick="CancelAccept"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">Ustaw tagi dietetyczne i ikone dla nowego skladnika.</p>

                    <div class="mb-3">
                        <label class="form-label fw-medium">Ikona (opcjonalnie)</label>
                        @if (!string.IsNullOrEmpty(_uploadedIconUrl))
                        {
                            <div class="d-flex align-items-center gap-2">
                                <img src="@_uploadedIconUrl" alt="ikona" style="width:48px;height:48px;object-fit:cover;border-radius:4px;" />
                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => { _uploadedIconUrl = null; _uploadedIconBlurhash = null; }">
                                    <i class="fa-solid fa-xmark me-1"></i>Usuń
                                </button>
                            </div>
                        }
                        else
                        {
                            <button class="btn btn-outline-primary btn-sm" @onclick="() => _iconCropperOpen = true" disabled="@_iconUploading">
                                @if (_iconUploading) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                <i class="fa-solid fa-image me-1"></i>Wybierz ikonę
                            </button>
                            <small class="text-muted d-block mt-1">JPG, PNG lub WebP. Po wybraniu zostanie automatycznie przesłana.</small>
                        }
                    </div>

                    <div class="row">
                        <div class="col-6">
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" @bind="_reviewIsAllergen" />
                                <label class="form-check-label"><span class="badge bg-danger me-1">Alergen</span></label>
                            </div>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" @bind="_reviewIsVegetarian" />
                                <label class="form-check-label">Wegetarianski</label>
                            </div>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" @bind="_reviewIsVegan" />
                                <label class="form-check-label">Weganski</label>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" @bind="_reviewIsGlutenFree" />
                                <label class="form-check-label">Bez glutenu</label>
                            </div>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" @bind="_reviewIsLactoseFree" />
                                <label class="form-check-label">Bez laktozy</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="CancelAccept">Anuluj</button>
                    <button class="btn btn-success" @onclick="ConfirmAccept" disabled="@_actionInProgress">
                        @if (_actionInProgress) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Zatwierdz i dodaj
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<ImageCropper IsOpen="_iconCropperOpen"
              Title="Przytnij ikonę składnika"
              AspectRatio="1.0"
              MaxSizeMb="5"
              OnClose="() => _iconCropperOpen = false"
              OnCropped="HandleIconCropped" />

@code {
    private PagedResult<AdminIngredientSuggestionDto>? _suggestions;
    private bool _loading = true;
    private bool _actionInProgress;

    private AdminIngredientSuggestionDto? _acceptingSuggestion;
    private bool _reviewIsAllergen;
    private bool _reviewIsVegetarian = true;
    private bool _reviewIsVegan = true;
    private bool _reviewIsGlutenFree = true;
    private bool _reviewIsLactoseFree = true;
    private bool _iconCropperOpen;
    private bool _iconUploading;
    private string? _uploadedIconUrl;
    private string? _uploadedIconBlurhash;

    protected override async Task OnInitializedAsync() => await LoadPage(1);

    private async Task LoadPage(int page)
    {
        _loading = true;
        _suggestions = await AdminService.GetIngredientSuggestionsAsync(page, "Pending");
        _loading = false;
    }

    private void StartAccept(AdminIngredientSuggestionDto s)
    {
        _acceptingSuggestion = s;
        _reviewIsAllergen = false;
        _reviewIsVegetarian = true;
        _reviewIsVegan = true;
        _reviewIsGlutenFree = true;
        _reviewIsLactoseFree = true;
        _uploadedIconUrl = null;
        _uploadedIconBlurhash = null;
    }

    private void CancelAccept()
    {
        _acceptingSuggestion = null;
        _uploadedIconUrl = null;
        _uploadedIconBlurhash = null;
    }

    private async Task HandleIconCropped(Smakosz.Client.Components.ImageCropper.CroppedImage cropped)
    {
        _iconCropperOpen = false;
        _iconUploading = true;
        try
        {
            var result = await AdminService.UploadIngredientIconAsync(cropped.Stream, cropped.FileName);
            if (result != null)
            {
                _uploadedIconUrl = result.IconUrl;
                _uploadedIconBlurhash = result.IconBlurhash;
            }
            else
            {
                Toast.ShowError("Nie udało się przesłać ikony.");
            }
        }
        finally
        {
            _iconUploading = false;
        }
    }

    private async Task ConfirmAccept()
    {
        if (_acceptingSuggestion == null) return;
        _actionInProgress = true;
        var success = await AdminService.ReviewIngredientSuggestionAsync(
            _acceptingSuggestion.SuggestionId, true, null,
            _reviewIsAllergen, _reviewIsVegetarian, _reviewIsVegan,
            _reviewIsGlutenFree, _reviewIsLactoseFree, _uploadedIconUrl, _uploadedIconBlurhash);
        _actionInProgress = false;
        if (success)
        {
            Toast.ShowSuccess($"Składnik \"{_acceptingSuggestion.SuggestedName}\" dodany do bazy.");
            _acceptingSuggestion = null;
            _uploadedIconUrl = null;
            _uploadedIconBlurhash = null;
            await LoadPage(1);
        }
        else
        {
            Toast.ShowError("Nie udało się zaakceptować sugestii.");
        }
    }

    private async Task Dismiss(AdminIngredientSuggestionDto s)
    {
        var success = await AdminService.ReviewIngredientSuggestionAsync(s.SuggestionId, false);
        if (success)
        {
            Toast.ShowSuccess("Sugestia odrzucona.");
            await LoadPage(1);
        }
        else
        {
            Toast.ShowError("Nie udalo sie odrzucic sugestii.");
        }
    }
}
