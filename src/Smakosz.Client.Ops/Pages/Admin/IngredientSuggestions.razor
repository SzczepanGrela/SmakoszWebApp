@page "/admin/ingredient-suggestions"
@layout AdminLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject IAdminService AdminService
@inject ToastService Toast

<PageTitle>Sugestie składników - Admin Smakosz</PageTitle>

<h2 class="fw-bold mb-4"><i class="fa-solid fa-lightbulb me-2"></i>Sugestie składników</h2>

<p class="text-muted mb-4">Składniki sugerowane przez użytkowników lub AI, oczekujące na dodanie do bazy.</p>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_suggestions == null || !_suggestions.Data.Any())
{
    <EmptyState Icon="fa-solid fa-lightbulb" Title="Brak sugestii" Description="Nie ma oczekujących sugestii składników." />
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr><th>Nazwa</th><th>Restauracja</th><th>Źródło</th><th>Data</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var s in _suggestions.Data)
                {
                    <tr>
                        <td class="fw-medium">@s.SuggestedName</td>
                        <td>@(s.RestaurantName ?? "-")</td>
                        <td><span class="badge bg-info">@(s.Username ?? "AI")</span></td>
                        <td class="text-muted small">@(s.CreatedAt?.ToString("dd.MM.yyyy") ?? "-")</td>
                        <td class="text-end">
                            <button class="btn btn-success btn-sm me-1" @onclick="() => Accept(s)">
                                <i class="fa-solid fa-check me-1"></i>Dodaj
                            </button>
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => Dismiss(s)">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_suggestions.Pagination.TotalPages > 1)
    {
        <Pagination Info="@_suggestions.Pagination" OnPageChange="LoadPage" />
    }
}

@code {
    private PagedResult<AdminIngredientSuggestionDto>? _suggestions;
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadPage(1);

    private async Task LoadPage(int page)
    {
        _loading = true;
        _suggestions = await AdminService.GetIngredientSuggestionsAsync(page, "Pending");
        _loading = false;
    }

    private async Task Accept(AdminIngredientSuggestionDto s)
    {
        var success = await AdminService.ReviewIngredientSuggestionAsync(s.SuggestionId, true);
        if (success)
        {
            Toast.ShowSuccess($"Składnik \"{s.SuggestedName}\" dodany do bazy.");
            await LoadPage(1);
        }
        else
        {
            Toast.ShowError("Nie udało się zaakceptować sugestii.");
        }
    }

    private async Task Dismiss(AdminIngredientSuggestionDto s)
    {
        var success = await AdminService.ReviewIngredientSuggestionAsync(s.SuggestionId, false);
        if (success)
        {
            Toast.ShowSuccess("Sugestia odrzucona.");
            await LoadPage(1);
        }
        else
        {
            Toast.ShowError("Nie udało się odrzucić sugestii.");
        }
    }
}
