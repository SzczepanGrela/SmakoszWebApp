@page "/admin/tickets/{Id:int}"
@layout AdminLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Moderator")]
@inject IAdminService AdminService
@inject ToastService Toast
@inject NavigationManager Nav

<PageTitle>Zgłoszenie #@Id - Admin Smakosz</PageTitle>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_detail == null)
{
    <EmptyState Icon="fa-solid fa-ticket" Title="Nie znaleziono zgłoszenia" ActionText="Powrót do listy" ActionUrl="@BackUrl" />
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-2">
            <a href="@BackUrl" class="btn btn-outline-secondary btn-sm">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <h2 class="fw-bold mb-0">#@_detail.TicketId</h2>
            <span class="badge bg-info">@TicketTypeLabel(_detail.TicketType)</span>
            <StatusBadge Status="@_detail.Status" />
            <span class="badge @PriorityBadge(_detail.Priority)">@PriorityLabel(_detail.Priority)</span>
        </div>
        <div class="small text-muted text-end">
            <div><i class="fa-solid fa-calendar me-1"></i>@(_detail.CreatedAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</div>
            @if (_detail.AssignedAdminUsername != null)
            {
                <div><i class="fa-solid fa-user-check me-1"></i>@_detail.AssignedAdminUsername</div>
            }
        </div>
    </div>

    @switch (_detail.TicketType)
    {
        case "Contact":
            @RenderContactPanel()
            break;
        case "Photo":
            @RenderPhotoPanel()
            break;
        case "ReviewContent":
            @RenderReviewPanel()
            break;
        case "Report":
            @RenderReportPanel()
            break;
        case "EditRequest":
            @RenderEditRequestPanel()
            break;
        case "IngredientSuggestion":
            @RenderSuggestionPanel()
            break;
        case "DataCorrection":
            @RenderDataCorrectionPanel()
            break;
        case "RestaurantClaim":
            @RenderRestaurantClaimPanel()
            break;
        case "RestaurantRequest":
            @RenderRestaurantRequestPanel()
            break;
    }
}

@code {
    [Parameter] public int Id { get; set; }

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private string BackUrl => IsValidReturnUrl(ReturnUrl) ? ReturnUrl! : "/admin/tickets";

    private static bool IsValidReturnUrl(string? url) =>
        !string.IsNullOrEmpty(url) && url.StartsWith("/admin/", StringComparison.OrdinalIgnoreCase);

    private AdminTicketDetailDto? _detail;
    private bool _loading = true;
    private bool _actionInProgress;
    private string _responseText = string.Empty;
    private string _rejectionReason = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _detail = await AdminService.GetTicketDetailAsync(Id);
        _loading = false;
    }

    private bool IsResolved => _detail?.Status is "Resolved" or "Closed" or "Rejected";

    private RenderFragment RenderContactPanel() => __builder =>
    {
        var c = _detail!.Contact;
        <div class="card shadow-sm mb-4">
            <div class="card-header"><h5 class="mb-0"><i class="fa-solid fa-envelope me-2"></i>Wiadomość kontaktowa</h5></div>
            <div class="card-body">
                @if (c != null)
                {
                    <dl class="row mb-0">
                        <dt class="col-sm-2">Nadawca</dt>
                        <dd class="col-sm-10">@c.Name</dd>
                        <dt class="col-sm-2">Email</dt>
                        <dd class="col-sm-10">@c.Email</dd>
                        <dt class="col-sm-2">Temat</dt>
                        <dd class="col-sm-10">@c.Subject</dd>
                    </dl>
                    <hr />
                    <p class="mb-0" style="white-space:pre-line;">@c.Message</p>
                }
                else
                {
                    <p class="text-muted mb-0" style="white-space:pre-line;">@_detail!.Description</p>
                }
            </div>
        </div>

        @if (!IsResolved)
        {
            <div class="card shadow-sm">
                <div class="card-header"><h5 class="mb-0">Odpowiedź</h5></div>
                <div class="card-body">
                    <textarea class="form-control mb-3" rows="5" placeholder="Treść odpowiedzi..." @bind="_responseText"></textarea>
                    <button class="btn btn-primary" disabled="@(_actionInProgress || string.IsNullOrWhiteSpace(_responseText))" @onclick="SendContactResponse">
                        @if (_actionInProgress) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        <i class="fa-solid fa-paper-plane me-1"></i>Wyślij odpowiedź
                    </button>
                </div>
            </div>
        }
    };

    private async Task SendContactResponse()
    {
        _actionInProgress = true;
        var ok = await AdminService.RespondToContactAsync(Id, _responseText);
        _actionInProgress = false;
        if (ok) { Toast.ShowSuccess("Odpowiedź wysłana, zgłoszenie rozwiązane."); Nav.NavigateTo(BackUrl); }
        else Toast.ShowError("Nie udało się wysłać odpowiedzi.");
    }

    private RenderFragment RenderPhotoPanel() => __builder =>
    {
        var p = _detail!.Photo;
        <div class="card shadow-sm mb-4">
            <div class="card-header"><h5 class="mb-0"><i class="fa-solid fa-image me-2"></i>Zdjęcie do moderacji</h5></div>
            <div class="card-body">
                @if (p != null)
                {
                    <div class="text-center mb-3">
                        <img src="@p.Url" alt="Zdjęcie" class="img-fluid rounded" style="max-height:400px;" />
                    </div>
                    <dl class="row mb-0">
                        <dt class="col-sm-3">Typ encji</dt>
                        <dd class="col-sm-9">@p.EntityType</dd>
                        <dt class="col-sm-3">ID encji</dt>
                        <dd class="col-sm-9">@p.EntityId</dd>
                        <dt class="col-sm-3">Przesłane przez</dt>
                        <dd class="col-sm-9">@(p.UploadedByUsername ?? "-")</dd>
                        <dt class="col-sm-3">Data</dt>
                        <dd class="col-sm-9">@(p.CreatedAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</dd>
                    </dl>
                }
                else
                {
                    <p class="text-muted">Nie znaleziono powiązanego zdjęcia.</p>
                }
            </div>
        </div>

        @if (!IsResolved && p != null)
        {
            @RenderRejectionInput()
            <div class="d-flex gap-2">
                <button class="btn btn-success" disabled="@_actionInProgress" @onclick="ApprovePhoto">
                    <i class="fa-solid fa-check me-1"></i>Zatwierdź
                </button>
                <button class="btn btn-danger" disabled="@_actionInProgress" @onclick="RejectPhoto">
                    <i class="fa-solid fa-xmark me-1"></i>Odrzuć
                </button>
            </div>
        }
    };

    private async Task ApprovePhoto()
    {
        _actionInProgress = true;
        var ok = await AdminService.ModeratePhotoAsync(_detail!.Photo!.PublicId, approve: true);
        if (ok) ok = await AdminService.UpdateTicketStatusAsync(Id, "Resolved");
        _actionInProgress = false;
        if (ok) { Toast.ShowSuccess("Zdjęcie zatwierdzone."); Nav.NavigateTo(BackUrl); }
        else Toast.ShowError("Błąd moderacji.");
    }

    private async Task RejectPhoto()
    {
        if (string.IsNullOrWhiteSpace(_rejectionReason))
        {
            Toast.ShowError("Wpisz powód odrzucenia.");
            return;
        }
        _actionInProgress = true;
        var ok = await AdminService.ModeratePhotoAsync(_detail!.Photo!.PublicId, approve: false, reasonCodes: null, moderatorNote: _rejectionReason);
        if (ok) ok = await AdminService.UpdateTicketStatusAsync(Id, "Resolved");
        _actionInProgress = false;
        if (ok) { Toast.ShowSuccess("Zdjęcie odrzucone."); Nav.NavigateTo(BackUrl); }
        else Toast.ShowError("Błąd moderacji.");
    }

    private RenderFragment RenderReviewPanel() => __builder =>
    {
        var r = _detail!.Review;
        <div class="card shadow-sm mb-4">
            <div class="card-header"><h5 class="mb-0"><i class="fa-solid fa-star me-2"></i>Recenzja do moderacji</h5></div>
            <div class="card-body">
                @if (r != null)
                {
                    <dl class="row mb-3">
                        <dt class="col-sm-3">Autor</dt>
                        <dd class="col-sm-9">@(r.Username ?? "-")</dd>
                        <dt class="col-sm-3">Danie</dt>
                        <dd class="col-sm-9">@(r.DishName ?? "-")</dd>
                        <dt class="col-sm-3">Restauracja</dt>
                        <dd class="col-sm-9">@(r.RestaurantName ?? "-")</dd>
                        <dt class="col-sm-3">Ocena</dt>
                        <dd class="col-sm-9">@r.DishRating / 5</dd>
                        <dt class="col-sm-3">Data</dt>
                        <dd class="col-sm-9">@(r.CreatedAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</dd>
                    </dl>
                    <div class="p-3 bg-light rounded" style="white-space:pre-line;">@(r.Content ?? "(brak treści)")</div>
                }
                else
                {
                    <p class="text-muted">Nie znaleziono powiązanej recenzji.</p>
                }
            </div>
        </div>

        @if (!IsResolved && r != null)
        {
            @RenderRejectionInput()
            <div class="d-flex gap-2">
                <button class="btn btn-success" disabled="@_actionInProgress" @onclick="ApproveReview">
                    <i class="fa-solid fa-check me-1"></i>Zatwierdź
                </button>
                <button class="btn btn-danger" disabled="@_actionInProgress" @onclick="RejectReview">
                    <i class="fa-solid fa-xmark me-1"></i>Odrzuć
                </button>
            </div>
        }
    };

    private async Task ApproveReview()
    {
        _actionInProgress = true;
        var ok = await AdminService.ModerateReviewAsync(_detail!.Review!.PublicId, approve: true);
        if (ok) ok = await AdminService.UpdateTicketStatusAsync(Id, "Resolved");
        _actionInProgress = false;
        if (ok) { Toast.ShowSuccess("Recenzja zatwierdzona."); Nav.NavigateTo(BackUrl); }
        else Toast.ShowError("Błąd moderacji.");
    }

    private async Task RejectReview()
    {
        if (string.IsNullOrWhiteSpace(_rejectionReason))
        {
            Toast.ShowError("Wpisz powód odrzucenia.");
            return;
        }
        _actionInProgress = true;
        var ok = await AdminService.ModerateReviewAsync(_detail!.Review!.PublicId, approve: false, reasonCodes: null, moderatorNote: _rejectionReason);
        if (ok) ok = await AdminService.UpdateTicketStatusAsync(Id, "Resolved");
        _actionInProgress = false;
        if (ok) { Toast.ShowSuccess("Recenzja odrzucona."); Nav.NavigateTo(BackUrl); }
        else Toast.ShowError("Błąd moderacji.");
    }

    private RenderFragment RenderReportPanel() => __builder =>
    {
        var rp = _detail!.Report;
        <div class="card shadow-sm mb-4">
            <div class="card-header"><h5 class="mb-0"><i class="fa-solid fa-flag me-2"></i>Zgłoszenie</h5></div>
            <div class="card-body">
                @if (rp != null)
                {
                    <dl class="row mb-0">
                        <dt class="col-sm-3">Typ encji</dt>
                        <dd class="col-sm-9">@rp.EntityType</dd>
                        <dt class="col-sm-3">ID encji</dt>
                        <dd class="col-sm-9">@rp.EntityId</dd>
                        <dt class="col-sm-3">Powód</dt>
                        <dd class="col-sm-9">@rp.Reason</dd>
                        <dt class="col-sm-3">Zgłaszający</dt>
                        <dd class="col-sm-9">@(rp.ReporterUsername ?? "-")</dd>
                        <dt class="col-sm-3">Status</dt>
                        <dd class="col-sm-9"><StatusBadge Status="@rp.Status" /></dd>
                    </dl>
                }
                else
                {
                    <p class="text-muted">Nie znaleziono powiązanego zgłoszenia.</p>
                }
            </div>
        </div>

        @if (!IsResolved && rp != null)
        {
            <div class="d-flex gap-2">
                <button class="btn btn-success" disabled="@_actionInProgress" @onclick="ResolveReport">
                    <i class="fa-solid fa-check me-1"></i>Rozwiąż
                </button>
                <button class="btn btn-danger" disabled="@_actionInProgress" @onclick="RejectReport">
                    <i class="fa-solid fa-xmark me-1"></i>Odrzuć
                </button>
            </div>
        }
    };

    private async Task ResolveReport()
    {
        _actionInProgress = true;
        var ok = await AdminService.ResolveReportAsync(_detail!.Report!.ReportId, "Resolved");
        if (ok) ok = await AdminService.UpdateTicketStatusAsync(Id, "Resolved");
        _actionInProgress = false;
        if (ok) { Toast.ShowSuccess("Zgłoszenie rozwiązane."); Nav.NavigateTo(BackUrl); }
        else Toast.ShowError("Błąd moderacji.");
    }

    private async Task RejectReport()
    {
        _actionInProgress = true;
        var ok = await AdminService.ResolveReportAsync(_detail!.Report!.ReportId, "Rejected");
        if (ok) ok = await AdminService.UpdateTicketStatusAsync(Id, "Rejected");
        _actionInProgress = false;
        if (ok) { Toast.ShowSuccess("Zgłoszenie odrzucone."); Nav.NavigateTo(BackUrl); }
        else Toast.ShowError("Błąd moderacji.");
    }

    private RenderFragment RenderEditRequestPanel() => __builder =>
    {
        var er = _detail!.EditRequest;
        <div class="card shadow-sm mb-4">
            <div class="card-header"><h5 class="mb-0"><i class="fa-solid fa-pen-to-square me-2"></i>Prośba o edycję</h5></div>
            <div class="card-body">
                @if (er != null)
                {
                    <dl class="row mb-3">
                        <dt class="col-sm-3">Restauracja</dt>
                        <dd class="col-sm-9">@(er.RestaurantName ?? "-")</dd>
                        <dt class="col-sm-3">Zgłaszający</dt>
                        <dd class="col-sm-9">@(er.Username ?? "-")</dd>
                        <dt class="col-sm-3">Typ zmiany</dt>
                        <dd class="col-sm-9">@er.ChangeType</dd>
                        <dt class="col-sm-3">Status</dt>
                        <dd class="col-sm-9"><StatusBadge Status="@er.Status" /></dd>
                    </dl>
                    <div class="p-3 bg-light rounded"><code>@er.Payload</code></div>
                }
                else
                {
                    <p class="text-muted">Nie znaleziono powiązanej prośby o edycję.</p>
                }
            </div>
        </div>

        @if (!IsResolved && er != null)
        {
            @RenderRejectionInput()
            <div class="d-flex gap-2">
                <button class="btn btn-success" disabled="@_actionInProgress" @onclick="ApproveEditRequest">
                    <i class="fa-solid fa-check me-1"></i>Zatwierdź
                </button>
                <button class="btn btn-danger" disabled="@_actionInProgress" @onclick="RejectEditRequest">
                    <i class="fa-solid fa-xmark me-1"></i>Odrzuć
                </button>
            </div>
        }
    };

    private async Task ApproveEditRequest()
    {
        _actionInProgress = true;
        var ok = await AdminService.ProcessEditRequestAsync(_detail!.EditRequest!.RequestId, "approve");
        if (ok) ok = await AdminService.UpdateTicketStatusAsync(Id, "Resolved");
        _actionInProgress = false;
        if (ok) { Toast.ShowSuccess("Edycja zatwierdzona."); Nav.NavigateTo(BackUrl); }
        else Toast.ShowError("Błąd moderacji.");
    }

    private async Task RejectEditRequest()
    {
        _actionInProgress = true;
        var ok = await AdminService.ProcessEditRequestAsync(_detail!.EditRequest!.RequestId, "reject", _rejectionReason);
        if (ok) ok = await AdminService.UpdateTicketStatusAsync(Id, "Resolved");
        _actionInProgress = false;
        if (ok) { Toast.ShowSuccess("Edycja odrzucona."); Nav.NavigateTo(BackUrl); }
        else Toast.ShowError("Błąd moderacji.");
    }

    private RenderFragment RenderSuggestionPanel() => __builder =>
    {
        var s = _detail!.Suggestion;
        <div class="card shadow-sm mb-4">
            <div class="card-header"><h5 class="mb-0"><i class="fa-solid fa-seedling me-2"></i>Sugestia składnika</h5></div>
            <div class="card-body">
                @if (s != null)
                {
                    <dl class="row mb-3">
                        <dt class="col-sm-3">Nazwa</dt>
                        <dd class="col-sm-9">@s.SuggestedName</dd>
                        <dt class="col-sm-3">Sugerujący</dt>
                        <dd class="col-sm-9">@(s.Username ?? "-")</dd>
                        <dt class="col-sm-3">Restauracja</dt>
                        <dd class="col-sm-9">@(s.RestaurantName ?? "-")</dd>
                        <dt class="col-sm-3">Status</dt>
                        <dd class="col-sm-9"><StatusBadge Status="@s.Status" /></dd>
                    </dl>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        @if (s.IsAllergen) { <span class="badge bg-danger">Alergen</span> }
                        @if (s.IsVegetarian) { <span class="badge bg-success">Wegetariański</span> }
                        @if (s.IsVegan) { <span class="badge bg-success">Wegański</span> }
                        @if (s.IsGlutenFree) { <span class="badge bg-info">Bezglutenowy</span> }
                        @if (s.IsLactoseFree) { <span class="badge bg-info">Bezlaktozowy</span> }
                    </div>
                }
                else
                {
                    <p class="text-muted">Nie znaleziono powiązanej sugestii.</p>
                }
            </div>
        </div>

        @if (!IsResolved && s != null)
        {
            <div class="card shadow-sm mb-3">
                <div class="card-header"><h6 class="mb-0">Tagi dietetyczne (przy zatwierdzaniu)</h6></div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label small fw-medium">URL ikony</label>
                        <input type="text" class="form-control form-control-sm" @bind="_suggestionIconUrl" placeholder="https://..." />
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <div class="form-check mb-1">
                                <input class="form-check-input" type="checkbox" @bind="_suggestionIsAllergen" />
                                <label class="form-check-label small">Alergen</label>
                            </div>
                            <div class="form-check mb-1">
                                <input class="form-check-input" type="checkbox" @bind="_suggestionIsVegetarian" />
                                <label class="form-check-label small">Wegetariański</label>
                            </div>
                            <div class="form-check mb-1">
                                <input class="form-check-input" type="checkbox" @bind="_suggestionIsVegan" />
                                <label class="form-check-label small">Wegański</label>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-check mb-1">
                                <input class="form-check-input" type="checkbox" @bind="_suggestionIsGlutenFree" />
                                <label class="form-check-label small">Bez glutenu</label>
                            </div>
                            <div class="form-check mb-1">
                                <input class="form-check-input" type="checkbox" @bind="_suggestionIsLactoseFree" />
                                <label class="form-check-label small">Bez laktozy</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            @RenderRejectionInput()
            <div class="d-flex gap-2">
                <button class="btn btn-success" disabled="@_actionInProgress" @onclick="ApproveSuggestion">
                    <i class="fa-solid fa-check me-1"></i>Zatwierdź
                </button>
                <button class="btn btn-danger" disabled="@_actionInProgress" @onclick="RejectSuggestion">
                    <i class="fa-solid fa-xmark me-1"></i>Odrzuć
                </button>
            </div>
        }
    };

    private bool _suggestionIsAllergen;
    private bool _suggestionIsVegetarian = true;
    private bool _suggestionIsVegan = true;
    private bool _suggestionIsGlutenFree = true;
    private bool _suggestionIsLactoseFree = true;
    private string? _suggestionIconUrl;

    private async Task ApproveSuggestion()
    {
        _actionInProgress = true;
        var ok = await AdminService.ReviewIngredientSuggestionAsync(
            _detail!.Suggestion!.SuggestionId, true, null,
            _suggestionIsAllergen, _suggestionIsVegetarian, _suggestionIsVegan,
            _suggestionIsGlutenFree, _suggestionIsLactoseFree, _suggestionIconUrl);
        if (ok) ok = await AdminService.UpdateTicketStatusAsync(Id, "Resolved");
        _actionInProgress = false;
        if (ok) { Toast.ShowSuccess("Sugestia zatwierdzona."); Nav.NavigateTo(BackUrl); }
        else Toast.ShowError("Błąd moderacji.");
    }

    private async Task RejectSuggestion()
    {
        _actionInProgress = true;
        var ok = await AdminService.ReviewIngredientSuggestionAsync(_detail!.Suggestion!.SuggestionId, false, _rejectionReason);
        if (ok) ok = await AdminService.UpdateTicketStatusAsync(Id, "Resolved");
        _actionInProgress = false;
        if (ok) { Toast.ShowSuccess("Sugestia odrzucona."); Nav.NavigateTo(BackUrl); }
        else Toast.ShowError("Błąd moderacji.");
    }

    private RenderFragment RenderDataCorrectionPanel() => __builder =>
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header"><h5 class="mb-0"><i class="fa-solid fa-wrench me-2"></i>Korekta danych</h5></div>
            <div class="card-body">
                <p class="mb-0" style="white-space:pre-line;">@(_detail!.Description ?? "(brak opisu)")</p>
            </div>
        </div>

        @if (!IsResolved)
        {
            <div class="d-flex gap-2">
                <button class="btn btn-success" disabled="@_actionInProgress" @onclick="ResolveDataCorrection">
                    <i class="fa-solid fa-check me-1"></i>Rozwiąż
                </button>
                <button class="btn btn-danger" disabled="@_actionInProgress" @onclick="RejectDataCorrection">
                    <i class="fa-solid fa-xmark me-1"></i>Odrzuć
                </button>
            </div>
        }
    };

    private async Task ResolveDataCorrection()
    {
        _actionInProgress = true;
        var ok = await AdminService.UpdateTicketStatusAsync(Id, "Resolved");
        _actionInProgress = false;
        if (ok) { Toast.ShowSuccess("Korekta rozwiązana."); Nav.NavigateTo(BackUrl); }
        else Toast.ShowError("Błąd.");
    }

    private async Task RejectDataCorrection()
    {
        _actionInProgress = true;
        var ok = await AdminService.UpdateTicketStatusAsync(Id, "Rejected");
        _actionInProgress = false;
        if (ok) { Toast.ShowSuccess("Korekta odrzucona."); Nav.NavigateTo(BackUrl); }
        else Toast.ShowError("Błąd.");
    }

    private RenderFragment RenderRejectionInput() => __builder =>
    {
        <div class="mb-3">
            <label class="form-label small text-muted">Powód / notatka (opcjonalnie)</label>
            <textarea class="form-control" rows="2" @bind="_rejectionReason" placeholder="Powód odrzucenia lub notatka..."></textarea>
        </div>
    };

    private static string PriorityBadge(int priority) => priority switch
    {
        1 => "bg-danger",
        2 => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    private static string PriorityLabel(int priority) => priority switch
    {
        1 => "Wysoki",
        2 => "Normalny",
        _ => "Niski"
    };

    private static string TicketTypeLabel(string type) => type switch
    {
        "Contact" => "Kontakt",
        "ReviewContent" => "Recenzja",
        "Photo" => "Zdjęcie",
        "Report" => "Zgłoszenie",
        "EditRequest" => "Edycja",
        "IngredientSuggestion" => "Składnik",
        "DataCorrection" => "Korekta",
        "RestaurantClaim" => "Claim restauracji",
        "RestaurantRequest" => "Nowa restauracja",
        _ => type
    };

    private RestaurantRequestPayload? _requestPayload;

    private RenderFragment RenderRestaurantClaimPanel() => __builder =>
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header"><h5 class="mb-0"><i class="fa-solid fa-handshake me-2"></i>Claim restauracji</h5></div>
            <div class="card-body">
                <dl class="row mb-3">
                    <dt class="col-sm-3">Restauracja</dt>
                    <dd class="col-sm-9">
                        @if (_detail!.RestaurantId.HasValue)
                        {
                            <a href="/admin/restaurants/@_detail.RestaurantId">
                                @(_detail.RestaurantName ?? $"#{_detail.RestaurantId}")
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">#@_detail.ReferenceId (nie znaleziono)</span>
                        }
                    </dd>
                    <dt class="col-sm-3">Zgłaszający</dt>
                    <dd class="col-sm-9">
                        @if (_detail.RequesterUsername != null)
                        {
                            <strong>@_detail.RequesterUsername</strong>
                            @if (!string.IsNullOrEmpty(_detail.RequesterEmail))
                            {
                                <span class="text-muted"> (@_detail.RequesterEmail)</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </dd>
                </dl>
                <div class="p-3 bg-light rounded" style="white-space:pre-line;">@(_detail.Description ?? "(brak uzasadnienia)")</div>
            </div>
        </div>

        @if (!IsResolved)
        {
            @RenderRejectionInput()
            <div class="d-flex gap-2">
                <button class="btn btn-success" disabled="@_actionInProgress" @onclick="ApproveClaim">
                    <i class="fa-solid fa-check me-1"></i>Zaakceptuj claim
                </button>
                <button class="btn btn-danger" disabled="@_actionInProgress" @onclick="RejectClaim">
                    <i class="fa-solid fa-xmark me-1"></i>Odrzuc
                </button>
            </div>
        }
    };

    private async Task ApproveClaim()
    {
        _actionInProgress = true;
        var ok = await AdminService.ApproveRestaurantClaimAsync(Id);
        _actionInProgress = false;
        if (ok) { Toast.ShowSuccess("Claim zaakceptowany."); Nav.NavigateTo(BackUrl); }
        else Toast.ShowError("Nie udalo sie zaakceptowac claim.");
    }

    private async Task RejectClaim()
    {
        if (string.IsNullOrWhiteSpace(_rejectionReason))
        {
            Toast.ShowError("Wpisz powod odrzucenia.");
            return;
        }
        _actionInProgress = true;
        var ok = await AdminService.RejectRestaurantClaimAsync(Id, _rejectionReason);
        _actionInProgress = false;
        if (ok) { Toast.ShowSuccess("Claim odrzucony."); Nav.NavigateTo(BackUrl); }
        else Toast.ShowError("Nie udalo sie odrzucic claim.");
    }

    private RenderFragment RenderRestaurantRequestPanel() => __builder =>
    {
        if (_requestPayload == null && !string.IsNullOrWhiteSpace(_detail!.Description))
        {
            try
            {
                _requestPayload = System.Text.Json.JsonSerializer.Deserialize<RestaurantRequestPayload>(
                    _detail.Description,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            }
            catch (System.Text.Json.JsonException) { _requestPayload = null; }
        }

        <div class="card shadow-sm mb-4">
            <div class="card-header"><h5 class="mb-0"><i class="fa-solid fa-store me-2"></i>Nowa restauracja - propozycja</h5></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">Zgłaszający</dt>
                    <dd class="col-sm-9">
                        @if (_detail!.RequesterUsername != null)
                        {
                            <strong>@_detail.RequesterUsername</strong>
                            @if (!string.IsNullOrEmpty(_detail.RequesterEmail))
                            {
                                <span class="text-muted"> (@_detail.RequesterEmail)</span>
                            }
                        }
                        else { <span class="text-muted">-</span> }
                    </dd>
                    @if (_requestPayload != null)
                    {
                        <dt class="col-sm-3">Nazwa</dt>
                        <dd class="col-sm-9">@(_requestPayload.Name ?? "-")</dd>
                        <dt class="col-sm-3">Adres</dt>
                        <dd class="col-sm-9">@(_requestPayload.Address ?? "-")</dd>
                        <dt class="col-sm-3">Miasto (id)</dt>
                        <dd class="col-sm-9">@(_requestPayload.CityId?.ToString() ?? "-")</dd>
                        <dt class="col-sm-3">Typ kuchni (id)</dt>
                        <dd class="col-sm-9">@(_requestPayload.CuisineTypeId?.ToString() ?? "-")</dd>
                        <dt class="col-sm-3">Telefon</dt>
                        <dd class="col-sm-9">@(_requestPayload.Phone ?? "-")</dd>
                        <dt class="col-sm-3">Email</dt>
                        <dd class="col-sm-9">@(_requestPayload.Email ?? "-")</dd>
                        <dt class="col-sm-3">Opis</dt>
                        <dd class="col-sm-9" style="white-space:pre-line;">@(_requestPayload.Description ?? "-")</dd>
                    }
                    else
                    {
                        <dt class="col-sm-3">Treść</dt>
                        <dd class="col-sm-9" style="white-space:pre-line;">@(_detail.Description ?? "(brak)")</dd>
                    }
                </dl>
            </div>
        </div>

        @if (!IsResolved)
        {
            @RenderRejectionInput()
            <div class="d-flex gap-2">
                <a href="/admin/restaurants/new?fromTicket=@Id" class="btn btn-success">
                    <i class="fa-solid fa-plus me-1"></i>Utworz restauracje
                </a>
                <button class="btn btn-danger" disabled="@_actionInProgress" @onclick="RejectNewRequest">
                    <i class="fa-solid fa-xmark me-1"></i>Odrzuc
                </button>
            </div>
        }
    };

    private async Task RejectNewRequest()
    {
        if (string.IsNullOrWhiteSpace(_rejectionReason))
        {
            Toast.ShowError("Wpisz powod odrzucenia.");
            return;
        }
        _actionInProgress = true;
        var ok = await AdminService.RejectNewRestaurantRequestAsync(Id, _rejectionReason);
        _actionInProgress = false;
        if (ok) { Toast.ShowSuccess("Zgloszenie odrzucone."); Nav.NavigateTo(BackUrl); }
        else Toast.ShowError("Nie udalo sie odrzucic zgloszenia.");
    }

    private class RestaurantRequestPayload
    {
        public string? Name { get; set; }
        public string? Address { get; set; }
        public string? Phone { get; set; }
        public string? Email { get; set; }
        public string? Description { get; set; }
        public int? CityId { get; set; }
        public int? CuisineTypeId { get; set; }
    }
}
