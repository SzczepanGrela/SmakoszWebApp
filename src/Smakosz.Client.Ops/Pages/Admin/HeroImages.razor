@page "/admin/hero-images"
@layout AdminLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Moderator")]
@inject IAdminService AdminService
@inject ToastService Toast
@inject IConfirmService Confirm

<PageTitle>Hero images - Admin Smakosz</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="fa-solid fa-panorama me-2"></i>Hero images</h2>
    <button class="btn btn-primary" @onclick="OpenUpload">
        <i class="fa-solid fa-upload me-1"></i>Dodaj nowe
    </button>
</div>

<ImageCropper IsOpen="_open"
              AspectRatio="@(21.0 / 9.0)"
              Title="Przytnij hero image (21:9)"
              MaxSizeMb="5"
              OutputMaxWidth="2400"
              OnClose="() => { _open = false; return Task.CompletedTask; }"
              OnCropped="OnCroppedAsync" />

@if (_open)
{
    <div class="mb-3">
        <label class="form-label">Credit text (opcjonalnie)</label>
        <input type="text" class="form-control" @bind="_creditText" placeholder="np. Photo by Jan Kowalski" />
    </div>
}

@if (_loading)
{
    <LoadingSpinner />
}
else if (!_images.Any())
{
    <EmptyState Icon="fa-solid fa-panorama" Title="Brak hero images"
                Description="Dodaj zdjęcia, które będą wyświetlane na stronie głównej." />
}
else
{
    <div class="row">
        @foreach (var image in _images)
        {
            <div class="col-md-4 col-lg-3 mb-4">
                <div class="card shadow-sm h-100">
                    <img src="@image.Url" class="card-img-top" style="height:200px;object-fit:cover;" alt="Hero image" />
                    <div class="card-body p-2">
                        <small class="text-muted d-block mb-2">
                            <i class="fa-solid fa-calendar me-1"></i>@(image.CreatedAt?.ToString("dd.MM.yyyy") ?? "-")
                        </small>
                        @if (!string.IsNullOrEmpty(image.CreditText))
                        {
                            <small class="text-muted d-block mb-2"><i class="fa-solid fa-camera me-1"></i>@image.CreditText</small>
                        }
                        <button class="btn btn-outline-danger btn-sm w-100" @onclick="() => DeleteImage(image.PublicId)"
                                disabled="@_deleting">
                            <i class="fa-solid fa-trash me-1"></i>Usuń
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<AdminHeroImageDto> _images = [];
    private bool _loading = true;
    private bool _open;
    private bool _deleting;
    private string? _creditText;

    protected override async Task OnInitializedAsync() => await LoadImages();

    private async Task LoadImages()
    {
        _loading = true;
        _images = await AdminService.GetHeroImagesAsync();
        _loading = false;
    }

    private void OpenUpload()
    {
        _creditText = null;
        _open = true;
    }

    private async Task OnCroppedAsync(ImageCropper.CroppedImage cropped)
    {
        _open = false;
        using var stream = cropped.Stream;
        var result = await AdminService.UploadHeroImageAsync(stream, cropped.FileName, _creditText);
        if (result is null)
        {
            Toast.ShowError("Nie udało się przesłać hero image.");
            return;
        }
        Toast.ShowSuccess("Hero image dodane.");
        await LoadImages();
    }

    private async Task DeleteImage(Guid publicId)
    {
        if (!await Confirm.AskAsync("Czy na pewno chcesz usunąć to hero image?")) return;
        _deleting = true;
        var success = await AdminService.DeleteHeroImageAsync(publicId);
        if (success)
        {
            Toast.ShowSuccess("Hero image usunięte.");
            await LoadImages();
        }
        else
        {
            Toast.ShowError("Nie udało się usunąć obrazu.");
        }
        _deleting = false;
    }
}
