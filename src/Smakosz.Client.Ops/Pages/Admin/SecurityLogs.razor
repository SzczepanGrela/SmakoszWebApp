@page "/admin/security-logs"
@layout AdminLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject IAdminService AdminService

<PageTitle>Logi bezpieczeństwa - Admin Smakosz</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h2 class="fw-bold mb-0"><i class="fa-solid fa-shield-halved me-2"></i>Logi bezpieczeństwa</h2>
    <select class="form-select form-select-sm" style="width:auto;min-width:220px;" @bind="_eventFilter" @bind:after="ReloadOnFilterChange">
        <option value="">Wszystkie typy</option>
        @foreach (var ev in _eventTypes)
        {
            <option value="@ev">@ev</option>
        }
    </select>
</div>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_logs == null || !_logs.Data.Any())
{
    <EmptyState Icon="fa-solid fa-shield-halved" Title="Brak logów bezpieczeństwa" />
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-hover" style="font-size:0.85rem;">
            <thead>
                <tr>
                    <th style="width:160px;">Czas</th>
                    <th style="width:140px;">Typ</th>
                    <th>Email</th>
                    <th>IP</th>
                    <th>Lokalizacja</th>
                    <th>User Agent</th>
                    <th>Szczegóły</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in _logs.Data)
                {
                    <tr class="@SecurityRowClass(log.EventType)">
                        <td class="text-muted">@log.CreatedAt?.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td><span class="badge @EventBadge(log.EventType)">@log.EventType</span></td>
                        <td>@log.Email</td>
                        <td>@log.IpAddress</td>
                        <td>
                            @if (!string.IsNullOrEmpty(log.CountryCode) || !string.IsNullOrEmpty(log.City))
                            {
                                @($"{log.CountryCode} {log.City}".Trim())
                            }
                        </td>
                        <td title="@log.UserAgent">
                            @(log.UserAgent?.Length > 40 ? log.UserAgent[..40] + "..." : log.UserAgent)
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(log.Details))
                            {
                                <details>
                                    <summary class="small text-primary">Szczegóły</summary>
                                    <pre class="small mb-0" style="max-height:200px;overflow:auto;">@log.Details</pre>
                                </details>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_logs.Pagination.TotalPages > 1)
    {
        <Pagination Info="@_logs.Pagination" OnPageChange="LoadPage" />
    }
}

@code {
    private PagedResult<AdminSecurityLogDto>? _logs;
    private string _eventFilter = "";
    private bool _loading = true;

    private static readonly string[] _eventTypes =
    [
        "AccountDeleted",
        "AccountInvited",
        "BannedRegistration",
        "BlockedIp",
        "FailedLogin",
        "PasswordChanged",
        "PasswordReset",
        "PasswordResetByAdmin",
        "RoleChanged",
        "SuccessfulLogin",
        "SuspiciousActivity",
        "TwoFactorDisabled",
        "TwoFactorDisabledByAdmin",
        "TwoFactorEnabled"
    ];

    protected override async Task OnInitializedAsync() => await LoadPage(1);

    private async Task LoadPage(int page)
    {
        _loading = true;
        _logs = await AdminService.GetSecurityLogsAsync(page, string.IsNullOrEmpty(_eventFilter) ? null : _eventFilter);
        _loading = false;
    }

    private Task ReloadOnFilterChange() => LoadPage(1);

    private static string EventBadge(string? eventType) => eventType switch
    {
        "SuccessfulLogin" or "TwoFactorEnabled" => "bg-success",
        "FailedLogin" or "BlockedIp" or "AccountDeleted" or "TwoFactorDisabledByAdmin" => "bg-danger",
        "SuspiciousActivity" or "BannedRegistration" or "TwoFactorDisabled" or "PasswordResetByAdmin" or "RoleChanged" => "bg-warning text-dark",
        "PasswordReset" or "PasswordChanged" or "AccountInvited" => "bg-info",
        _ => "bg-secondary"
    };

    private static string SecurityRowClass(string? eventType) => eventType switch
    {
        "FailedLogin" or "BlockedIp" or "AccountDeleted" or "TwoFactorDisabledByAdmin" => "table-danger",
        "SuspiciousActivity" => "table-warning",
        _ => ""
    };
}
