@page "/admin/users"
@layout AdminLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject IAdminService AdminService
@inject ToastService Toast

<PageTitle>Użytkownicy - Admin Smakosz</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h2 class="fw-bold mb-0"><i class="fa-solid fa-users me-2"></i>Użytkownicy</h2>
    <div class="d-flex gap-2 align-items-center flex-wrap">
        <select class="form-select form-select-sm" style="max-width:160px;" @bind="_roleFilter" @bind:after="DoSearch">
            <option value="">Wszystkie role</option>
            <option value="User">User</option>
            <option value="Moderator">Moderator</option>
            <option value="Admin">Admin</option>
            <option value="Restaurant">Restaurant</option>
        </select>
        <div class="input-group input-group-sm" style="max-width:280px;">
            <input type="text" class="form-control" @bind="_search" @onkeydown="HandleSearchKey" placeholder="Szukaj użytkownika..." />
            <button class="btn btn-outline-primary" @onclick="DoSearch"><i class="fa-solid fa-magnifying-glass"></i></button>
        </div>
        <a href="/admin/users/new" class="btn btn-primary btn-sm">
            <i class="fa-solid fa-user-plus me-1"></i>Utwórz konto
        </a>
    </div>
</div>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_users == null || !_users.Data.Any())
{
    <EmptyState Icon="fa-solid fa-users" Title="Brak użytkowników" />
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Użytkownik</th>
                    <th>Email</th>
                    <th>Rola</th>
                    <th>Status</th>
                    <th>Dołączył</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in _users.Data)
                {
                    <tr>
                        <td class="fw-medium">
                            <a href="/admin/users/@user.UserId" class="text-decoration-none" style="color:var(--accent-color);">@user.Username</a>
                        </td>
                        <td>@user.Email @(user.EmailVerified ? "" : "(niezweryfikowany)")</td>
                        <td><span class="badge bg-info">@user.Role</span></td>
                        <td>
                            @if (user.Status == "Banned")
                            {
                                <span class="badge bg-danger">Zbanowany</span>
                            }
                            else if (user.Status == "Active")
                            {
                                <span class="badge bg-success">Aktywny</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@user.Status</span>
                            }
                        </td>
                        <td class="text-muted small">@(user.CreatedAt?.ToString("dd.MM.yyyy") ?? "-")</td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                @if (user.Status == "Banned")
                                {
                                    <button class="btn btn-outline-success" @onclick='() => UserAction(user.PublicId, "unban")' title="Odbanuj">
                                        <i class="fa-solid fa-unlock"></i>
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-outline-danger" @onclick='() => UserAction(user.PublicId, "ban")' title="Zbanuj">
                                        <i class="fa-solid fa-ban"></i>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_users.Pagination.TotalPages > 1)
    {
        <Pagination Info="@_users.Pagination" OnPageChange="LoadPage" />
    }
}

@code {
    private PagedResult<AdminUserDto>? _users;
    private string _search = "";
    private string _roleFilter = "";
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadPage(1);

    private async Task LoadPage(int page)
    {
        _loading = true;
        _users = await AdminService.GetUsersAsync(
            page,
            string.IsNullOrWhiteSpace(_search) ? null : _search,
            string.IsNullOrWhiteSpace(_roleFilter) ? null : _roleFilter);
        _loading = false;
    }

    private async Task DoSearch() => await LoadPage(1);
    private void HandleSearchKey(KeyboardEventArgs e) { if (e.Key == "Enter") _ = DoSearch(); }

    private async Task UserAction(Guid id, string action)
    {
        var success = await AdminService.UpdateUserAsync(id, action);
        if (success) { Toast.ShowSuccess("Użytkownik zaktualizowany."); await LoadPage(1); }
        else Toast.ShowError("Operacja nieudana.");
    }
}
