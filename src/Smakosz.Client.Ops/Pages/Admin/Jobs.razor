@page "/admin/jobs"
@layout AdminLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject IAdminService AdminService
@inject ToastService Toast
@inject NavigationManager Navigation
@inject IScrollPositionService ScrollService

<PageTitle>Zadania - Admin Smakosz</PageTitle>

<Smakosz.Client.Ops.Components.NodeStatusStrip />

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="fa-solid fa-clock-rotate-left me-2"></i>Zadania w tle</h2>
    <div>
        <button class="btn btn-outline-success me-2" @onclick="ShowNcfModal">
            <i class="fa-solid fa-brain me-1"></i>NCF Training
        </button>
        <button class="btn btn-primary" @onclick="ShowCreateModal">
            <i class="fa-solid fa-plus me-1"></i>Nowe zadanie
        </button>
    </div>
</div>

<div class="d-flex flex-wrap gap-3 mb-3">
    <div>
        <div class="small text-muted mb-1">Status</div>
        <div class="btn-group btn-group-sm flex-wrap" role="group" aria-label="Filtr statusu">
            <button class="btn @(_currentStatus == null ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetStatus(null)">Wszystkie</button>
            <button class="btn @(_currentStatus == "Pending" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SetStatus("Pending")'>Pending</button>
            <button class="btn @(_currentStatus == "Processing" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SetStatus("Processing")'>Processing</button>
            <button class="btn @(_currentStatus == "Completed" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SetStatus("Completed")'>Completed</button>
            <button class="btn @(_currentStatus == "Failed" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SetStatus("Failed")'>Failed</button>
            <button class="btn @(_currentStatus == "Cancelled" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SetStatus("Cancelled")'>Cancelled</button>
        </div>
    </div>
    <div>
        <div class="small text-muted mb-1">Typ</div>
        <div class="btn-group btn-group-sm flex-wrap" role="group" aria-label="Filtr typu">
            <button class="btn @(_currentType == null ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetType(null)">Wszystkie</button>
            <button class="btn @(_currentType == "text_moderation" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SetType("text_moderation")'>text_moderation</button>
            <button class="btn @(_currentType == "image_moderation" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SetType("image_moderation")'>image_moderation</button>
            <button class="btn @(_currentType == "ncf_training" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SetType("ncf_training")'>ncf_training</button>
        </div>
    </div>
</div>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_jobs == null || !_jobs.Data.Any())
{
    <EmptyState Icon="fa-solid fa-clock-rotate-left" Title="Brak zadań" />
}
else
{
    <div id="jobs-table-anchor"></div>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Typ</th>
                    <th>Status</th>
                    <th>Priorytet</th>
                    <th style="min-width: 200px">Postęp</th>
                    <th>Worker</th>
                    <th>Utworzono</th>
                    <th>Zakończono</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var job in _jobs.Data)
                {
                    <tr>
                        <td class="fw-medium">@job.Type</td>
                        <td><StatusBadge Status="@job.Status" /></td>
                        <td>@job.Priority</td>
                        <td>
                            <div class="progress-cell">
                                <div class="progress progress-sm">
                                    <div class="progress-bar @ProgressBarClass(job)"
                                         role="progressbar"
                                         style="width: @job.Progress%"
                                         aria-valuenow="@job.Progress" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                                <div class="progress-cell-meta">
                                    <span class="progress-cell-pct">@job.Progress%</span>
                                    @if (!string.IsNullOrWhiteSpace(job.ProgressMessage))
                                    {
                                        <span class="progress-cell-msg" title="@job.ProgressMessage">@job.ProgressMessage</span>
                                    }
                                </div>
                                @if (job.Status == "Failed" && !string.IsNullOrWhiteSpace(job.ErrorMessage))
                                {
                                    <button type="button" class="btn-link-sm text-danger" @onclick="() => ShowError(job)">
                                        <i class="fa-solid fa-triangle-exclamation me-1"></i>Pokaż błąd
                                    </button>
                                }
                            </div>
                        </td>
                        <td class="text-muted small">@(job.WorkerNode ?? "-")</td>
                        <td class="text-muted small">@(job.CreatedAt?.ToString("dd.MM HH:mm") ?? "-")</td>
                        <td class="text-muted small">@(job.FinishedAt?.ToString("dd.MM HH:mm") ?? "-")</td>
                        <td>
                            <button class="btn btn-outline-primary btn-sm me-1" @onclick="() => TriggerJob(job.JobId)" title="Uruchom ponownie">
                                <i class="fa-solid fa-play"></i>
                            </button>
                            @if (job.Status is "Pending" or "Processing")
                            {
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => CancelJob(job.JobId)" title="Anuluj">
                                    <i class="fa-solid fa-xmark"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_jobs.Pagination.TotalPages > 1)
    {
        <Pagination Info="@_jobs.Pagination" OnPageChange="LoadPage" />
    }
}

@if (_showNcfModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,.5)" @onclick="CloseNcfModal">
        <div class="modal-dialog" @onclick:stopPropagation>
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fa-solid fa-brain me-2"></i>Zaplanuj NCF Training</h5>
                    <button type="button" class="btn-close" @onclick="CloseNcfModal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">Priorytet: <strong>@_ncfPriority</strong></label>
                    <input type="range" min="1" max="10" step="1" class="form-range"
                           value="@_ncfPriority"
                           @oninput="OnNcfPriorityChanged" />
                    <small class="text-muted d-block mt-2">10 = najwyższy (domyślny). 1 = najniższy.</small>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseNcfModal">Anuluj</button>
                    <button class="btn btn-success" @onclick="SubmitNcfTraining">Zaplanuj</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_errorJob is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,.5)" @onclick="CloseErrorModal">
        <div class="modal-dialog modal-lg" @onclick:stopPropagation>
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fa-solid fa-triangle-exclamation text-danger me-2"></i>
                        Błąd zadania #@_errorJob.JobId (@_errorJob.Type)
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseErrorModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Wiadomość</label>
                        <div class="text-danger">@_errorJob.ErrorMessage</div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_errorJob.ErrorLog))
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold">Stack trace</label>
                            <pre class="error-log-pre">@_errorJob.ErrorLog</pre>
                        </div>
                    }
                    <div class="text-muted small">
                        Próby: @_errorJob.Attempts / @_errorJob.MaxAttempts
                        @if (!string.IsNullOrWhiteSpace(_errorJob.WorkerNode))
                        {
                            <span class="ms-2">| Worker: @_errorJob.WorkerNode</span>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseErrorModal">Zamknij</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showCreateModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Nowe zadanie</h5>
                    <button type="button" class="btn-close" @onclick="CloseCreateModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Typ</label>
                        <select class="form-select" @bind="_createRequest.Type">
                            <option value="text_moderation">text_moderation</option>
                            <option value="image_moderation">image_moderation</option>
                            <option value="ncf_training">ncf_training</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Priorytet</label>
                        <input type="number" class="form-control" @bind="_createRequest.Priority" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Entity ID</label>
                        <input type="text" class="form-control" @bind="_createRequest.EntityId" placeholder="Opcjonalne" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Entity Type</label>
                        <input type="text" class="form-control" @bind="_createRequest.EntityType" placeholder="Opcjonalne" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Payload (JSON)</label>
                        <textarea class="form-control" rows="4" @bind="_createRequest.Payload" placeholder="Opcjonalne"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseCreateModal">Anuluj</button>
                    <button class="btn btn-primary" @onclick="SubmitCreateJob">Utwórz</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private PagedResult<AdminJobDto>? _jobs;
    private bool _loading = true;
    private bool _showCreateModal;
    private int _currentPage;
    private CreateJobRequest _createRequest = new();
    private AdminJobDto? _errorJob;
    private bool _showNcfModal;
    private int _ncfPriority = 10;

    private static string ProgressBarClass(AdminJobDto job) => job.Status switch
    {
        "Failed" => "bg-danger",
        "Completed" => "bg-success",
        "Processing" => "progress-bar-striped progress-bar-animated bg-primary",
        "Cancelled" => "bg-secondary",
        _ => "bg-secondary"
    };

    private void ShowError(AdminJobDto job) => _errorJob = job;
    private void CloseErrorModal() => _errorJob = null;

    [SupplyParameterFromQuery(Name = "page")]
    public int? PageQuery { get; set; }

    [SupplyParameterFromQuery(Name = "type")]
    public string? TypeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    public string? StatusQuery { get; set; }

    private string? _currentType;
    private string? _currentStatus;

    protected override async Task OnParametersSetAsync()
    {
        var targetPage = PageQuery ?? 1;
        if (targetPage == _currentPage
            && TypeQuery == _currentType
            && StatusQuery == _currentStatus
            && _jobs != null)
            return;
        _currentType = TypeQuery;
        _currentStatus = StatusQuery;
        await FetchPage(targetPage);
    }

    private Task LoadPage(int page) => NavigateWithFilters(page, _currentType, _currentStatus);

    private Task SetStatus(string? status) => NavigateWithFilters(1, _currentType, status);
    private Task SetType(string? type) => NavigateWithFilters(1, type, _currentStatus);

    private Task NavigateWithFilters(int page, string? type, string? status)
    {
        var url = $"/admin/jobs?page={page}";
        if (!string.IsNullOrWhiteSpace(type))
            url += $"&type={Uri.EscapeDataString(type)}";
        if (!string.IsNullOrWhiteSpace(status))
            url += $"&status={Uri.EscapeDataString(status)}";
        Navigation.NavigateTo(url);
        return Task.CompletedTask;
    }

    private async Task FetchPage(int page)
    {
        _loading = true;
        _currentPage = page;
        _jobs = await AdminService.GetJobsAsync(page, _currentType, _currentStatus);
        _loading = false;
        await ScrollService.ScrollToElementAsync("jobs-table-anchor");
    }

    private async Task TriggerJob(int id)
    {
        var success = await AdminService.TriggerJobAsync(id);
        if (success) { Toast.ShowSuccess("Zadanie uruchomione."); await NavigateWithFilters(1, _currentType, _currentStatus); }
        else Toast.ShowError("Nie udało się uruchomić zadania.");
    }

    private async Task CancelJob(int id)
    {
        var success = await AdminService.CancelJobAsync(id);
        if (success) { Toast.ShowSuccess("Zadanie anulowane."); await NavigateWithFilters(1, _currentType, _currentStatus); }
        else Toast.ShowError("Nie udało się anulować zadania.");
    }

    private void ShowNcfModal()
    {
        _ncfPriority = 10;
        _showNcfModal = true;
    }

    private void CloseNcfModal() => _showNcfModal = false;

    private void OnNcfPriorityChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value))
            _ncfPriority = value;
    }

    private async Task SubmitNcfTraining()
    {
        var (success, errorMessage) = await AdminService.ScheduleNcfTrainingAsync(_ncfPriority);
        if (success)
        {
            Toast.ShowSuccess($"NCF Training zaplanowany (priorytet {_ncfPriority}).");
            _showNcfModal = false;
            await LoadPage(1);
        }
        else
        {
            Toast.ShowError(errorMessage ?? "Nie udało się zaplanować NCF Training.");
        }
    }

    private void ShowCreateModal()
    {
        _createRequest = new CreateJobRequest { Type = "text_moderation" };
        _showCreateModal = true;
    }

    private void CloseCreateModal() => _showCreateModal = false;

    private async Task SubmitCreateJob()
    {
        var success = await AdminService.CreateJobAsync(_createRequest);
        if (success)
        {
            Toast.ShowSuccess("Zadanie utworzone.");
            _showCreateModal = false;
            await LoadPage(1);
        }
        else Toast.ShowError("Nie udało się utworzyć zadania.");
    }
}
