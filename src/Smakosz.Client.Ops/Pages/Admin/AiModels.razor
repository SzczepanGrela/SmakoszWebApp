@page "/admin/ai-models"
@layout AdminLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject IAdminService AdminService

<PageTitle>Modele AI - Admin Smakosz</PageTitle>

<h2 class="fw-bold mb-4"><i class="fa-solid fa-robot me-2"></i>Modele AI</h2>

@if (_loading)
{
    <LoadingSpinner />
}
else if (!_models.Any())
{
    <EmptyState Icon="fa-solid fa-robot" Title="Brak modeli AI" />
}
else
{
    <div class="row">
        @foreach (var model in _models)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <ModelStatusCard Model="@model" />
            </div>
        }
    </div>
}

@code {
    private List<AdminAiModelDto> _models = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _models = await AdminService.GetAiModelsAsync();
        _loading = false;
    }
}
