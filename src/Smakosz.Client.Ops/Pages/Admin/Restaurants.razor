@page "/admin/restaurants"
@layout AdminLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject IAdminService AdminService
@inject ToastService Toast

<PageTitle>Restauracje - Admin Smakosz</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="fa-solid fa-store me-2"></i>Restauracje</h2>
    <div class="input-group" style="max-width:300px;">
        <input type="text" class="form-control form-control-sm" @bind="_search" @onkeydown="HandleSearchKey" placeholder="Szukaj restauracji..." />
        <button class="btn btn-outline-primary btn-sm" @onclick="DoSearch"><i class="fa-solid fa-magnifying-glass"></i></button>
    </div>
</div>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_restaurants == null || !_restaurants.Data.Any())
{
    <EmptyState Icon="fa-solid fa-store" Title="Brak restauracji" />
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Nazwa</th>
                    <th>Status</th>
                    <th>Weryfikacja</th>
                    <th>Właściciel</th>
                    <th>Ocena</th>
                    <th>Recenzje</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _restaurants.Data)
                {
                    <tr>
                        <td>
                            <a href="/admin/restaurants/@r.RestaurantId">@r.Name</a>
                            @if (!string.IsNullOrEmpty(r.Slug))
                            {
                                <a href="/restaurants/@r.Slug" target="_blank" rel="noopener" class="ms-2 text-muted" title="Otwórz publicznie">
                                    <i class="fa-solid fa-up-right-from-square"></i>
                                </a>
                            }
                        </td>
                        <td><span class="badge bg-@GetStatusColor(r.Status)">@r.Status</span></td>
                        <td>
                            @if (r.IsVerified)
                            {
                                <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i>Zweryfikowana</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Niezweryfikowana</span>
                            }
                        </td>
                        <td>@(r.OwnerUsername ?? "-")</td>
                        <td>@r.AverageRating.ToString("F1")</td>
                        <td>@r.ReviewCount</td>
                        <td>
                            @if (!r.IsVerified)
                            {
                                <button class="btn btn-sm btn-success" disabled="@_verifying" @onclick="() => VerifyRestaurant(r)">
                                    <i class="fa-solid fa-check me-1"></i>Zweryfikuj
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_restaurants.Pagination.TotalPages > 1)
    {
        <Pagination Info="@_restaurants.Pagination" OnPageChange="LoadPage" />
    }
}

@code {
    private PagedResult<AdminRestaurantDto>? _restaurants;
    private string _search = "";
    private bool _loading = true;
    private bool _verifying;

    protected override async Task OnInitializedAsync() => await LoadPage(1);

    private async Task LoadPage(int page)
    {
        _loading = true;
        _restaurants = await AdminService.GetRestaurantsAsync(page, string.IsNullOrWhiteSpace(_search) ? null : _search);
        _loading = false;
    }

    private async Task VerifyRestaurant(AdminRestaurantDto restaurant)
    {
        _verifying = true;
        var success = await AdminService.VerifyRestaurantAsync(restaurant.PublicId);
        _verifying = false;
        if (success)
        {
            restaurant.IsVerified = true;
            restaurant.Status = "Active";
            Toast.ShowSuccess("Restauracja zweryfikowana.");
        }
        else
        {
            Toast.ShowError("Nie udało się zweryfikować restauracji.");
        }
    }

    private async Task DoSearch() => await LoadPage(1);
    private void HandleSearchKey(KeyboardEventArgs e) { if (e.Key == "Enter") _ = DoSearch(); }

    private static string GetStatusColor(string status) => status switch
    {
        "Active" => "success",
        "PendingVerification" => "warning",
        "Suspended" => "danger",
        "ClosedPermanently" => "secondary",
        _ => "info"
    };
}
