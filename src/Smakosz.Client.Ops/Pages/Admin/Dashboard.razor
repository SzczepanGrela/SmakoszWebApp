@page "/admin"
@layout AdminLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Moderator")]
@inject IAdminService AdminService

<PageTitle>Dashboard - Admin Smakosz</PageTitle>

<h2 class="fw-bold mb-4"><i class="fa-solid fa-chart-pie me-2"></i>Dashboard</h2>

@if (_loading)
{
    <LoadingSpinner Text="Ładowanie panelu..." />
}
else if (_dashboard == null)
{
    <EmptyState Icon="fa-solid fa-chart-pie" Title="Brak danych" />
}
else
{
    <!-- Global stats - admin only -->
    <AuthorizeView Roles="Admin">
        <Authorized Context="adminCtx">
            <div class="row mb-4">
                <div class="col-md-3 mb-3">
                    <AdminStatCard Icon="fa-solid fa-users" Label="Użytkownicy" Value="@_dashboard.TotalUsers.ToString()" Color="#4A90D9" />
                </div>
                <div class="col-md-3 mb-3">
                    <AdminStatCard Icon="fa-solid fa-store" Label="Restauracje" Value="@_dashboard.TotalRestaurants.ToString()" Color="#D4A574" />
                </div>
                <div class="col-md-3 mb-3">
                    <AdminStatCard Icon="fa-solid fa-comments" Label="Recenzje" Value="@_dashboard.TotalReviews.ToString()" Color="#B8860B" />
                </div>
            </div>
        </Authorized>
    </AuthorizeView>

    <!-- Moderation items - visible for both roles -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <a href="/admin/photos" class="text-decoration-none">
                <AdminStatCard Icon="fa-solid fa-images" Label="Oczekujące zdjęcia" Value="@_dashboard.PendingPhotos.ToString()" Color="#3498DB" />
            </a>
        </div>
        <div class="col-md-3 mb-3">
            <a href="/admin/reviews" class="text-decoration-none">
                <AdminStatCard Icon="fa-solid fa-comment-dots" Label="Oczekujące recenzje" Value="@_dashboard.PendingReviews.ToString()" Color="#9B59B6" />
            </a>
        </div>
        <div class="col-md-3 mb-3">
            <a href="/admin/reports" class="text-decoration-none">
                <AdminStatCard Icon="fa-solid fa-flag" Label="Oczekujące raporty" Value="@_dashboard.PendingReports.ToString()" Color="#E74C3C" />
            </a>
        </div>
        <div class="col-md-3 mb-3">
            <a href="/admin/tickets" class="text-decoration-none">
                <AdminStatCard Icon="fa-solid fa-ticket" Label="Otwarte zgłoszenia" Value="@_dashboard.OpenTickets.ToString()" Color="#F39C12" />
            </a>
        </div>
    </div>

    <AuthorizeView Roles="Admin">
        <Authorized Context="adminCtx2">
            <div class="row mb-4">
                <div class="col-md-3 mb-3">
                    <a href="/admin/edit-requests" class="text-decoration-none">
                        <AdminStatCard Icon="fa-solid fa-pen-to-square" Label="Oczekujące korekty" Value="@_dashboard.PendingCorrections.ToString()" Color="#2ECC71" />
                    </a>
                </div>
            </div>
        </Authorized>
    </AuthorizeView>
}

@code {
    private AdminDashboardDto? _dashboard;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _dashboard = await AdminService.GetDashboardAsync();
        _loading = false;
    }
}
