@page "/admin"
@layout AdminLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "admin")]
@inject IAdminService AdminService

<PageTitle>Dashboard - Admin Smakosz</PageTitle>

<h2 class="fw-bold mb-4"><i class="fa-solid fa-chart-pie me-2"></i>Dashboard</h2>

@if (_loading)
{
    <LoadingSpinner Text="Ladowanie panelu..." />
}
else if (_dashboard == null)
{
    <EmptyState Icon="fa-solid fa-chart-pie" Title="Brak danych" />
}
else
{
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <AdminStatCard Icon="fa-solid fa-users" Label="Uzytkownicy" Value="@_dashboard.TotalUsers.ToString()" Color="#4A90D9" />
        </div>
        <div class="col-md-3 mb-3">
            <AdminStatCard Icon="fa-solid fa-store" Label="Restauracje" Value="@_dashboard.TotalRestaurants.ToString()" Color="#D4A574" />
        </div>
        <div class="col-md-3 mb-3">
            <AdminStatCard Icon="fa-solid fa-comments" Label="Recenzje" Value="@_dashboard.TotalReviews.ToString()" Color="#B8860B" />
        </div>
    </div>

    <!-- Pending items -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <a href="/admin/reports" class="text-decoration-none">
                <AdminStatCard Icon="fa-solid fa-flag" Label="Oczekujace raporty" Value="@_dashboard.PendingReports.ToString()" Color="#E74C3C" />
            </a>
        </div>
        <div class="col-md-3 mb-3">
            <a href="/admin/tickets" class="text-decoration-none">
                <AdminStatCard Icon="fa-solid fa-wrench" Label="Oczekujace korekty" Value="@_dashboard.PendingCorrections.ToString()" Color="#F39C12" />
            </a>
        </div>
    </div>
}

@code {
    private AdminDashboardDto? _dashboard;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _dashboard = await AdminService.GetDashboardAsync();
        _loading = false;
    }
}
