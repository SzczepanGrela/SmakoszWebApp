@page "/admin"
@layout AdminLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Moderator")]
@inject IAdminService AdminService

<PageTitle>Dashboard - Admin Smakosz</PageTitle>

<h2 class="dashboard-title">Dashboard</h2>

@if (_loading)
{
    <LoadingSpinner Text="Ładowanie panelu..." />
}
else if (_dashboard == null)
{
    <EmptyState Icon="fa-solid fa-chart-pie" Title="Brak danych" />
}
else
{
    <AuthorizeView Roles="Admin">
        <Authorized Context="adminCtx">
            <div class="dashboard-section-label">Statystyki ogólne</div>
            <div class="dashboard-grid cols-3">
                <AdminStatCard Label="Użytkownicy" Value="@_dashboard.TotalUsers.ToString("N0")" Context="konta zarejestrowane" />
                <AdminStatCard Label="Restauracje" Value="@_dashboard.TotalRestaurants.ToString("N0")" Context="w katalogu" />
                <AdminStatCard Label="Recenzje" Value="@_dashboard.TotalReviews.ToString("N0")" Context="wszystkie zatwierdzone" />
            </div>
        </Authorized>
    </AuthorizeView>

    <div class="dashboard-section-label">Wymaga uwagi</div>
    <div class="dashboard-grid cols-5-flex">
        <a href="/admin/photos" class="dashboard-card-link">
            <AdminStatCard Label="Zdjęcia" Value="@_dashboard.PendingPhotos.ToString()" Context="do moderacji"
                           Attention="@(_dashboard.PendingPhotos > 0)" IsClickable="true" />
        </a>
        <a href="/admin/reviews" class="dashboard-card-link">
            <AdminStatCard Label="Recenzje" Value="@_dashboard.PendingReviews.ToString()" Context="do moderacji"
                           Attention="@(_dashboard.PendingReviews > 0)" IsClickable="true" />
        </a>
        <a href="/admin/reports" class="dashboard-card-link">
            <AdminStatCard Label="Raporty" Value="@_dashboard.PendingReports.ToString()" Context="do rozpatrzenia"
                           Attention="@(_dashboard.PendingReports > 0)" IsClickable="true" />
        </a>
        <a href="/admin/tickets" class="dashboard-card-link">
            <AdminStatCard Label="Zgłoszenia" Value="@_dashboard.OpenTickets.ToString()" Context="do odpowiedzi"
                           Attention="@(_dashboard.OpenTickets > 0)" IsClickable="true" />
        </a>
        <AuthorizeView Roles="Admin">
            <Authorized Context="adminCtx2">
                <a href="/admin/edit-requests" class="dashboard-card-link">
                    <AdminStatCard Label="Korekty" Value="@_dashboard.PendingCorrections.ToString()" Context="do akceptacji"
                                   Attention="@(_dashboard.PendingCorrections > 0)" IsClickable="true" />
                </a>
            </Authorized>
        </AuthorizeView>
    </div>
}

@code {
    private AdminDashboardDto? _dashboard;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _dashboard = await AdminService.GetDashboardAsync();
        _loading = false;
    }
}
