@page "/admin/reviews"
@layout AdminLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Moderator")]
@inject IAdminService AdminService
@inject ToastService Toast

<PageTitle>Moderacja recenzji - Admin Smakosz</PageTitle>

<h2 class="fw-bold mb-4"><i class="fa-solid fa-comments me-2"></i>Moderacja recenzji</h2>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_reviews == null || !_reviews.Data.Any())
{
    <EmptyState Icon="fa-solid fa-comments" Title="Brak recenzji do moderacji" Description="Wszystkie recenzje zostały sprawdzone." />
}
else
{
    @foreach (var review in _reviews.Data)
    {
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <strong>@review.AuthorUsername</strong>
                        <span class="text-muted mx-2">o</span>
                        <strong>@review.DishName</strong>
                        <small class="text-muted ms-2">(@review.RestaurantName)</small>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        @if (review.ReportCount > 0)
                        {
                            <span class="badge bg-danger"><i class="fa-solid fa-flag me-1"></i>@review.ReportCount zgł.</span>
                        }
                        <StatusBadge Status="@ContentStatusName(review.ContentStatus)" />
                    </div>
                </div>
                <p class="mb-2">@review.Content</p>
                <div class="d-flex justify-content-between align-items-center">
                    <div class="small text-muted">
                        <span>Ocena dania: @review.DishRating/10</span>
                        <span class="ms-3"><i class="fa-solid fa-calendar me-1"></i>@review.CreatedAt.ToString("dd.MM.yyyy")</span>
                    </div>
                    <ModerationActionBar Category="Text" OnModerate="args => ModerateReview(review.PublicId, args)" />
                </div>
            </div>
        </div>
    }

    @if (_reviews.Pagination.TotalPages > 1)
    {
        <Pagination Info="@_reviews.Pagination" OnPageChange="LoadPage" />
    }
}

@code {
    private PagedResult<AdminReviewDto>? _reviews;
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadPage(1);

    private async Task LoadPage(int page)
    {
        _loading = true;
        _reviews = await AdminService.GetPendingReviewsAsync(page);
        _loading = false;
    }

    private async Task ModerateReview(Guid id, ModerationActionBar.ModerationActionArgs args)
    {
        var approve = args.Action == "approve";
        var success = await AdminService.ModerateReviewAsync(id, approve, args.ReasonCodes, args.ModeratorNote);
        if (success) { Toast.ShowSuccess(approve ? "Recenzja zatwierdzona." : "Recenzja odrzucona."); await LoadPage(1); }
        else Toast.ShowError("Operacja nieudana.");
    }

    private static string ContentStatusName(int status) => status switch
    {
        0 => "none",
        1 => "pending",
        2 => "processing",
        3 => "approved",
        4 => "rejected",
        5 => "needs_review",
        _ => "unknown"
    };
}
