{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=<DB_NAME>;Username=<DB_USER>;Password=<DB_PASSWORD>;Timeout=5"
  },
  "Jwt": {
    "PrivateKeyPath": "/home/smakosz/keys/jwt_private.pem",
    "PublicKeyPath": "/home/smakosz/keys/jwt_public.pem",
    "Issuer": "Smakosz.API",
    "Audience": "Smakosz.Client"
  },
  "CodeHasher": {
    "Secret": "<MIN-32-CHAR-SECRET-KEY>"
  },
  "Cors": {
    "AllowedOrigins": [ "https://localhost:5002", "http://localhost:5003" ]
  },
  "Brevo": {
    "ApiKey": "<BREVO_API_KEY>",
    "SenderEmail": "<SENDER_EMAIL>",
    "SenderName": "<SENDER_NAME>"
  },
  "R2": {
    "AccountId": "<CLOUDFLARE_ACCOUNT_ID>",
    "AccessKey": "<R2_ACCESS_KEY_ID>",
    "SecretKey": "<R2_SECRET_ACCESS_KEY>",
    "BucketName": "<R2_BUCKET_NAME>",
    "PublicUrl": "<R2_PUBLIC_DOMAIN>"
  },
  "Vapid": {
    "PublicKey": "<VAPID_PUBLIC_KEY>",
    "PrivateKey": "<VAPID_PRIVATE_KEY>",
    "Subject": "mailto:<YOUR_EMAIL>"
  },
  "Turnstile": {
    "SiteKey": "<TURNSTILE_SITE_KEY>",
    "SecretKey": "<TURNSTILE_SECRET_KEY>"
  },
  "Onnx": {
    "ModelBasePath": "/models/ncf",
    "MinReviewsForRecommendations": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Monitoring": {
    "HealthCheckKey": "<HEALTH_CHECK_KEY>"
  },
  "AllowedHosts": "*"
}
