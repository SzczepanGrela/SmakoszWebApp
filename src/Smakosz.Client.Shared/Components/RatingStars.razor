@namespace Smakosz.Client.Components

@if (Compact)
{
    <span class="rating-stars rating-compact">
        <i class="fa-solid fa-star text-warning"></i>
        <span class="ms-1 small fw-bold">@Rating.ToString("F1")</span>
    </span>
}
else
{
    <span class="rating-stars @(Size == "lg" ? "stars-lg" : "")">
        @for (int i = 1; i <= 10; i++)
        {
            var idx = i;
            @if (idx <= (int)Rating)
            {
                <i class="fa-solid fa-star text-warning @SizeClass"></i>
            }
            else if (idx - 0.5 <= Rating)
            {
                <i class="fa-solid fa-star-half-stroke text-warning @SizeClass"></i>
            }
            else
            {
                <i class="fa-regular fa-star text-muted @SizeClass"></i>
            }
        }
        @if (ShowValue)
        {
            <span class="ms-1 small fw-bold">@Rating.ToString("F1")</span>
        }
    </span>
}

@code {
    [Parameter] public double Rating { get; set; }
    [Parameter] public string Size { get; set; } = "sm";
    [Parameter] public bool ShowValue { get; set; }
    [Parameter] public bool Compact { get; set; }

    private string SizeClass => Size switch { "lg" => "fa-lg", "sm" => "", _ => "" };
}
