@namespace Smakosz.Client.Components
@inject IIngredientService IngredientService

<div class="card shadow-sm mb-4">
    <div class="card-header"><h5 class="mb-0"><i class="fa-solid fa-carrot me-2"></i>Składniki</h5></div>
    <div class="card-body">
        @if (_allIngredients == null)
        {
            <LoadingSpinner />
        }
        else
        {
            @if (SelectedIds.Any())
            {
                <div class="d-flex flex-wrap gap-1 mb-3">
                    @foreach (var id in SelectedIds)
                    {
                        var ingredient = _allIngredients.FirstOrDefault(i => i.Id == id);
                        if (ingredient != null)
                        {
                            <span class="badge bg-primary d-flex align-items-center gap-1 px-2 py-1">
                                @if (!string.IsNullOrEmpty(ingredient.IconUrl))
                                {
                                    <img src="@ingredient.IconUrl" alt="" style="width:16px;height:16px;" />
                                }
                                @ingredient.Name
                                <button type="button" class="btn-close btn-close-white ms-1" style="font-size:0.6rem;"
                                        @onclick="() => RemoveIngredient(id)"></button>
                            </span>
                        }
                    }
                </div>
            }

            <div class="mb-2">
                <input type="text" class="form-control form-control-sm" placeholder="Szukaj skladnika..."
                       @bind="_search" @bind:event="oninput" />
            </div>

            <div style="max-height:250px;overflow-y:auto;">
                @foreach (var ingredient in FilteredIngredients)
                {
                    var isSelected = SelectedIds.Contains(ingredient.Id);
                    <div class="form-check py-1">
                        <input class="form-check-input" type="checkbox" checked="@isSelected"
                               @onchange="e => ToggleIngredient(ingredient.Id, (bool)e.Value!)" />
                        <label class="form-check-label d-flex align-items-center gap-1">
                            @if (!string.IsNullOrEmpty(ingredient.IconUrl))
                            {
                                <img src="@ingredient.IconUrl" alt="" style="width:18px;height:18px;" />
                            }
                            <span>@ingredient.Name</span>
                            @if (ingredient.IsAllergen)
                            {
                                <span class="badge bg-danger" style="font-size:0.65rem;">
                                    <i class="fa-solid fa-triangle-exclamation me-1"></i>Alergen
                                </span>
                            }
                            @if (!ingredient.IsVegetarian)
                            {
                                <span class="badge text-white" style="font-size:0.65rem;background-color:#8B4513;">
                                    <i class="fa-solid fa-drumstick-bite me-1"></i>Mieso
                                </span>
                            }
                            @if (!ingredient.IsGlutenFree)
                            {
                                <span class="badge bg-warning text-dark" style="font-size:0.65rem;">
                                    <i class="fa-solid fa-wheat-awn me-1"></i>Gluten
                                </span>
                            }
                            @if (!ingredient.IsLactoseFree)
                            {
                                <span class="badge bg-info" style="font-size:0.65rem;">
                                    <i class="fa-solid fa-droplet me-1"></i>Laktoza
                                </span>
                            }
                        </label>
                    </div>
                }
                @if (!FilteredIngredients.Any())
                {
                    <p class="text-muted small mb-0">Brak wynikow.</p>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public List<int> SelectedIds { get; set; } = [];
    [Parameter] public EventCallback<List<int>> SelectedIdsChanged { get; set; }

    private List<IngredientDto>? _allIngredients;
    private string _search = "";

    private IEnumerable<IngredientDto> FilteredIngredients =>
        _allIngredients?.Where(i =>
            string.IsNullOrWhiteSpace(_search) ||
            i.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)) ?? [];

    protected override async Task OnInitializedAsync()
    {
        _allIngredients = await IngredientService.GetAllAsync();
    }

    private async Task ToggleIngredient(int id, bool isChecked)
    {
        var updated = new List<int>(SelectedIds);
        if (isChecked && !updated.Contains(id))
            updated.Add(id);
        else if (!isChecked)
            updated.Remove(id);
        SelectedIds = updated;
        await SelectedIdsChanged.InvokeAsync(updated);
    }

    private async Task RemoveIngredient(int id)
    {
        var updated = new List<int>(SelectedIds);
        updated.Remove(id);
        SelectedIds = updated;
        await SelectedIdsChanged.InvokeAsync(updated);
    }
}
