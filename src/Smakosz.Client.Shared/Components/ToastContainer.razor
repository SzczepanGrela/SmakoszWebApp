@inject Smakosz.Client.Services.ToastService ToastService
@implements IDisposable

<div class="toast-container position-fixed top-0 end-0 p-3">
    @foreach (var toast in _toasts)
    {
        <div class="toast show animate-in bg-@toast.Type text-white">
            <div class="d-flex">
                <div class="toast-body">
                    @if (toast.Title != null)
                    {
                        <strong class="me-2">@toast.Title</strong>
                    }
                    @toast.Message
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" @onclick="() => RemoveToast(toast)"></button>
            </div>
        </div>
    }
</div>

@code {
    private readonly List<Smakosz.Client.Services.ToastMessage> _toasts = [];

    protected override void OnInitialized()
    {
        ToastService.OnShow += ShowToast;
    }

    private async void ShowToast(Smakosz.Client.Services.ToastMessage message)
    {
        _toasts.Add(message);
        await InvokeAsync(StateHasChanged);
        _ = RemoveAfterDelay(message);
    }

    private async Task RemoveAfterDelay(Smakosz.Client.Services.ToastMessage message)
    {
        await Task.Delay(4000);
        RemoveToast(message);
    }

    private void RemoveToast(Smakosz.Client.Services.ToastMessage message)
    {
        _toasts.Remove(message);
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => ToastService.OnShow -= ShowToast;
}
