@namespace Smakosz.Client.Components
@if (Info != null && Info.TotalPages > 1)
{
    <nav class="pagination-nav">
        <div class="pagination-panel">
            <button class="pagination-arrow @(Info.Page <= 1 ? "disabled" : "")"
                    @onclick="() => GoToPage(Info.Page - 1)"
                    disabled="@(Info.Page <= 1)">
                <i class="fa-solid fa-chevron-left"></i>
                <span class="pagination-label">Poprzednia</span>
            </button>
            <span class="pagination-status">
                Strona <strong>@Info.Page</strong> z @Info.TotalPages
            </span>
            <button class="pagination-arrow @(Info.Page >= Info.TotalPages ? "disabled" : "")"
                    @onclick="() => GoToPage(Info.Page + 1)"
                    disabled="@(Info.Page >= Info.TotalPages)">
                <span class="pagination-label">Następna</span>
                <i class="fa-solid fa-chevron-right"></i>
            </button>
        </div>
    </nav>
}

@code {
    [Parameter] public Smakosz.Client.Models.PaginationInfo? Info { get; set; }
    [Parameter] public EventCallback<int> OnPageChange { get; set; }

    private async Task GoToPage(int page)
    {
        if (page >= 1 && page <= Info!.TotalPages && page != Info.Page)
            await OnPageChange.InvokeAsync(page);
    }
}
