@namespace Smakosz.Client.Components
@using Smakosz.Client.Helpers

<a href="/restaurants/@Restaurant.Slug" class="text-decoration-none">
    <div class="dish-card">
        <BlurHashImage Src="@ImageHelper.GetRestaurantImage(Restaurant.ImageUrl)" Alt="@Restaurant.RestaurantName"
                       BlurHash="@Restaurant.ImageBlurhash" />
        <div class="card-body p-3">
            <h6 class="fw-bold mb-1" style="color:var(--text-color);">@Restaurant.RestaurantName</h6>
            <div class="d-flex gap-2 mb-2">
                @if (Restaurant.CuisineType != null)
                {
                    <small class="text-muted"><i class="fa-solid fa-utensils me-1"></i>@Restaurant.CuisineType</small>
                }
                @if (Restaurant.CityName != null)
                {
                    <small class="text-muted"><i class="fa-solid fa-location-dot me-1"></i>@Restaurant.CityName</small>
                }
            </div>
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    @if (Restaurant.AvgFoodScore.HasValue)
                    {
                        <span class="fw-bold" style="color:var(--accent-color);">
                            <i class="fa-solid fa-star text-warning me-1"></i>@Restaurant.AvgFoodScore.Value.ToString("F1")<span class="text-muted small ms-1">/ 10</span>
                        </span>
                        <small class="text-muted ms-1">(@Restaurant.ReviewCount)</small>
                    }
                </div>
                @if (Restaurant.PriceLevel.HasValue)
                {
                    <span style="color:var(--accent-color);">@(new string('$', Restaurant.PriceLevel.Value))</span>
                }
            </div>
        </div>
    </div>
</a>

@code {
    [Parameter, EditorRequired] public Smakosz.Client.Models.RestaurantCardDto Restaurant { get; set; } = default!;
}
