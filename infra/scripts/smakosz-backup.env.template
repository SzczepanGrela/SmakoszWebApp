POSTGRES_CONTAINER=smakosz-postgres-1
POSTGRES_USER=postgres
POSTGRES_DB=smakosz_db
POSTGRES_PASSWORD=<POSTGRES_PASSWORD_FROM_DOCKER_COMPOSE_ENV>

BACKUP_DIR=/var/backups/smakosz

R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY=<ACCESS_KEY_ID>
R2_SECRET_KEY=<SECRET_ACCESS_KEY>
R2_BUCKET=smakosz-backups

HEALTHCHECKS_URL=https://hc-ping.com/<UUID>
